# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/__REPO_SLUG__
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
