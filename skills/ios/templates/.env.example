# Copy to .env for local development. Never commit .env.
# `make env` (run by make generate) turns these lines into
# Config/Local.xcconfig, which Config/Debug.xcconfig includes and which
# feeds Info.plist. The app reads API_BASE_URL from Info.plist at launch.
API_BASE_URL=http://localhost:8080
# Your Apple developer team for local device builds (Xcode > Settings > Accounts).
DEVELOPMENT_TEAM=
