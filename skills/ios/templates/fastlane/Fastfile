# __REPO_NAME__ fastlane. Commands only; the engineer (or the manual CI job)
# runs them. Nothing here reads a secret from the repo: the App Store Connect
# API key and the match password come from the environment.
#
#   fastlane beta     build, sign and upload to TestFlight
#   fastlane test     run the simulator tests with a result bundle
#
# Environment (masked CI variables, or a local .env.fastlane you never commit):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (the .p8, base64)
#   MATCH_GIT_URL, MATCH_PASSWORD           (only when using match)
#   APPLE_TEAM_ID                           (Appfile)

default_platform(:ios)

APP_NAME = "__REPO_NAME__"
PROJECT = "#{APP_NAME}.xcodeproj"
SCHEME = APP_NAME

platform :ios do
  before_all do
    setup_ci if is_ci # temporary keychain on the runner, cleaned up after
    Dir.chdir("..") { sh("xcodegen", "generate", "--spec", "project.yml") } unless File.exist?("../#{PROJECT}")
  end

  desc "Build, sign and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    if ENV["MATCH_GIT_URL"]
      match(type: "appstore", readonly: is_ci, api_key: api_key)
    end

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV.fetch("CI_PIPELINE_IID", Time.now.utc.strftime("%Y%m%d%H%M"))
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build",
      output_name: "#{APP_NAME}.ipa",
      include_symbols: true,
      xcargs: "-skipPackagePluginValidation"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CI_COMMIT_MESSAGE", "Build #{ENV['CI_PIPELINE_IID']}")
    )
  end

  desc "Run the simulator tests with a result bundle in build/"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      # SIMULATOR pins a device; unset, the first available iPhone is used
      # (the same rule as make test-ui).
      devices: [ENV.fetch("SIMULATOR") { `xcrun simctl list devices available`[/iPhone \d+( Pro)?/] || "iPhone 17" }],
      result_bundle: true,
      output_directory: "../build",
      derived_data_path: "../build/DerivedData"
    )
  end
end
