# Copy to .env for local development. Never commit .env. No secrets live here:
# tokens come from the API at runtime and are stored in Keystore-backed storage.
# make dev exports these; app/build.gradle.kts reads API_BASE_URL into
# BuildConfig.API_BASE_URL (a Gradle property -PAPI_BASE_URL=... also works).
API_BASE_URL=https://api.example.com/
