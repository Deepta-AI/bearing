# Copy to .env for local development. Never commit .env.
# dbt reads these through env_var() in profiles.yml.
DBT_TARGET=dev
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=postgres
DBT_PASSWORD=postgres
DBT_DBNAME=__REPO_SLUG__
DBT_SCHEMA=analytics
# Where the DAGs find the dbt project and profile (the runner image uses /app).
DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=.
