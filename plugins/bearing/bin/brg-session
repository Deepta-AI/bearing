#!/usr/bin/env bash
# brg-session: session memory for Bearing, all local and model-free.
#   timeline-start --id <sid> --skill <name>   record a skill start (ends the open one)
#   timeline-close --id <sid>                   end the open skill of this session
#   timeline-recent [--branch <b>] [--n <k>]    last k ended skills on the branch
#   not-run --skill <reason>                    log `timeline not-run <reason>` to gates.log
#   checkpoint                                  write .bearing/state/<branch>.checkpoint.md
#   next-step                                   the next flow step after the timeline
#   resume [--source startup|resume|compact]    the block SessionStart prints
# Runs on bash 3.2; needs git; uses jq when present. Exit 0 always.
set -u
sub="${1:-}"; shift || true
id=""; skill=""; branch=""; n=3; source=""; nextarg=""; has_next=0
while [ $# -gt 0 ]; do
  case "$1" in
    --id) id="${2:-}"; shift 2 || shift;;
    --skill) skill="${2:-}"; shift 2 || shift;;
    --branch) branch="${2:-}"; shift 2 || shift;;
    --n) n="${2:-3}"; shift 2 || shift;;
    --source) source="${2:-}"; shift 2 || shift;;
    --next) nextarg="${2:-}"; has_next=1; shift 2 || shift;;
    *) shift;;
  esac
done
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -d "$root/.bearing" ] || exit 0
case "$sub" in timeline-start|timeline-close|timeline-recent|not-run|checkpoint|next-step|resume) ;; *) exit 0;; esac
st="$root/.bearing/state"; mkdir -p "$st"; tl="$st/timeline.jsonl"
[ -n "$branch" ] || branch="$(git -C "$root" branch --show-current 2>/dev/null)"; branch="${branch:-detached}"
esc() { # JSON string body: escape \ and ", encode \n \r \t, drop other control characters
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}
skill_of() { # skill field of each JSON line on stdin
  if command -v jq >/dev/null 2>&1; then jq -r '.skill' 2>/dev/null
  else sed 's/.*"skill":"\([^"]*\)".*/\1/'; fi
}
event() { # <skill> <start|end>
  [ -f "$tl" ] && [ "$(wc -c < "$tl" | tr -d ' ')" -gt 524288 ] && mv -f "$tl" "$tl.1"
  printf '{"ts":"%s","epoch":%s,"session":"%s","branch":"%s","skill":"%s","event":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date +%s)" "$(esc "$id")" "$(esc "$branch")" "$(esc "$1")" "$2" >> "$tl"
}
open_skill() { # the skill this session started and has not ended
  [ -f "$tl" ] || return 0
  grep -F "\"session\":\"$(esc "$id")\"" "$tl" | tail -1 | grep -F '"event":"start"' | skill_of
}
case "$sub" in
  timeline-start)
    [ -n "$skill" ] || exit 0
    # One read of this session's events: the open skill, and the last start for rerun detection.
    sess=""; [ ! -f "$tl" ] || sess="$(grep -F "\"session\":\"$(esc "$id")\"" "$tl")"
    prev="$(printf '%s\n' "$sess" | tail -1 | grep -F '"event":"start"' | skill_of)"; [ -z "$prev" ] || event "$prev" end
    # The same skill starting again in this session within ten minutes is a rerun.
    last="$(printf '%s\n' "$sess" | grep -F '"event":"start"' | tail -1)"
    if [ -n "$last" ] && [ "$(printf '%s\n' "$last" | skill_of)" = "$skill" ]; then
      le="$(printf '%s' "$last" | sed -n 's/.*"epoch":\([0-9]*\).*/\1/p')"
      if [ -n "$le" ] && [ $(( $(date +%s) - le )) -le 600 ]; then
        bash "$(dirname "$0")/brg-learn" log --kind rerun --skill "$skill" --key rerun --insight "$skill rerun within ten minutes in one session" >/dev/null 2>&1
      fi
    fi
    event "$skill" start;;
  timeline-close)
    prev="$(open_skill)"; [ -z "$prev" ] || event "$prev" end;;
  timeline-recent)
    [ -f "$tl" ] || [ -f "$tl.1" ] || exit 0
    cat "$tl.1" "$tl" 2>/dev/null | grep -F "\"branch\":\"$(esc "$branch")\"" | grep -F '"event":"end"' |
      skill_of | tail -n "$n";;
  not-run) # not-run --skill <reason>: same line format as brg-guard gate_log
    printf '%s\ttimeline\tnot-run\t0\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$(printf '%s' "$skill" | tr '\t\n' '  ' | cut -c1-120)" >> "$st/gates.log";;
  checkpoint)
    t0="$(date +%s)"
    task=""; re='[A-Z][A-Z0-9]*(-[0-9]+)+'
    [[ "$branch" =~ $re ]] && task="${BASH_REMATCH[0]}"
    base=none; bsha=none
    for cand in origin/HEAD main; do
      if git -C "$root" rev-parse -q --verify "$cand" >/dev/null 2>&1; then
        base="$cand"; bsha="$(git -C "$root" rev-parse --short "$cand" 2>/dev/null || echo none)"; break
      fi
    done
    ab=""
    [ "$base" = none ] || ab="$(git -C "$root" rev-list --left-right --count "$base...HEAD" 2>/dev/null | awk '{print $2"/"$1}')"
    unc="$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    recent="$(bash "$0" timeline-recent --branch "$branch" --n 3 2>/dev/null | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
    if [ "$has_next" = 1 ]; then nxt="$nextarg"; else nxt="$(bash "$0" next-step --branch "$branch" 2>/dev/null)"; fi
    bf="$(printf '%s' "$branch" | tr '/' '_')"
    sf="$st/$bf.md"; sn=""
    [ -f "$sf" ] && sn="$(grep -m1 '^Next:' "$sf" | sed 's/^Next: *//')"
    out="$st/$bf.checkpoint.md"
    {
      echo "# Checkpoint $(date -u '+%Y-%m-%d %H:%M') UTC"
      echo "Task: ${task:-none}"
      echo "Branch: $branch"
      echo "Base: $base $bsha"
      echo "Ahead/behind: ${ab:-0/0}"
      echo "Uncommitted: $unc file(s)"
      echo "Recent skills: ${recent:-none}"
      echo "Next flow step: ${nxt:-unknown}"
      echo "Next (from state file): ${sn:-none}"
    } > "$out.tmp" && mv "$out.tmp" "$out"
    printf '%s\tcheckpoint\twritten\t%s\t\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$(( ($(date +%s) - t0) * 1000 ))" >> "$st/gates.log";;
  next-step)
    steps="$(dirname "$0")/flow-steps.tsv"; [ -f "$steps" ] || exit 0
    case "$branch" in bugfix/*|fix/*|hotfix/*) flow=bugfix;; *) flow=feature;; esac
    done_list="$(bash "$0" timeline-recent --branch "$branch" --n 200 | sed 's/.*://; s|^/||')"
    [ "$flow" = feature ] && printf '%s\n' "$done_list" | grep -qx 'genai-design' && flow=genai
    printf '%s\n' "$done_list" | awk -F'\t' -v f="$flow" '
      FNR==NR { if ($1==f) { name[$2]=$3; ord[$3]=$2; if ($2+0>max) max=$2+0 } next }
      ($0 in ord) && ord[$0]+0>best { best=ord[$0]+0 }
      END { if (best+1 in name) print name[best+1] }' "$steps" -;;
  resume)
    bf="$(printf '%s' "$branch" | tr '/' '_')"
    last="$(bash "$0" timeline-recent --branch "$branch" --n 1)"
    case "$branch" in main|master|develop|release/*|detached)
      [ -n "$last" ] || [ -f "$st/$bf.md" ] || exit 0;;
    esac
    nxt="$(bash "$0" next-step --branch "$branch")"
    bash "$0" checkpoint --branch "$branch" --next "$nxt" >/dev/null 2>&1
    cpf="$st/$bf.checkpoint.md"
    [ -f "$cpf" ] && sed -n '2,12p' "$cpf"
    task=""; re='[A-Z][A-Z0-9]*(-[0-9]+)+'
    [[ "$branch" =~ $re ]] && task="${BASH_REMATCH[0]}"
    # A person-written Next: in the state file wins over the computed step,
    # as session-end.sh does; "none" or an empty value falls back.
    sn=""; [ -f "$st/$bf.md" ] && sn="$(grep -m1 '^Next:' "$st/$bf.md" | sed 's/^Next: *//; s/[. ]*$//')"
    case "$sn" in ''|none) ;; *) nxt="$sn";; esac
    ask=" Ask the user with AskUserQuestion whether to continue with it."
    # A non-interactive session (brg-autopilot's child, or the documented
    # switch) has nobody to ask.
    if [ -n "${BEARING_AUTOPILOT:-}" ] && [ "${BEARING_AUTOPILOT}" != 0 ] || [ "${BEARING_NONINTERACTIVE:-}" = 1 ]; then ask=""; fi
    echo "Resume ${task:-this branch}: last ran ${last:-nothing yet}. Next: ${nxt:-see the workflow skill}.${ask}";;
esac
exit 0
