#!/usr/bin/env bash
# brg-doctor: verify the Bearing installation on this machine and, when run
# inside a repository, in that repository. Prints one line per check and a
# summary; exits 1 when any required check is missing. Accepts either git
# host: CI is .gitlab-ci.yml or .github/workflows/*.yml or *.yaml and must run
# make check; the change template is .gitlab/merge_request_templates/*.md or
# pull_request_template.md in any case (GitHub's rule). The third-party packs (Superpowers, gstack)
# are required only when BEARING_PROFILE (environment, then bearing.env) is
# standard or full; unset or minimal makes them optional, so a
# `install.sh --profile minimal` machine can pass. core.hooksPath passes as
# .githooks, or as another directory whose three hooks each call .githooks/
# with their arguments and keep its exit status. A hook counts only when git
# would run it: present, executable, and committed as 100755; make setup
# counts only when every script its dry run calls exists.
set -u
KIT="$(cd "$(dirname "$0")/.." && pwd)"
KIT_VERSION="$(bash "$KIT/bin/brg-kit-paths" --version 2>/dev/null)"; KIT_VERSION="${KIT_VERSION:-?}"
ok=0; miss=0; opt=0
pass() { printf 'ok        %s\n' "$*"; ok=$((ok+1)); }
fail() { printf 'MISSING   %s\n' "$*"; miss=$((miss+1)); }
optional() { printf 'optional  %s\n' "$*"; opt=$((opt+1)); }
skipped() { printf 'skipped   %s\n' "$*"; }
ver_of() { # tool -> its version string on one line, or empty
  case "$1" in
    git) git --version 2>/dev/null | awk '{print $3}';;
    make) make --version 2>/dev/null | head -1 | awk '{print $NF}';;
    jq) jq --version 2>/dev/null | sed 's/^jq-//';;
    python3) python3 --version 2>/dev/null | awk '{print $2}';;
  esac
}

envf="${XDG_CONFIG_HOME:-$HOME/.config}/bearing/bearing.env"
# env_key KEY: the last KEY=value in the env file, unquoted, comment dropped.
env_key() { [ -f "$envf" ] || return 0; grep -E "^[[:space:]]*$1[[:space:]]*=" "$envf" | tail -1 | cut -d= -f2- | tr -d '"'"'\r" | awk '{print $1}'; }
if [ -n "${BEARING_PROFILE+x}" ]; then profile="$BEARING_PROFILE"; profile_src="environment"
else profile="$(env_key BEARING_PROFILE)"; profile_src="bearing.env"; [ -n "$profile" ] || profile_src="BEARING_PROFILE not set"; fi
# pack_check <found 0|1> <ok text> <missing text>: required on standard/full.
pack_check() {
  if [ "$1" -eq 1 ]; then pass "$2"
  else case "$profile" in standard|full) fail "$3";; *) optional "$3; optional for profile ${profile:-unset}";; esac; fi
}

echo "brg-doctor (kit $KIT_VERSION)"
echo "## machine"
echo "profile: ${profile:-unset} ($profile_src; standard or full makes superpowers and gstack required)"
command -v claude >/dev/null && pass "claude $(claude --version 2>/dev/null | head -1)" || fail "claude CLI not on PATH"
plugins="$(claude plugin list 2>/dev/null || true)"
# bearing is required; bearing-backend and bearing-apps carry the stack
# conventions and templates and are optional.
printf '%s' "$plugins" | grep -Eq '(^|[^a-z-])bearing@' && pass "plugin Bearing installed" || fail "plugin Bearing not installed (claude plugin install bearing@bearing, or bash install.sh from the Bearing checkout)"
for sp_name in bearing-backend bearing-apps; do
  if printf '%s' "$plugins" | grep -q "$sp_name@"; then pass "plugin $sp_name installed"
  else optional "plugin $sp_name not installed; its stack skills and templates are unavailable (claude plugin install $sp_name@bearing)"; fi
done
sp=0; printf '%s' "$plugins" | grep -q 'superpowers' && sp=1
pack_check "$sp" "plugin superpowers installed" "superpowers not installed (claude plugin install superpowers@claude-plugins-official)"
gs=0; gsv=""; [ -f "$HOME/.claude/skills/gstack/VERSION" ] && { gs=1; gsv="$(cat "$HOME/.claude/skills/gstack/VERSION")"; }
pack_check "$gs" "gstack $gsv" "gstack not installed (see docs/INSTALL.md)"
if ls "$HOME/.claude/skills" 2>/dev/null | grep -qi '^gsd' || printf '%s' "$plugins" | grep -qi 'gsd'; then pass "GSD Core installed"; else optional "GSD Core not installed (npx @opengsd/gsd-core@$(awk -F'|' '$1=="npm" && $2=="@opengsd/gsd-core" {print $3; exit}' "$KIT/bin/pinned-packs.txt" 2>/dev/null) --global --claude)"; fi
if [ -f "$envf" ]; then
  tr_val="$(grep -E '^BEARING_TRACKER=' "$envf" | tail -1 | cut -d= -f2 | tr -d '"' | awk '{print $1}')"
  pass "bearing.env present (BEARING_TRACKER=${tr_val:-unset}; none is valid)"
  perms="$(stat -c '%a' "$envf" 2>/dev/null || stat -f '%Lp' "$envf" 2>/dev/null)"; [ "$perms" = "600" ] || optional "bearing.env mode is $perms; chmod 600 recommended"
else optional "bearing.env missing (cp $KIT/templates/user/bearing.env ~/.config/bearing/bearing.env)"; fi
[ -f "$HOME/.claude/CLAUDE.md" ] && pass "~/.claude/CLAUDE.md present" || fail "~/.claude/CLAUDE.md missing (cp $KIT/templates/user/CLAUDE.md ~/.claude/CLAUDE.md, then edit)"
for t in git make jq python3; do
  if command -v "$t" >/dev/null; then v="$(ver_of "$t")"; pass "$t ${v:-on PATH}"; else fail "$t not on PATH"; fi
done
bmaj="${BASH_VERSINFO[0]:-0}"; bmin="${BASH_VERSINFO[1]:-0}"
if [ "$bmaj" -lt 3 ] || { [ "$bmaj" -eq 3 ] && [ "$bmin" -lt 2 ]; }; then optional "bash $BASH_VERSION is below 3.2; the kit's scripts are untested there"
elif [ "$bmaj" -lt 4 ]; then pass "bash $BASH_VERSION (below 4; the kit still works, it uses no bash 4 features)"
else pass "bash $BASH_VERSION"; fi

# The repo settings template turns on the Bash sandbox with failIfUnavailable,
# so without its prerequisites every Bash call in a scaffolded repository
# fails. Linux needs bubblewrap and socat; macOS ships sandbox-exec.
case "$(uname -s)" in
  Linux)
    for t in bwrap socat; do
      if command -v "$t" >/dev/null; then pass "$t on PATH (Bash sandbox)"
      else fail "$t not on PATH; the Bash sandbox cannot start (sudo apt install bubblewrap socat, or dnf install bubblewrap socat)"; fi
    done;;
  Darwin) command -v sandbox-exec >/dev/null && pass "sandbox-exec present (Bash sandbox)" || fail "sandbox-exec not found; the Bash sandbox cannot start";;
  *) optional "Bash sandbox prerequisites unknown on $(uname -s)";;
esac

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# The Bearing checkout itself (the plugin sits under plugins/bearing) is not a
# repository on the standard.
in_kit=0; case "$KIT/" in "$root"/*) in_kit=1;; esac
if [ -n "$root" ] && [ "$in_kit" -eq 0 ]; then
  echo "## repository $(basename "$root")"
  [ -f "$root/AGENTS.md" ] && pass "AGENTS.md present" || fail "AGENTS.md missing (onboard-repo)"
  if [ -f "$root/CLAUDE.md" ]; then
    head -1 "$root/CLAUDE.md" | grep -q '^@AGENTS.md' && pass "CLAUDE.md imports AGENTS.md" || fail "CLAUDE.md first line is not @AGENTS.md"
    grep -q '__[A-Z_]*__' "$root/CLAUDE.md" && fail "CLAUDE.md snapshot has unfilled placeholders" || pass "CLAUDE.md snapshot filled"
  else fail "CLAUDE.md missing (onboard-repo)"; fi
  [ -f "$root/.claude/settings.json" ] && pass ".claude/settings.json present" || fail ".claude/settings.json missing (onboard-repo)"
  n="$(ls "$root/.claude/rules" 2>/dev/null | grep -c '\.md$' || true)"; [ "${n:-0}" -gt 0 ] && pass ".claude/rules: $n rule files" || fail ".claude/rules empty (onboard-repo --stack <id>)"
  # A .gitignore that swallows .claude/rules (".claude/*" to hide local
  # settings) means rule files written by the fix never reach other clones.
  if git -C "$root" check-ignore -q .claude/rules/probe.md 2>/dev/null; then
    fail ".gitignore ignores .claude/rules/ ($(git -C "$root" check-ignore -v .claude/rules/probe.md 2>/dev/null | cut -f1)), so rule files are never committed (add !.claude/rules/ after that line)"
  fi
  # Hooks: git runs a hook only from the effective hooks directory, under its
  # exact name, and only when it is executable; a non-executable hook is
  # skipped with a hint nobody reads. A local chmod does not travel: the mode
  # other clones get is the one in the index (100755).
  hp="$(git -C "$root" config core.hooksPath 2>/dev/null || true)"; hp="${hp%/}"
  case "$hp" in
    .githooks|./.githooks|"$root/.githooks") pass "core.hooksPath=.githooks";;
    '') fail "core.hooksPath not set (bash .githooks/install.sh)";;
    *) case "$hp" in /*) hd="$hp";; *) hd="$root/$hp";; esac
       # Husky 9 sets core.hooksPath to .husky/_, whose generated wrappers run
       # the hooks the team edits in .husky/; judge those.
       ud="$hd"; [ "$(basename "$hd")" = "_" ] && ud="$(dirname "$hd")"
       chained=0; notes=""
       for hk in commit-msg pre-commit pre-push; do
         hf="$ud/$hk"
         line="$(grep -E "\.githooks/$hk([^A-Za-z0-9_-]|$)" "$hf" 2>/dev/null | grep -vE '^[[:space:]]*#' | head -1)"
         if [ -z "$line" ]; then notes="$notes; $hk does not call .githooks/$hk"; continue; fi
         if printf '%s' "$line" | grep -Eq '\|\|[[:space:]]*(true|:)([[:space:];]|$)|;[[:space:]]*(true|:)[[:space:]]*$|&[[:space:]]*$'; then
           notes="$notes; $hk calls it but discards its exit status"; continue; fi
         if ! printf '%s' "$line" | grep -Eq '\$(\{)?(@|1|\*)'; then
           notes="$notes; $hk calls it without passing its arguments (\"\$@\")"; continue; fi
         if [ "$ud" = "$hd" ] && [ ! -x "$hf" ]; then notes="$notes; $hk is not executable"; continue; fi
         chained=$((chained+1))
       done
       [ "$chained" -eq 3 ] && pass "core.hooksPath=$hp, its 3 hooks chain .githooks/" \
         || fail "core.hooksPath=$hp and $chained of 3 of its hooks call .githooks/<hook>${notes} (in each, \".githooks/<hook> \"\$@\" || exit \$?\"; setting core.hooksPath .githooks by hand drops that tool's own hooks, and a package prepare script may set it back)";;
  esac
  hbad=""
  for hk in commit-msg pre-commit pre-push; do
    f="$root/.githooks/$hk"
    if [ ! -f "$f" ]; then hbad="$hbad; $hk absent"; continue; fi
    mode="$(git -C "$root" ls-files -s -- ".githooks/$hk" 2>/dev/null | awk '{print $1; exit}')"
    if [ -n "$mode" ] && [ "$mode" != 100755 ]; then hbad="$hbad; $hk committed as $mode (git update-index --chmod=+x .githooks/$hk, then commit)"
    elif [ ! -x "$f" ]; then hbad="$hbad; $hk not executable in this clone (chmod +x .githooks/$hk)"; fi
  done
  [ -z "$hbad" ] && pass "3 git hooks present and executable" || fail "git hooks will not all run${hbad}; git skips a hook that is absent or not executable"
  mk=""; [ -f "$root/Makefile" ] && mk="$root/Makefile"; [ -n "$mk" ] || { [ -f "$root/makefile" ] && mk="$root/makefile"; }
  if [ -n "$mk" ]; then
    grep -qE '^check:' "$mk" && pass "make check target" || fail "Makefile has no check target"
    # make setup: a dry run names every script it calls; each must exist, and
    # a '-' recipe line hides a failure behind a zero exit.
    if grep -qE '^setup:' "$mk"; then
      dry="$(cd "$root" && make --no-print-directory -n setup 2>&1 || true)"
      gone=""
      for w in $(printf '%s\n' "$dry" | grep -oE '[A-Za-z0-9_./-]+\.(sh|bash|py)' | sort -u); do
        case "$w" in /*) [ -f "$w" ] || gone="$gone $w";; *) [ -f "$root/$w" ] || gone="$gone $w";; esac
      done
      ign="$(awk '/^setup:/{s=1;next} s && /^\t/{ if ($0 ~ /^\t[@+]*-/) n++; next } s{exit} END{print n+0}' "$mk")"
      if [ -n "$gone" ]; then fail "make setup calls$gone, which does not exist${ign:+ (and $ign recipe line(s) ignore errors)}"
      elif [ "${ign:-0}" -gt 0 ]; then fail "make setup has $ign recipe line(s) starting with '-', so a failed step still exits 0"
      else pass "make setup: every script it calls exists (dry run)"; fi
    fi
  else fail "no Makefile"; fi
  # CI and change template: either host counts, and CI must run the gate.
  ci=""; cifiles=""
  [ ! -f "$root/.gitlab-ci.yml" ] || { ci=".gitlab-ci.yml"; cifiles="$root/.gitlab-ci.yml"; }
  for wf in "$root/.github/workflows"/*.yml "$root/.github/workflows"/*.yaml; do
    [ -f "$wf" ] || continue
    case "$ci" in *.github/workflows/*) ;; *) ci="${ci:+$ci, }.github/workflows/$(basename "$wf")";; esac
    cifiles="$cifiles $wf"
  done
  if [ -n "$ci" ]; then
    pass "CI present ($ci)"
    # The gate is enforced only if CI runs it. A CI that runs other make
    # targets (a matrix of the gates) may cover it; one that runs no make at
    # all does not.
    # shellcheck disable=SC2086
    cimk="$(grep -hvE '^[[:space:]]*#' $cifiles 2>/dev/null | grep -oE '(make|\$\(MAKE\))([[:space:]]+-[^[:space:]]+)*[[:space:]]+[A-Za-z0-9_$.{}-]+' | awk '{print $NF}' | sort -u | tr '\n' ' ')"
    case " $cimk " in
      *" check "*) pass "CI runs make check";;
      "  ") fail "CI never runs make, so make check is not enforced in CI ($ci); make the CI step run make check";;
      *) optional "CI runs make ${cimk% } but not make check itself; confirm those cover every target check runs";;
    esac
  else fail "CI missing: no .gitlab-ci.yml and no .github/workflows/*.yml or *.yaml (ci-pipeline)"; fi
  tpl=""
  for f in "$root"/.gitlab/merge_request_templates/*.md; do [ -f "$f" ] && tpl="${tpl:+$tpl, }${f#"$root"/}"; done
  # GitHub reads pull_request_template.md in any case from .github/, docs/ or
  # the root, or a PULL_REQUEST_TEMPLATE/ directory of them.
  for d in .github docs .; do
    [ -d "$root/$d" ] || continue
    for n in $(ls -a "$root/$d" 2>/dev/null | grep -ix 'pull_request_template\(\.md\)\?'); do
      p="$root/$d/$n"; r="${p#"$root"/}"; r="${r#./}"
      if [ -f "$p" ]; then tpl="${tpl:+$tpl, }$r"
      elif ls "$p"/*.md >/dev/null 2>&1; then tpl="${tpl:+$tpl, }$r/"; fi
    done
  done
  [ -n "$tpl" ] && pass "change template present ($tpl)" || fail "MR/PR template missing: no .gitlab/merge_request_templates/*.md and no pull_request_template.md (any case) in .github/, docs/ or the root (onboard-repo)"
  grep -q '\.bearing/state' "$root/.gitignore" 2>/dev/null && pass ".gitignore ignores .bearing/state" || fail ".gitignore lacks .bearing/state (onboard-repo)"
  # Vendored guard: its version stamp must match the installed kit.
  vg="$root/.bearing/bin/brg-guard"
  if [ -f "$vg" ]; then
    gv="$(grep -E '^BEARING_GUARD_VERSION=' "$vg" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'"'" | awk '{print $1}')"
    if [ -n "$gv" ] && [ "$gv" = "$KIT_VERSION" ]; then pass ".bearing/bin/brg-guard version $gv matches the kit"
    else fail ".bearing/bin/brg-guard version ${gv:-unreadable} differs from kit $KIT_VERSION; run harness-setup again to refresh .bearing/bin/brg-guard"; fi
  else skipped "no vendored .bearing/bin/brg-guard (harness-setup installs it per harness)"; fi
fi
total=$((ok+miss))
echo "brg-doctor: $total checks, $miss missing, $opt optional"
[ "$miss" -eq 0 ]
