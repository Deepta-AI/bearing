#!/usr/bin/env bash
BEARING_GUARD_VERSION="__VERSION__"
# Hooks run outside the sandbox with the harness's environment, so the first
# thing done is to drop what in it could run another program: PATH becomes
# /usr/bin:/bin plus the system tool directories (jq, git and python3 on
# macOS live under /usr/local/bin or /opt/homebrew/bin; on Linux under
# Linuxbrew or a Nix profile), never a directory the environment put first
# (this line matches hooks/scripts/lib.sh, where brg-doctor reads it and
# the tools the hooks need, and the settings template denies Edit and Write
# on the user-owned ones); BASH_ENV and ENV (sourced by every bash started
# later), CDPATH (redirects cd), PYTHON* (python3 also runs -I everywhere),
# LD_* and DYLD_* (preloaded libraries) are unset. BASH_ENV in the harness's
# own environment is sourced by bash before this line runs, which no script
# can prevent; the settings template denies Edit and Write on the settings
# files whose env could set it.
PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin; export PATH
unset BASH_ENV ENV CDPATH
for _brg_v in $(compgen -e 2>/dev/null); do
  case "$_brg_v" in (PYTHON*|LD_*|DYLD_*) unset "$_brg_v" 2>/dev/null ;; esac
done
unset _brg_v
# brg-guard: the harness-neutral guard logic behind every hook adapter.
#
#   brg-guard command "<shell command>"   exit 2 and a message when the command
#                                         publishes, rewrites history, deploys
#                                         or destroys; exit 2 when the command
#                                         cannot be read (fail closed)
#   brg-guard format <file>               format one file with an allow-listed
#                                         formatter from fixed directories, in
#                                         a cleared environment
#   brg-guard task-id ["<prompt>"]        print "Task: <ID> ..." when the branch
#                                         carries a ticket id the prompt lacks
#   brg-guard session                     print branch, task, changes, handoff state
#   brg-guard stop                        print a reminder when changes are unchecked
#   brg-guard stop-gate --id <session> [--active]
#                                         exit 2 (reason on stderr) when files
#                                         changed in this session since make
#                                         check last passed; --active (the
#                                         harness already continued once) only
#                                         reminds, so it never loops
#   brg-guard check-file <file>           print that no hook runs the per-file
#                                         check (make check-file runs in the
#                                         session); exit 0
#   brg-guard precompact [<transcript>]   write .bearing/state/<branch>.compact.md
#   brg-guard session [--id <session>] [--source startup|resume|compact]
#   brg-guard stats                       what the gates decided here, how often
#                                         and at what cost (.bearing/state/gates.log)
#   brg-guard log <gate> <outcome> [label] [ms]
#                                         append one gates.log line, never
#                                         through a link or into a FIFO
#   brg-guard state-write put|add <name> [cap]
#                                         write stdin to .bearing/state/<name>
#                                         (put: replace; add: append, rotating
#                                         to <name>.1 over cap bytes), never
#                                         through a link or into a FIFO
#   brg-guard readonly "<shell command>"  exit 2 unless every program in the
#                                         command is a read-only tool (git
#                                         diff|log|show|status|blame|ls-files,
#                                         ls, cat, grep, rg, find without -exec,
#                                         sed without -i, jq and similar);
#                                         used by the read-only subagents
#   brg-guard --verbs                     the blocked verb table (tool, pattern,
#                                         label; tab-separated) for generators
#   brg-guard --version                   the version stamp
#
# Claude Code hooks, Cursor hooks and any other harness adapter call these
# subcommands and translate their own event JSON into arguments. One logic,
# one behaviour on every harness. Runs on bash 3.2 (macOS) and needs no tool
# beyond git for the session subcommands.
set -u
sub="${1:-}"; shift || true
READONLY=0
# Hooks run outside the sandbox, and git runs programs the repository names
# (core.fsmonitor, hooks, filter drivers, diff.external, the pager,
# gpg.program under log.showSignature). git_lockdown turns each off for every
# git this script starts and every git those start; it is the same function
# as in hooks/scripts/lib.sh, which says how. The command and readonly
# checks run no git, so they skip it.
git_lockdown() {
  local p k n nl='
' seen='
' q="'\\''"
  p="'core.fsmonitor=false' 'core.hooksPath=/dev/null' 'core.pager=cat' 'diff.external=' 'log.showSignature=false'"
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    n="${k#filter.}"; n="${n%.*}"
    case "$seen" in (*"$nl$n$nl"*) continue ;; esac
    seen="$seen$n$nl"
    n=${n//\'/$q}
    p="$p 'filter.$n.clean'='' 'filter.$n.smudge'='' 'filter.$n.process'='' 'filter.$n.required'='false'"
  done <<EOF
$(git config --name-only --get-regexp '^filter\..*\.(clean|smudge|process)$' 2>/dev/null)
EOF
  # shellcheck disable=SC2089,SC2090 # the quotes are git's own format, kept literally
  export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }$p"
  export GIT_PAGER=cat
  unset GIT_EXTERNAL_DIFF
}
case "$sub" in (command|readonly|--verbs|--version|stats|log|state-write) ;; (*) git_lockdown ;; esac
# brg-push beside this script, as an absolute path (no cd: CDPATH plays no
# part), so it still resolves after a cd to the repository root.
case "$0" in (/*) BRG_PUSH="${0%/*}/brg-push" ;; (*) BRG_PUSH="$PWD/$(dirname "$0")/brg-push" ;; esac

# --------------------------------------------------------------------------
# The blocked verb table. One rule per line: tool|pattern|label.
#   tool     argv[0] after wrappers are stripped and the path removed; a
#            case glob (mkfs*)
#   pattern  space-separated tokens, matched against argv[1..]:
#              word      the next positional argument (flags in between are
#                        skipped, and one argument after a flag may be that
#                        flag's value); a case glob (publish*)
#              *         any positional argument
#              --x / -x  that flag anywhere (also --x=value)
#              ~abc      one of the letters a, b, c inside a short-flag
#                        cluster anywhere (-fd, -xf)
#              @danger   any argument that leaves the repository: /, ~, ~user,
#                        ., .., *, an absolute path, a relative path whose ..
#                        climbs out, or a variable or substitution (it may
#                        be anything, even empty)
#              @remote   any argument of the form host:path or user@host:path
#            an empty pattern blocks the tool outright
#   label    what the block message names
# The engineer pushes, merges and deploys; the agent prepares. The one
# exception: brg-push run, which only the Stop hook calls, under the
# engineer's BEARING_AUTO_PUSH opt-in; it pushes from a fresh clone and runs
# no repository code. The row matches the program name, so a renamed copy of
# brg-push can still run `run` from Bash; it runs in the sandbox there, where
# bearing.env is unreadable, so the opt-in condition fails and nothing pushes.
# --------------------------------------------------------------------------
verb_table() { verb_rows | tr '|' '\t'; }
verb_rows() {
  cat <<'EOF'
git|push|git push
brg-push|run|brg-push run (the Stop hook runs it)
git|commit --amend|git commit --amend
git|rebase|git rebase
git|reset --hard|git reset --hard
git|filter-repo|git filter-repo
git|filter-branch|git filter-branch
git|clean ~f ~dx|git clean -fdx
git|clean --force ~dx|git clean -fdx
git|remote set-url|git remote set-url
git|remote remove|git remote remove
git|remote rm|git remote remove
git|branch ~D|git branch -D
git|branch ~d ~f|git branch -D
git|branch --delete ~f|git branch -D
git|branch ~d --force|git branch -D
git|branch --delete --force|git branch -D
git|stash drop|git stash drop
git|stash clear|git stash clear
git|worktree remove|git worktree remove
git|reflog expire|git reflog expire
git|gc --prune|git gc --prune
git|update-ref ~d|git update-ref -d
git|tag ~d|git tag -d
git|tag --delete|git tag -d
glab|mr create|glab mr create
glab|mr merge|glab mr merge
glab|mr approve|glab mr approve
glab|release create|glab release create
