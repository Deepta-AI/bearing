}

# --------------------------------------------------------------------------
# command: parse the shell command and refuse the blocked verbs. Fail closed:
# anything that cannot be read is refused with a reason.
#
# The scanners run in the C locale and skip runs of ordinary characters with
# one pattern match (${rest%%[specials]*}) instead of reading one character
# at a time, so a 16 KB command parses in about 1.5 s (bash 5; about twice that on bash 3.2). Commands over
# MAX_LEN bytes are refused before any parsing: the hook has a timeout, and a
# timed-out PreToolUse hook lets the command run.
# --------------------------------------------------------------------------
SUBST='__BRG_SUBST__'      # stands in for a $(...) or `...` whose text was checked separately
SENTINEL='__BRG_UNPARSED__' # the adapters pass this when the event JSON could not be read
RD='__BRG_RD__'            # prefixes a redirection operator token from the tokenizer
INPUT_VAR='$__BRG_INPUT'   # stands in for arguments only known at run time (xargs, parallel)
MAX_DEPTH=5
MAX_LEN=16384
HEREDOC_CODE=''; HEREDOC_DATA=''
NL="$(printf '\nx')"; NL="${NL%x}"
TAB="$(printf '\t')"
SQCH="'"
ASSIGN="$NL"   # VAR=value assignments seen in this command, newline separated
US="$(printf '\037')"
FORLIST="$NL"  # for NAME in literal words: NAME=w1<US>w2<US>, newline separated
ARGV_AFTER_FOR=()
LENIENT=0      # inside an interpreter code string: variables are not refused
CODE_TEXT=0    # inside the text of Python or JavaScript that runs no command
WILDMODE=0     # match_rule: a variable or substitution argument may be anything
STDIN_KIND=''; STDIN_TEXT=''
# Bracket patterns for the scanners. A backslash is doubled for the matcher.
PAT_U="[ ${TAB}${NL}'\"\\\\#&<>;|()\`]"   # tokenizer, unquoted
PAT_DQ="[\"\\\\]"                          # tokenizer, inside "..."
PAT_XU="[\\\\'\"#\`\$]"                    # substitutions, unquoted
PAT_XD="[\\\\\"\`\$]"                      # substitutions, inside "..."
PAT_XN="[\\\\\`\$]"                        # substitutions, heredoc body (quotes are text)
PAT_BT="[\\\\\`]"                          # inside `...`
PAT_CS="[()\\\\'\"]"                       # inside $(...)
PAT_AR='[()]'                              # inside $((...))
PAT_Q="['\"\`]"                            # code string, outside a literal
PAT_Q1="[\\\\']"; PAT_Q2="[\\\\\"]"
PAT_QP="['\"]"                              # python code string: backticks are text
PAT_HC="[\\\\'\"()\`\$<#;&|]"              # heredoc line scan, command context
# Text-printing programs: a table tool among their arguments is data, not a command.
TEXT_PROGS=' echo printf grep egrep fgrep rg ag ack man info help whatis apropos which type whereis hash test [ true false : cat less more head tail wc file stat ls '
GIT_BUILTINS=' add am annotate apply archive bisect blame branch bundle cat-file check-attr check-ignore check-mailmap check-ref-format checkout checkout-index cherry cherry-pick citool clean clone column commit commit-graph commit-tree config count-objects credential describe diff diff-files diff-index diff-tree difftool fast-export fast-import fetch fetch-pack filter-branch fmt-merge-msg for-each-ref format-patch fsck gc get-tar-commit-id grep gui hash-object help init instaweb interpret-trailers log ls-files ls-remote ls-tree mailinfo mailsplit maintenance merge merge-base merge-file merge-tree mergetool mktag mktree mv name-rev notes pack-objects pack-refs prune pull push range-diff read-tree rebase reflog remote repack replace request-pull rerere reset restore rev-list rev-parse revert rm send-email shortlog show show-branch show-ref sparse-checkout stash status submodule switch symbolic-ref tag update-index update-ref var verify-commit verify-pack verify-tag version whatchanged worktree write-tree lfs filter-repo '

deny() { # deny <label>
  echo "Bearing blocked '$1': the engineer pushes, merges and deploys; the agent prepares. Print the command for the engineer instead." >&2
  gate_log "$(guard_gate)" refused "$1"
  exit 2
}
refuse() { # refuse <reason>: the command could not be read
  echo "brg-guard: $1; refusing (fail closed)" >&2
  gate_log "$(guard_gate)" refused "unreadable: $1"
  exit 2
}

# --- gate telemetry. In a Bearing repository (.bearing/ at the root) every
# gate decision appends one tab-separated line to .bearing/state/gates.log:
# time, gate, outcome, milliseconds, a short label. Never the command text.
# brg-guard stats reads it back; BEARING_NO_GATE_LOG=1 turns it off. The log
# rotates to gates.log.1 at 512 KB. The hooks run outside the sandbox and
# .bearing/state is the agent's to write, so the append is GATE_LOG_PY in
# python3 -I -S (no current directory or site path, no PYTHON* variable),
# the way brg-push's state_write appends: each directory opened with
# O_NOFOLLOW from the one before, so a linked .bearing or state is refused;
# the log opened O_NOFOLLOW and O_NONBLOCK, so a link is never followed and
# a FIFO never blocks; and kept only as a regular file with one link, else
# its name is removed and a fresh log started (a hard link's other name is
# never written). Each field is printable ASCII (anything else a space) and
# the label 120 bytes at most. Without python3 nothing is logged.
# `brg-guard log <gate> <outcome> [label] [ms]` is the same append for the
# other scripts the hooks run (brg-session, brg-learn, brg-update-check,
# session-end.sh).
now_ms() {
  if [ -n "${EPOCHREALTIME:-}" ]; then local t="${EPOCHREALTIME/./}"; echo "${t:0:$((${#t}-3))}"
  else local s; s="$(date +%s 2>/dev/null)"; echo "${s:-0}000"; fi # bash 3.2 has no EPOCHREALTIME; a bare PATH may lack date
}
GATE_T0="$(now_ms)"
bearing_root() { # the nearest directory upward holding .bearing/, without spawning dirname
  local d="$PWD"
  while :; do
    [ -d "${d:-/}/.bearing" ] && { echo "${d:-/}"; return 0; }
    [ -n "$d" ] && [ "$d" != / ] || return 1
    d="${d%/*}"
  done
}
guard_gate() { if [ "${READONLY:-0}" -eq 1 ]; then echo readonly; else echo command; fi; }
GATE_LOG_PY='import os, sys, time
root, gate, outcome, ms, label = sys.argv[1:6]
def field(s, n):
    return bytes(b if 32 <= b < 127 else 32 for b in os.fsencode(s))[:n]
line = b"\t".join([time.strftime("%Y-%m-%dT%H:%M:%S").encode(), field(gate, 40),
                   field(outcome, 40), field(ms, 20), field(label, 120)]) + b"\n"
DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
def opened(d):
    fd = os.open("gates.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o644, dir_fd=d)
    st = os.fstat(fd)
    if st.st_mode & 0o170000 != 0o100000 or st.st_nlink != 1:
        os.close(fd)
        raise OSError("not a regular file with one link")
    return fd
try:
    d = os.open(".bearing", DIR, dir_fd=os.open(root, os.O_RDONLY | os.O_DIRECTORY))
    try:
        os.mkdir("state", 0o755, dir_fd=d)
    except FileExistsError:
        pass
    d = os.open("state", DIR, dir_fd=d)
    try:
        if os.stat("gates.log", dir_fd=d, follow_symlinks=False).st_size > 524288:
            os.rename("gates.log", "gates.log.1", src_dir_fd=d, dst_dir_fd=d)
    except FileNotFoundError:
        pass
    try:
        fd = opened(d)
    except OSError:
        os.unlink("gates.log", dir_fd=d)
        fd = opened(d)
    os.write(fd, line)
except OSError:
    pass
'
gate_log() { # gate_log <gate> <outcome> [label] [ms]
  [ -z "${BEARING_NO_GATE_LOG:-}" ] || return 0
  local root
  root="$(bearing_root)" || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 -I -S -c "$GATE_LOG_PY" "$root" "$1" "$2" "${4:-$(( $(now_ms) - GATE_T0 ))}" "${3:-}" \
    < /dev/null > /dev/null 2>&1 || true
}

# --- state files the hooks write. The precompact snapshot (here) and
# brg-session's checkpoint and timeline are written outside the sandbox into
# .bearing/state, the agent's to write, so they go through STATE_WRITE_PY,
# the same opens as GATE_LOG_PY: .bearing and state each opened O_NOFOLLOW
# from the one before (a linked directory is refused). put: stdin goes to a
# new file under a random name created O_EXCL|O_NOFOLLOW, then renamed onto
# <name> (a rename replaces a link or FIFO there, never writes through it).
# add: <name> is moved to <name>.1 once over [cap] bytes, then opened
# O_APPEND|O_NOFOLLOW|O_NONBLOCK and kept only as a regular file with one
# link, else removed and started afresh. <name> is one plain file name.
# `brg-guard state-write put|add <name> [cap]` is the same write for
# brg-session. Without python3 nothing is written.
STATE_WRITE_PY='import os, sys
root, mode, name = sys.argv[1:4]
cap = int(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4].isdigit() else 0
if mode not in ("put", "add") or not name or "/" in name or name in (".", ".."):
    sys.exit(1)
data = sys.stdin.buffer.read(1048576)
DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
def write_all(fd):
    view = memoryview(data)
    while view:
        view = view[os.write(fd, view):]
    os.close(fd)
def opened(d):
    fd = os.open(name, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o644, dir_fd=d)
    st = os.fstat(fd)
    if st.st_mode & 0o170000 != 0o100000 or st.st_nlink != 1:
        os.close(fd)
        raise OSError("not a regular file with one link")
    return fd
try:
    d = os.open(".bearing", DIR, dir_fd=os.open(root, os.O_RDONLY | os.O_DIRECTORY))
    try:
        os.mkdir("state", 0o755, dir_fd=d)
    except FileExistsError:
        pass
    d = os.open("state", DIR, dir_fd=d)
    if mode == "put":
        tmp = ".%s.%s.tmp" % (name[:64], os.urandom(8).hex())
        write_all(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=d))
        try:
            os.rename(tmp, name, src_dir_fd=d, dst_dir_fd=d)
        except OSError:
            os.unlink(tmp, dir_fd=d)
            sys.exit(1)
    else:
        try:
            if cap and os.stat(name, dir_fd=d, follow_symlinks=False).st_size > cap:
                os.rename(name, name + ".1", src_dir_fd=d, dst_dir_fd=d)
        except FileNotFoundError:
            pass
        try:
            fd = opened(d)
        except OSError:
            os.unlink(name, dir_fd=d)
            fd = opened(d)
        write_all(fd)
except OSError:
    sys.exit(1)
'
# The session mark. guard session creates .bearing/state, prunes marks older
# than seven days and makes .session-<id> (first mark kept) with the same
# opens: .bearing and state opened O_NOFOLLOW (a linked directory is refused),
# old marks unlinked by name (a link is removed, never followed), the mark
# created O_EXCL|O_NOFOLLOW only when nothing has its name.
SESSION_MARK_PY='import os, sys, time
root, sid = sys.argv[1:3]
DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
try:
    d = os.open(".bearing", DIR, dir_fd=os.open(root, os.O_RDONLY | os.O_DIRECTORY))
    try:
        os.mkdir("state", 0o755, dir_fd=d)
    except FileExistsError:
        pass
    d = os.open("state", DIR, dir_fd=d)
    now = time.time()
    for n in os.listdir(d):
        if not n.startswith(".session-"):
            continue
        try:
            if (now - os.stat(n, dir_fd=d, follow_symlinks=False).st_mtime) // 86400 > 7:
                os.unlink(n, dir_fd=d)
        except OSError:
            pass
    os.close(os.open(".session-" + sid, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=d))
except OSError:
    sys.exit(1)
'
state_write() { # state_write put|add <name> [cap] < content
  local root
  root="$(bearing_root)" || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -I -S -c "$STATE_WRITE_PY" "$root" "$1" "$2" "${3:-0}" > /dev/null 2>&1
}

load_rules() {
  RULE_N=0
  TOOLSET=' '
  while IFS='|' read -r rtool rpat rlabel; do
    [ -n "$rtool" ] || continue
    RULE_TOOL[$RULE_N]="$rtool"; RULE_PAT[$RULE_N]="$rpat"; RULE_LABEL[$RULE_N]="$rlabel"
    case "$TOOLSET" in *" $rtool "*) ;; *) TOOLSET="$TOOLSET$rtool ";; esac
    RULE_N=$((RULE_N+1))
  done <<EOF
$(verb_rows)
EOF
  # First words of the multi-word patterns (gh pr, git remote ...): a verb
  # under one of these that comes from a variable or a substitution is unreadable.
  SUBVERBS=' '
  local i first rest
  i=0
  while [ $i -lt $RULE_N ]; do
    first="${RULE_PAT[$i]%% *}"; rest="${RULE_PAT[$i]#* }"
    if [ "$first" != "${RULE_PAT[$i]}" ] && [ -n "$first" ]; then
      case "$first" in -*|'~'*|'@'*|'*') ;; *) case "$rest" in -*|'~'*|'@'*) ;; *) SUBVERBS="$SUBVERBS${RULE_TOOL[$i]}:$first ";; esac;; esac
    fi
    i=$((i+1))
  done
}
is_table_tool() { # is_table_tool <name>
  case "$TOOLSET" in *" $1 "*) return 0;; esac
  case "$1" in mkfs*) return 0;; esac
  return 1
}

sq() { # sq <text>: SQ is the text single-quoted for the shell (no subshell)
  local t="$1" o=''
  while :; do
    case "$t" in
      *"$SQCH"*) o="$o${t%%"$SQCH"*}'\\''"; t="${t#*"$SQCH"}";;
      *) o="$o$t"; break;;
    esac
  done
  SQ="'$o'"
}
var_name_of() { # $NAME or ${NAME} exactly -> VN=NAME; anything else -> VN=''
  local t="$1" n=''
  case "$t" in '${'*'}') n="${t#\$\{}"; n="${n%\}}";; '$'*) n="${t#\$}";; esac
  case "$n" in [A-Za-z_]*) case "$n" in *[!A-Za-z0-9_]*) n='';; esac;; *) n='';; esac
  VN="$n"
}
assigned_value() { # assigned_value <name>: AV is the last value assigned in this command, rc 1 if none
  local n="$1"
  case "$ASSIGN" in *"${NL}${n}="*) AV="${ASSIGN##*"${NL}${n}="}"; AV="${AV%%"${NL}"*}"; return 0;; esac
  return 1
}
record_assignment() { # NAME=value: remember it; a value that git or a pager runs is checked as a command
  local nm="${1%%=*}" v="${1#*=}"
  case "$nm" in
    GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT|GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*|GIT_CONFIG|GIT_CONFIG_GLOBAL|GIT_CONFIG_SYSTEM|GIT_EXEC_PATH|BASH_ENV)
      [ "$LENIENT" -gt 0 ] || refuse "setting $nm changes what git or bash runs, which cannot be read";;
    GIT_PAGER|PAGER|GIT_EDITOR|EDITOR|VISUAL|GIT_SEQUENCE_EDITOR|GIT_SSH_COMMAND|GIT_SSH|GIT_ASKPASS|SSH_ASKPASS|GIT_EXTERNAL_DIFF|GIT_PROXY_COMMAND|LESSOPEN|LESSCLOSE|PROMPT_COMMAND)
      [ -z "$v" ] || recurse "$v" $((${depth:-0}+1));;
  esac
  ASSIGN="$ASSIGN$nm=$v$NL"
}
# record_for_list: ARGV is "for NAME in w1 w2 ... [do cmd...]". When every word
# is a literal, NAME is remembered with its list so "$NAME" later in the
# command is checked once per value ("for p in python3 python3.12; do $p -V;
# done" was refused as an unreadable program). A list holding a variable, a
# substitution or a glob is not recorded, so a use of NAME stays unreadable.
# Leaves ARGV at the command after an inline "do", or empty.
record_for_list() {
  local nm="${ARGV[1]:-}" i=3 w vals='' ok=1
  ARGV_AFTER_FOR=()
  case "$nm" in [A-Za-z_]*) case "$nm" in *[!A-Za-z0-9_]*) ok=0;; esac;; *) ok=0;; esac
  [ "${ARGV[2]:-}" = in ] || ok=0
  while [ $i -lt "${#ARGV[@]}" ]; do
    w="${ARGV[$i]}"
    if [ "$w" = 'do' ]; then ARGV_AFTER_FOR=("${ARGV[@]:$((i+1))}"); break; fi
    case "$w" in *'$'*|*"$SUBST"*|*'*'*|*'?'*|*'['*|*"$US"*|*"$NL"*) ok=0;; esac
    vals="$vals$w$US"
    i=$((i+1))
  done
  [ $ok -eq 1 ] && [ -n "$vals" ] && FORLIST="$FORLIST$nm=$vals$NL"
  return 0
}
for_values() { # for_values <name>: FV is the US-separated list of a recorded for loop, rc 1 if none
  case "$FORLIST" in *"${NL}$1="*) FV="${FORLIST##*"${NL}$1="}"; FV="${FV%%"${NL}"*}"; return 0;; esac
  return 1
}
quote_rest() { # quote_rest <from>: QREST is ARGV[from..] re-quoted as one shell string
  local i="$1" out=''
  while [ $i -lt "${#ARGV[@]}" ]; do sq "${ARGV[$i]}"; out="$out${out:+ }$SQ"; i=$((i+1)); done
  QREST="$out"
}
argv_rest_plain() { # from index $1: the tokens joined with spaces, as eval does
  local i="$1" out=''
  while [ $i -lt "${#ARGV[@]}" ]; do out="$out${out:+ }${ARGV[$i]}"; i=$((i+1)); done
  printf '%s' "$out"
}
resolve_vars_and_recurse() { # <depth>: re-check with every assigned $NAME replaced by its value; rc 1 when nothing resolved
  local i=0 out='' t hit=0 fidx=-1 v rest
  # A for-loop variable is checked once per value of its literal list.
  while [ $i -lt "${#ARGV[@]}" ]; do
    case "${ARGV[$i]}" in '$'*) var_name_of "${ARGV[$i]}"
      if [ -n "$VN" ] && ! assigned_value "$VN" && for_values "$VN"; then fidx=$i; break; fi;; esac
    i=$((i+1))
  done
  if [ $fidx -ge 0 ]; then
    rest="$FV"
    while [ -n "$rest" ]; do
      v="${rest%%"$US"*}"; rest="${rest#*"$US"}"
      out=''; i=0
      while [ $i -lt "${#ARGV[@]}" ]; do
        if [ $i -eq $fidx ]; then out="$out${out:+ }$v"; else sq "${ARGV[$i]}"; out="$out${out:+ }$SQ"; fi
        i=$((i+1))
      done
      recurse "$out" "$1"
    done
    return 0
  fi
  i=0
  while [ $i -lt "${#ARGV[@]}" ]; do
    t="${ARGV[$i]}"
    case "$t" in
      '$'*) var_name_of "$t"
            if [ -n "$VN" ] && assigned_value "$VN"; then out="$out${out:+ }$AV"; hit=1; i=$((i+1)); continue; fi;;
    esac
    sq "$t"; out="$out${out:+ }$SQ"; i=$((i+1))
  done
  [ $hit -eq 1 ] || return 1
  recurse "$out" "$1"
  return 0
}
check_verb_token() { # <index>: a verb from a substitution or an unresolved variable is unreadable
  local t="${ARGV[$1]}"
  case "$t" in
    *"$SUBST"*) refuse "the verb after ${ARGV[0]} comes from a command substitution";;
    '$'*) refuse "the verb after ${ARGV[0]} is a variable that cannot be read";;
  esac
  return 0
}

shift_argv() { # shift_argv [n]: drop the first n tokens of ARGV
  local n="${1:-1}"
  if [ "${#ARGV[@]}" -gt "$n" ]; then ARGV=("${ARGV[@]:$n}"); else ARGV=(); fi
}
skip_opts() { # skip_opts "<options that take a value>": drop leading flags of ARGV
  local withval=" $1 "
  while [ "${#ARGV[@]}" -gt 0 ]; do
    case "${ARGV[0]}" in
      --) shift_argv; return;;
      -*) case "$withval" in *" ${ARGV[0]} "*) shift_argv 2;; *) shift_argv;; esac;;
      *) return;;
    esac
  done
}

# extract_substitutions <string> <depth> [body]: check every $(...) and `...`
# as its own command and replace it in the string with the SUBST marker. With
# "body" the string is an unquoted heredoc body, where quotes are plain text.
extract_substitutions() {
  local s="$1" depth="$2" body="${3:-}" out='' i=0 j c q='' inner paren n from=0 rest run prev=' '
  n=${#s}
  # nothing to extract: the common case costs one pattern test
  case "$s" in *'`'*|*'$('*) ;; *) EXTRACTED="$s"; return;; esac
  while [ $i -lt $n ]; do
    rest="${s:$i}"
    if [ "$q" = "'" ]; then
      run=${rest%%"$SQCH"*}; i=$((i+${#run}+1)); q=''; prev="'"; continue
    fi
    if [ -n "$body" ]; then run=${rest%%$PAT_XN*}
    elif [ "$q" = '"' ]; then run=${rest%%$PAT_XD*}
    else run=${rest%%$PAT_XU*}; fi
    if [ -n "$run" ]; then i=$((i+${#run})); prev="${run#"${run%?}"}"; fi
    [ $i -lt $n ] || break
    c="${s:$i:1}"
    case "$c" in
      '\') i=$((i+2)); prev=x; continue;;
      "'") [ "$q" = '"' ] || q="'"; i=$((i+1)); prev="$c"; continue;;
      '"') if [ "$q" = '"' ]; then q=''; else q='"'; fi; i=$((i+1)); prev="$c"; continue;;
      '#') # a comment runs to the end of the line; its quotes do not count
        case "$prev" in ' '|"$TAB"|"$NL"|';'|'&'|'|'|'(')
          rest="${s:$i}"; run=${rest%%"$NL"*}; i=$((i+${#run})); continue;; esac
        i=$((i+1)); prev="$c"; continue;;
      '`')
        j=$((i+1))
        while [ $j -lt $n ]; do
          rest="${s:$j}"; run=${rest%%$PAT_BT*}; j=$((j+${#run}))
          [ $j -lt $n ] || break
          if [ "${s:$j:1}" = '\' ]; then j=$((j+2)); else break; fi
        done
        inner="${s:$((i+1)):$((j-i-1))}"
        out="$out${s:$from:$((i-from))}$SUBST"; i=$((j+1)); from=$i; prev=x
        check_string "$inner" $((depth+1)); continue;;
      '$')
        if [ "${s:$((i+1)):2}" = '((' ]; then
          # arithmetic expansion $((...)): a number, never a command
          j=$((i+3)); paren=2
          while [ $j -lt $n ] && [ $paren -gt 0 ]; do
            rest="${s:$j}"; run=${rest%%$PAT_AR*}; j=$((j+${#run}))
            [ $j -lt $n ] || break
            case "${s:$j:1}" in '(') paren=$((paren+1));; ')') paren=$((paren-1));; esac
            j=$((j+1))
          done
          out="$out${s:$from:$((i-from))}0"; i=$j; from=$i; prev=x; continue
        fi
        if [ "${s:$((i+1)):1}" = '(' ]; then
          j=$((i+2)); paren=1
          while [ $j -lt $n ] && [ $paren -gt 0 ]; do
            rest="${s:$j}"; run=${rest%%$PAT_CS*}; j=$((j+${#run}))
            [ $j -lt $n ] || break
            case "${s:$j:1}" in
              '\') j=$((j+2));;
              '(') paren=$((paren+1)); j=$((j+1));;
              ')') paren=$((paren-1)); j=$((j+1));;
              "'") rest="${s:$((j+1))}"; run=${rest%%"$SQCH"*}; j=$((j+${#run}+2));;
              '"') j=$((j+1))
                   while [ $j -lt $n ]; do
                     rest="${s:$j}"; run=${rest%%$PAT_DQ*}; j=$((j+${#run}))
                     [ $j -lt $n ] || break
                     if [ "${s:$j:1}" = '\' ]; then j=$((j+2)); else j=$((j+1)); break; fi
                   done;;
            esac
          done
          if [ $paren -eq 0 ]; then inner="${s:$((i+2)):$((j-i-3))}"; else inner="${s:$((i+2))}"; j=$n; fi
          out="$out${s:$from:$((i-from))}$SUBST"; i=$j; from=$i; prev=x
          check_string "$inner" $((depth+1)); continue
        fi
        i=$((i+1)); prev="$c"; continue;;
    esac
    i=$((i+1))
  done
  EXTRACTED="$out${s:$from}"
}

# scan_segments <string> <depth>: split on ; & | newline ( ) and check each
# segment's tokens (quotes and backslashes honoured, bash 3.2 tokenizer).
# Redirection operators become their own tokens, prefixed with RD, even when
# written without a space (echo hi>out.txt).
st_end_token() { if [ $have -eq 1 ] || [ -n "$cur" ]; then TOK[${#TOK[@]}]="$cur"; fi; cur=''; have=0; }
st_end_segment() { st_end_token; if [ "${#TOK[@]}" -gt 0 ]; then check_tokens "$depth"; fi; TOK=(); }
scan_segments() {
  local s="$1" depth="$2" i=0 c q='' cur='' have=0 n rest run op pre
  n=${#s}
  TOK=()
  while [ $i -lt $n ]; do
    if [ "$q" = "'" ]; then
      rest="${s:$i}"; run=${rest%%"$SQCH"*}; cur="$cur$run"
      if [ "${#run}" -eq "${#rest}" ]; then i=$n; else q=''; i=$((i+${#run}+1)); fi
      continue
    fi
    if [ "$q" = '"' ]; then
      rest="${s:$i}"; run=${rest%%$PAT_DQ*}; cur="$cur$run"; i=$((i+${#run}))
      [ $i -lt $n ] || continue
      if [ "${s:$i:1}" = '"' ]; then q=''; i=$((i+1))
      else c="${s:$((i+1)):1}"; [ "$c" = "$NL" ] || cur="$cur$c"; i=$((i+2)); fi
      continue
    fi
    c="${s:$i:1}"
    case "$c" in
      "'"|'"') q="$c"; have=1; i=$((i+1));;
      '\') c="${s:$((i+1)):1}"; if [ "$c" != "$NL" ]; then cur="$cur$c"; have=1; fi; i=$((i+2));;
      ' '|"$TAB") st_end_token; i=$((i+1));;
      '#') if [ -z "$cur" ] && [ $have -eq 0 ]; then
             rest="${s:$i}"; run=${rest%%"$NL"*}; i=$((i+${#run}))
           else cur="$cur$c"; have=1; i=$((i+1)); fi;;
      '&')
        if [ "${s:$((i+1)):1}" = '>' ]; then
          st_end_token
          if [ "${s:$((i+2)):1}" = '>' ]; then op='&>>'; else op='&>'; fi
          TOK[${#TOK[@]}]="$RD$op"; i=$((i+${#op}))
        else st_end_segment; i=$((i+1)); fi;;
      '<'|'>')
        pre=''
        case "$cur" in
          '') st_end_token;;
          *[!0-9]*) st_end_token;;
          *) pre="$cur"; cur=''; have=0;;
        esac
        op="${s:$i:3}"
        case "$op" in
          '<<<'|'<<-') ;;
          '<('*|'>('*) # process substitution: the parenthesis opens a segment
            [ -z "$pre" ] || TOK[${#TOK[@]}]="$pre"
            i=$((i+1)); continue;;
          '<<'*|'<>'*|'<&'*|'>>'*|'>|'*|'>&'*) op="${op:0:2}";;
          *) op="${op:0:1}";;
        esac
        TOK[${#TOK[@]}]="$RD$pre$op"; i=$((i+${#op}));;
      "$NL"|';'|'|'|'('|')'|'`') st_end_segment; i=$((i+1));;
      *) rest="${s:$i}"; run=${rest%%$PAT_U*}; [ -n "$run" ] || run="$c"
         cur="$cur$run"; have=1; i=$((i+${#run}));;
    esac
  done
  st_end_segment
}

climbs_out() { # a relative path whose .. components leave the directory it starts in
  local p="$1" c d=0 IFS=/
  for c in $p; do
    case "$c" in ''|.) ;; ..) d=$((d-1)); [ $d -ge 0 ] || return 0;; *) d=$((d+1));; esac
  done
  return 1
}
is_danger_path() {
  case "$1" in
    /|/*|'~'|'~'*|.|..|./|'./*'|'../'*|'*'|'*/'|'.*'|'$HOME'|'${HOME}'|'$HOME/'*|'${HOME}/'*|'$PWD'|'$PWD/'*) return 0;;
    *'$'*|*"$SUBST"*) return 0;;   # a variable or substitution may be anything, even empty
  esac
  case "$1" in *..*) climbs_out "$1" && return 0;; esac
  return 1
}
is_remote_target() {
  local t="$1" head
  case "$t" in -*) return 1;; rsync://*|ssh://*) return 0;; esac
  if [ "$WILDMODE" -eq 1 ] && is_wild "$t"; then return 0; fi
  case "$t" in *:*) ;; *) return 1;; esac
  head="${t%%:*}"
  [ -n "$head" ] || return 1
  case "$head" in */*|*[!A-Za-z0-9._@-]*) return 1;; esac
  return 0
}
is_wild() { case "$1" in *'$'*|*"$SUBST"*) return 0;; esac; return 1; }
wild_flag_at() { # ARGV[i] is a variable or substitution that could expand to a flag
  local t="${ARGV[$1]}" p="${ARGV[$(($1-1))]}"
  [ "$WILDMODE" -eq 1 ] || return 1
  case "$t" in '$'*|"$SUBST"*) ;; *) return 1;; esac
  case "$p" in -*=*) return 0;; -*) return 1;; esac   # after a bare flag it is that flag's value
  return 0
}

# match_rule <pattern>: does the pattern match ARGV[1..]? With WILDMODE=1 a
# variable or substitution argument matches whatever it could expand to.
match_rule() {
  local pat="$1" tok pos=1 n="${#ARGV[@]}" i t found after_flag letters cand
  [ -n "$pat" ] || return 0
  for tok in $pat; do
    case "$tok" in
      --*|-?)
        found=0; i=1
        while [ $i -lt "$n" ]; do
          t="${ARGV[$i]}"; case "$t" in "$tok"|"$tok"=*) found=1; break;; esac
          wild_flag_at $i && { found=1; break; }
          i=$((i+1))
        done
        [ $found -eq 1 ] || return 1;;
      '~'*)
        letters="${tok#\~}"; found=0; i=1
        while [ $i -lt "$n" ]; do
          t="${ARGV[$i]}"
          case "$t" in --*|-*[!A-Za-z]*) ;; -*[$letters]*) found=1; break;; esac
          wild_flag_at $i && { found=1; break; }
          i=$((i+1))
        done
        [ $found -eq 1 ] || return 1;;
      '@danger')
        found=0; i=1
        while [ $i -lt "$n" ]; do t="${ARGV[$i]}"; case "$t" in -*) ;; *) is_danger_path "$t" && { found=1; break; };; esac; i=$((i+1)); done
        [ $found -eq 1 ] || return 1;;
      '@remote')
        found=0; i=1
        while [ $i -lt "$n" ]; do is_remote_target "${ARGV[$i]}" && { found=1; break; }; i=$((i+1)); done
        [ $found -eq 1 ] || return 1;;
      *)
        found=0; after_flag=0; cand=0; i=$pos
        while [ $i -lt "$n" ]; do
          t="${ARGV[$i]}"
          case "$t" in
            -*) after_flag=1;;
            *) # shellcheck disable=SC2254
               case "$t" in $tok) found=1; pos=$((i+1)); break;; esac
               if [ "$WILDMODE" -eq 1 ] && is_wild "$t"; then
                 # a variable right after a flag may be that flag's value
                 if [ $after_flag -eq 0 ]; then found=1; pos=$((i+1)); break; fi
                 cand=$((i+1))
               else
                 [ $after_flag -eq 1 ] && [ $cand -eq 0 ] || return 1
               fi
               after_flag=0;;
          esac
          i=$((i+1))
        done
        if [ $found -eq 0 ] && [ $cand -gt 0 ]; then found=1; pos=$cand; fi
        [ $found -eq 1 ] || return 1;;
    esac
  done
  return 0
}
match_tool_rules() { # match_tool_rules <tool> [nonempty]: deny when a rule for the tool matches ARGV
  local i=0
  while [ $i -lt "$RULE_N" ]; do
    # shellcheck disable=SC2254
    case "$1" in ${RULE_TOOL[$i]})
      if [ -z "${2:-}" ] || [ -n "${RULE_PAT[$i]}" ]; then match_rule "${RULE_PAT[$i]}" && deny "${RULE_LABEL[$i]}"; fi;;
    esac
    i=$((i+1))
  done
}
wild_tool_rules() { # a variable or substitution argument could make a blocked verb: refuse
  local i=0
  WILDMODE=1
  while [ $i -lt "$RULE_N" ]; do
    # shellcheck disable=SC2254
    case "$1" in ${RULE_TOOL[$i]})
      if match_rule "${RULE_PAT[$i]}"; then WILDMODE=0; refuse "an argument of $1 comes from a variable or substitution that cannot be read and could make '${RULE_LABEL[$i]}'"; fi;;
    esac
    i=$((i+1))
  done
  WILDMODE=0
}

is_help_only() { # "<tool> <words> --help": help for a blocked verb is fine
  local n="${#ARGV[@]}" i
  [ "$n" -ge 2 ] && [ "$n" -le 4 ] || return 1
  case "${ARGV[$((n-1))]}" in --help|-h) ;; *) return 1;; esac
  i=1; while [ $i -lt $((n-1)) ]; do case "${ARGV[$i]}" in -*|"$SUBST"|'$'*) return 1;; esac; i=$((i+1)); done
  return 0
}

# strip_wrappers: env, sudo, command, exec, nohup, setsid, flock, strace and
# the other programs that run the rest of their arguments; VAR=val; shell
# keywords. Matched on the basename, so /usr/bin/env is env. A wrapper that
# takes a command string (env -S, flock -c) has the string checked here.
strip_wrappers() {
  local a0 name str shell
  while [ "${#ARGV[@]}" -gt 0 ]; do
    a0="${ARGV[0]}"
    case "$a0" in
      [A-Za-z_]*=*) name="${a0%%=*}"; case "$name" in *[!A-Za-z0-9_]*) return;; esac; record_assignment "$a0"; shift_argv; continue;;
    esac
    name="${a0##*/}"
    case "$name" in
      export|declare|typeset|local|readonly)
        shift_argv
        while [ "${#ARGV[@]}" -gt 0 ]; do case "${ARGV[0]}" in [A-Za-z_]*=*) record_assignment "${ARGV[0]}";; esac; shift_argv; done
        return;;
      '{'|'}'|'!'|if|then|else|elif|fi|do|done|while|until|'&&'|'||') shift_argv;;
      for) record_for_list
           [ "${#ARGV_AFTER_FOR[@]}" -gt 0 ] || { ARGV=(); return; }
           ARGV=("${ARGV_AFTER_FOR[@]}");;
      env)
        shift_argv
        while [ "${#ARGV[@]}" -gt 0 ]; do
          case "${ARGV[0]}" in
            -S|--split-string|-S*|--split-string=*)
              # env -S splits a string into a command: check the string with the rest
              case "${ARGV[0]}" in -S|--split-string) str="${ARGV[1]:-}"; shift_argv 2;; -S*) str="${ARGV[0]#-S}"; shift_argv;; *) str="${ARGV[0]#*=}"; shift_argv;; esac
              quote_rest 0; recurse "$str${QREST:+ }$QREST" $((depth+1)); ARGV=(); return;;
            -u|-C|-P|--unset|--chdir) shift_argv 2;;
            --) shift_argv; break;;
            -*) shift_argv;;
            *) break;;
          esac
        done;;
      sudo|doas|pkexec|run0)
        shift_argv; shell=0
        while [ "${#ARGV[@]}" -gt 0 ]; do
          case "${ARGV[0]}" in
            --) shift_argv; break;;
            -s|-i|--shell|--login) shell=1; shift_argv;;
            -u|-g|-h|-p|-C|-D|-r|-t|-T|-U|--user|--group|--host|--prompt|--close-from|--chdir|--role|--type|--other-user|--unit|--property|--setenv|--nice|--machine|--slice) shift_argv 2;;
            --*) shift_argv;;
            -*[si]*) shell=1; shift_argv;;
            -*) shift_argv;;
            *) break;;
          esac
        done
        if [ "${#ARGV[@]}" -eq 0 ] && [ $shell -eq 1 ] && [ "$LENIENT" -eq 0 ]; then refuse "$name -s/-i without a command starts a shell that reads stdin, which cannot be read"; fi;;
      command)
        shift_argv
        # command -v/-V looks a name up and runs nothing.
        case "${ARGV[0]:-}" in -v|-V|-vV|-Vv|-pv|-pV) ARGV=(); return;; esac
        skip_opts "";;
      exec) shift_argv; skip_opts "-a";;
      nohup|builtin|caffeinate|chronic|unbuffer|setsid|catchsegv|dbus-run-session|torsocks|busybox|toybox) shift_argv; skip_opts "--config-file";;
      time) shift_argv; skip_opts "-o -f --output --format";;
      nice) shift_argv; skip_opts "-n --adjustment";;
      ionice) shift_argv; skip_opts "-c -n -p";;
      stdbuf) shift_argv; skip_opts "-i -o -e";;
      strace|ltrace) shift_argv; skip_opts "-e -o -p -s -u -E -a -b -I -O -S -P -X -U -n -A -D -F -L -l --output --attach --user --env --string-limit --trace --signal --status";;
      valgrind|proxychains|proxychains4|cpulimit|sshpass|xvfb-run|numactl|unshare|systemd-run)
        shift_argv; skip_opts "-f -l -p -e -d -P -n -s -w -N -m -C -S -G -R -E -M -H -u --limit --pid --exe --server-num --server-args --auth-file --error-file --wait --setuid --setgid --wd --root --unit --property --setenv --uid --gid --machine --host --working-directory --description --slice";;
      chroot) shift_argv; skip_opts "--userspec --groups"; shift_argv
              [ "${#ARGV[@]}" -gt 0 ] || [ "$LENIENT" -gt 0 ] || refuse "chroot without a command starts a shell that cannot be read";;
      taskset|chrt)
        shift_argv
        while [ "${#ARGV[@]}" -gt 0 ]; do case "${ARGV[0]}" in -p|--pid) ARGV=(); return;; -*) shift_argv;; *) break;; esac; done
        shift_argv;;   # the mask or the priority
      faketime) shift_argv; skip_opts "-p -m -f"; shift_argv;;
      flock)
        shift_argv
        while [ "${#ARGV[@]}" -gt 0 ]; do
          case "${ARGV[0]}" in
            -c|--command) recurse "${ARGV[1]:-}" $((depth+1)); ARGV=(); return;;
            --command=*) recurse "${ARGV[0]#*=}" $((depth+1)); ARGV=(); return;;
            -w|-E|--timeout|--wait|--conflict-exit-code) shift_argv 2;;
            -*) shift_argv;;
            *) break;;
          esac
        done
        shift_argv   # the lock file or descriptor
        case "${ARGV[0]:-}" in -c|--command) recurse "${ARGV[1]:-}" $((depth+1)); ARGV=(); return;; esac;;
      direnv) [ "${ARGV[1]:-}" = exec ] || return; shift_argv 3;;
      *) return;;
    esac
  done
}

# git options: -C dir, -c key=value, --git-dir ... A -c or --config-env that
# defines an alias or points git at code is refused; one whose value is a
# command (core.pager, core.sshCommand ...) has the value checked.
git_config_pair() { # git_config_pair <key=value>
  local k="${1%%=*}" v="${1#*=}"
  [ "$k" != "$1" ] || v=''
  k="$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]')"
  case "$k" in
    alias.*) refuse "git config $k defines an alias the guard cannot read";;
    core.hookspath|include.path|includeif.*|init.templatedir|core.fsmonitor|protocol.*|remote.*.vcs)
      refuse "git config $k points git at code the guard cannot read";;
    core.pager|core.editor|core.sshcommand|core.askpass|core.gitproxy|sequence.editor|diff.external|pager.*|*.textconv|*.command|*.cmd|*.driver|*.clean|*.smudge|*.process|gpg.program|gpg.*.program|credential.helper|credential.*.helper|uploadpack.packobjectshook|remote.*.receivepack|remote.*.uploadpack)
      [ -z "$v" ] || recurse "${v#!}" $((${depth:-0}+1));;
  esac
}
strip_git_options() { # git -C dir -c k=v --git-dir x --work-tree x --no-pager -p -P <sub>
  local rest=() i=0 t
  GIT_CDIR=''
  [ "${#ARGV[@]}" -gt 1 ] || return
  rest=("${ARGV[@]:1}"); ARGV=(git)
  while [ $i -lt "${#rest[@]}" ]; do
    t="${rest[$i]}"
    case "$t" in
      -c) git_config_pair "${rest[$((i+1))]:-}"; i=$((i+2)); continue;;
      --config-env) git_config_pair "${rest[$((i+1))]:-}"; i=$((i+2)); continue;;
      --config-env=*) git_config_pair "${t#--config-env=}"; i=$((i+1)); continue;;
      -C) GIT_CDIR="${rest[$((i+1))]:-}"; i=$((i+2)); continue;;
      --exec-path=*) refuse "git --exec-path=<dir> runs git commands from that directory, which cannot be read";;
      --git-dir|--work-tree|--namespace|--super-prefix|--list-cmds) i=$((i+2)); continue;;
      -*) i=$((i+1)); continue;;
    esac
    break
  done
  while [ $i -lt "${#rest[@]}" ]; do ARGV[${#ARGV[@]}]="${rest[$i]}"; i=$((i+1)); done
}
git_checks() { # after strip_git_options: config writes of aliases, and aliases from the real config; rc 1 when re-checked
  local sub="${ARGV[1]:-}" i a pos=() av
  case "$sub" in
    config)
      i=2
      while [ $i -lt "${#ARGV[@]}" ]; do
        a="${ARGV[$i]}"
        case "$a" in
          -f|--file|--blob|--type|--default|--comment|--value|--url) i=$((i+2)); continue;;
          -*) i=$((i+1)); continue;;
        esac
        pos[${#pos[@]}]="$a"; i=$((i+1))
      done
      [ "${#pos[@]}" -gt 0 ] || return 0
      case "${pos[0]}" in
        set) [ "${#pos[@]}" -lt 3 ] || git_config_pair "${pos[1]}=${pos[2]}";;
        get|list|unset|edit|rename-section|remove-section) ;;
        *) [ "${#pos[@]}" -lt 2 ] || git_config_pair "${pos[0]}=${pos[1]}";;
      esac
      return 0;;
    ''|-*|*'$'*|*"$SUBST"*) return 0;;
  esac
  case "$GIT_BUILTINS" in *" $sub "*) return 0;; esac
  # not a git command: it may be an alias in the real configuration
  case "$GIT_CDIR" in *'$'*|*"$SUBST"*) GIT_CDIR='';; esac
  if [ -n "$GIT_CDIR" ]; then av="$(git -C "$GIT_CDIR" config --get "alias.$sub" 2>/dev/null)"; else av="$(git config --get "alias.$sub" 2>/dev/null)"; fi
  [ -n "$av" ] || return 0
  quote_rest 2
  case "$av" in
    '!'*) recurse "${av#!}${QREST:+ }$QREST" $((depth+1));;
    *) recurse "git $av${QREST:+ }$QREST" $((depth+1));;
  esac
  return 1
}

# drop_redirections: remove RD operators and their targets from ARGV. Sets
# STDIN_KIND (heredoc, string, file) for a shell reading stdin. In read-only
# mode an output redirection may only go to /dev/null or another descriptor.
drop_redirections() {
  local out=() i=0 t op pending='' target
  STDIN_KIND=''; STDIN_TEXT=''
  while [ $i -lt "${#ARGV[@]}" ]; do
    t="${ARGV[$i]}"; i=$((i+1))
    if [ -n "$pending" ]; then
      target="$t"
      case "$pending" in
        '<<<') STDIN_TEXT="$t";;
        '>&'|'<&') [ "$READONLY" -eq 0 ] || case "$target" in [0-9]|[0-9][0-9]|-) ;; *) [ "$pending" = '<&' ] || refuse "output redirection to $target writes a file";; esac;;
        '>'|'>>'|'>|'|'&>'|'&>>'|'<>') [ "$READONLY" -eq 0 ] || case "$target" in /dev/null) ;; *) refuse "output redirection to $target writes a file";; esac;;
      esac
      pending=''; continue
    fi
    case "$t" in
      "$RD"*)
        op="${t#"$RD"}"; op="${op#"${op%%[!0-9]*}"}"
        pending="$op"
        case "$op" in
          '<<'|'<<-') STDIN_KIND='heredoc';;
          '<<<') STDIN_KIND='string';;
          '<'|'<>'|'<&') case "${t#"$RD"}" in [1-9]*) ;; *) STDIN_KIND='file';; esac;;
        esac
        continue;;
    esac
    out[${#out[@]}]="$t"
  done
  # an output operator at the very end has no target; the shell rejects it
  ARGV=()
  [ "${#out[@]}" -eq 0 ] || ARGV=("${out[@]}")
}

# readonly_check: with `brg-guard readonly`, every program must be a read-only
# tool. Wrappers are already stripped; nested shells are still recursed into
# by check_tokens, so `sh -c 'rm x'` is judged on `rm`.
readonly_check() {
  local prog="${ARGV[0]##*/}" i a npos
  case "$prog" in
    git)
      for a in "${ARGV[@]:1}"; do case "$a" in --output|--output=*|--open-files-in-pager*|--ext-diff) refuse "git $a writes a file or runs a program";; esac; done
      [ "${ARGV[1]:-}" != grep ] || for a in "${ARGV[@]:2}"; do case "$a" in -O*) refuse "git grep $a runs a program";; esac; done
      case "${ARGV[1]:-}" in
        diff|log|show|status|blame|ls-files|ls-tree|rev-parse|rev-list|cat-file|describe|shortlog|grep|remote|config|check-ignore|name-rev|merge-base|for-each-ref|tag|stash|branch|worktree)
          case "${ARGV[1]}" in
            remote) for a in "${ARGV[@]:2}"; do case "$a" in -v|--verbose|show|get-url|"") ;; *) refuse "git remote $a is not read-only";; esac; done;;
            config) for a in "${ARGV[@]:2}"; do case "$a" in --get*|--list|-l|--show-origin|--global|--local|--system|-*) ;; *=*) refuse "git config write is not read-only";; esac; done
                    [ "${#ARGV[@]}" -le 3 ] || case "${ARGV[2]}" in --get*|--list|-l|--show-origin) ;; *) refuse "git config with a value is not read-only";; esac;;
            tag) for a in "${ARGV[@]:2}"; do case "$a" in -l|--list|-n*|--sort=*|--contains|--points-at|--merged|--no-merged|-*) ;; *) refuse "git tag with a name is not read-only";; esac; done;;
            stash) case "${ARGV[2]:-push}" in list|show) ;; *) refuse "git stash ${ARGV[2]:-push} is not read-only";; esac;;
            branch) for a in "${ARGV[@]:2}"; do case "$a" in -a|-r|-l|--list|--show-current|--contains|--merged|--no-merged|-v|-vv|--format=*|--sort=*) ;; *) refuse "git branch $a is not read-only";; esac; done;;
            worktree) case "${ARGV[2]:-list}" in list) ;; *) refuse "git worktree ${ARGV[2]} is not read-only";; esac;;
          esac;;
        *) refuse "git ${ARGV[1]:-} is not a read-only subcommand";;
      esac;;
    ls|cat|head|tail|wc|grep|egrep|fgrep|rg|ag|sort|uniq|cut|tr|awk|pwd|echo|printf|true|false|test|'['|jq|yq|diff|cmp|file|stat|tree|which|type|basename|dirname|realpath|readlink|date|less|more|column|comm|paste|join|fold|nl|od|xxd|strings|md5sum|sha256sum|shasum|du|df|uname|whoami|id|hostname|printenv|seq|expr|sleep|tee|cd|sh|bash|zsh|dash|xargs|timeout|env|eval|command|python3|python|node|go|cargo|make|npm|pnpm|uv|gradle|gradlew|xcodebuild|swift|mvn)
      case "$prog" in
        tee) refuse "tee writes files";;
        sort) for a in "${ARGV[@]:1}"; do case "$a" in -o*|--output*) refuse "sort $a writes a file";; esac; done;;
        uniq) npos=0; for a in "${ARGV[@]:1}"; do case "$a" in -*) ;; *) npos=$((npos+1));; esac; done
              [ $npos -lt 2 ] || refuse "uniq with an output file writes it";;
        tree) for a in "${ARGV[@]:1}"; do case "$a" in -o|-o*) refuse "tree -o writes a file";; esac; done;;
        yq) for a in "${ARGV[@]:1}"; do case "$a" in -i|--inplace|-i*) refuse "yq -i writes files";; esac; done;;
        rg) for a in "${ARGV[@]:1}"; do case "$a" in --pre|--pre=*) refuse "rg --pre runs a program on every file";; esac; done;;
        date) i=1
              while [ $i -lt "${#ARGV[@]}" ]; do
                a="${ARGV[$i]}"
                case "$a" in
                  -s|-s*|--set|--set=*) refuse "date $a sets the clock";;
                  -d|--date|-r|--reference|-f|--file) i=$((i+1));;
                  -*|+*) ;;
                  *) refuse "date with an argument sets the clock";;
                esac
                i=$((i+1))
              done;;
        awk) readonly_awk;;
        go) case "${ARGV[1]:-}" in
              list|vet|version|env|doc|mod|test)
                for a in "${ARGV[@]:2}"; do case "$a" in -exec|-exec=*|-toolexec|-toolexec=*|-vettool*|-o|-o=*|-c|-w|-u|*profile*|-trace|-trace=*|-outputdir*) refuse "go ${ARGV[1]} $a runs a program or writes files";; esac; done
                [ "${ARGV[1]}" != mod ] || [ "${ARGV[2]:-}" = graph ] || [ "${ARGV[2]:-}" = why ] || [ "${ARGV[2]:-}" = verify ] || refuse "go mod ${ARGV[2]:-} is not read-only";;
              *) refuse "go ${ARGV[1]:-} is not read-only";;
            esac;;
        cargo) case "${ARGV[1]:-}" in metadata|tree|check|test|--version) ;; *) refuse "cargo ${ARGV[1]:-} is not read-only";; esac;;
        make) for a in "${ARGV[@]:1}"; do case "$a" in -n|--dry-run|--just-print|--recon) return 0;; esac; done
              for a in "${ARGV[@]:1}"; do case "$a" in -p|--print-data-base|help|-C|-f|-*|test|check|lint|typecheck|format-check|vet|doctor) ;; *) refuse "make $a may write";; esac; done;;
        npm|pnpm) case "${ARGV[1]:-}" in
                    ls|list|view|test|t|why|outdated|audit|--version|-v) ;;
                    run|run-script) case "${ARGV[2]:-}" in test|test:*|lint|lint:*|typecheck|type-check|check|check:*|format:check|fmt:check) ;; *) refuse "$prog run ${ARGV[2]:-} may write";; esac;;
                    *) refuse "$prog ${ARGV[1]:-} may write";;
                  esac;;
        uv) case "${ARGV[1]:-}" in run|tree|pip|--version) [ "${ARGV[1]}" != pip ] || [ "${ARGV[2]:-}" = list ] || [ "${ARGV[2]:-}" = show ] || refuse "uv pip ${ARGV[2]:-} may write";; *) refuse "uv ${ARGV[1]:-} may write";; esac;;
        gradle|gradlew) for a in "${ARGV[@]:1}"; do case "$a" in test|check|lint|tasks|dependencies|-*|'') ;; *) refuse "gradle $a may write";; esac; done;;
        xcodebuild) for a in "${ARGV[@]:1}"; do case "$a" in test|-list|-showsdks|-version|-*) ;; *) refuse "xcodebuild $a may write";; esac; done;;
        swift) case "${ARGV[1]:-}" in test|package) [ "${ARGV[1]}" != package ] || [ "${ARGV[2]:-}" = describe ] || [ "${ARGV[2]:-}" = show-dependencies ] || refuse "swift package ${ARGV[2]:-} may write";; *) refuse "swift ${ARGV[1]:-} may write";; esac;;
        mvn) for a in "${ARGV[@]:1}"; do case "$a" in test|verify|validate|dependency:tree|-*|'') ;; *) refuse "mvn $a may write";; esac; done;;
        python3|python|node)
          # one-liners are not read-only: their code cannot be judged by a string check
          i=1
          while [ $i -lt "${#ARGV[@]}" ]; do
            case "${ARGV[$i]}" in
              -m) case "${ARGV[$((i+1))]:-}" in pytest|json.tool|unittest) ;; *) refuse "$prog -m ${ARGV[$((i+1))]:-} may write";; esac; i=$((i+1));;
              --version|-V) ;;
              -c|-e|-p|--eval|--print) refuse "$prog ${ARGV[$i]} runs code the read-only agents may not run";;
              -*) ;;
              *) refuse "$prog running a script may write";;
            esac
            i=$((i+1))
          done;;
      esac;;
    pytest|vitest|jest|mocha|tsc|mypy|golangci-lint|shellcheck|detekt|swiftlint|tflint|tfsec|checkov|hadolint|yamllint|markdownlint)
      for a in "${ARGV[@]:1}"; do case "$a" in --fix|--write|-w|--in-place|--update-snapshot|-u) refuse "$prog $a writes files";; esac; done;;
    ruff|prettier|black|eslint|gofmt|shfmt|swiftformat|ktlint|terraform)
      case "$prog" in
        ruff) [ "${ARGV[1]:-}" = check ] || [ "${ARGV[1]:-}" = --version ] || refuse "ruff ${ARGV[1]:-} may write"
              for a in "${ARGV[@]:2}"; do case "$a" in --fix|--unsafe-fixes) refuse "ruff check $a writes files";; esac; done;;
        prettier|black|eslint) case " ${ARGV[*]:1} " in *" --check "*|*" --list-different "*|*" -l "*|*" --diff "*) ;; *) [ "$prog" = eslint ] || refuse "$prog without --check writes files";; esac
              for a in "${ARGV[@]:1}"; do case "$a" in --write|-w|--fix|--fix-dry-run) [ "$a" = --fix-dry-run ] || refuse "$prog $a writes files";; esac; done;;
        gofmt|shfmt|swiftformat|ktlint) for a in "${ARGV[@]:1}"; do case "$a" in -w|-F|--format|-i) refuse "$prog $a writes files";; esac; done;;
        terraform) case "${ARGV[1]:-}" in validate|fmt|show|output|providers|version|graph) [ "${ARGV[1]}" != fmt ] || case " ${ARGV[*]:2} " in *" -check "*|*" -diff "*) ;; *) refuse "terraform fmt without -check writes files";; esac;; *) refuse "terraform ${ARGV[1]:-} may change state";; esac;;
      esac;;
    find)
      for a in "${ARGV[@]:1}"; do case "$a" in -exec|-execdir|-delete|-ok|-okdir|-fprint*|-fls) refuse "find $a may write";; esac; done;;
    sed)
      for a in "${ARGV[@]:1}"; do case "$a" in -i|-i*|--in-place*) refuse "sed -i writes files";; esac; done;;
    *) refuse "'$prog' is not a read-only command (the read-only agents may only inspect)";;
  esac
  return 0
}
awk_program() { # AWKP: the program text of an awk command in ARGV, AWKF=1 when it comes from a file
  local i=1 a
  AWKP=''; AWKF=0
  while [ $i -lt "${#ARGV[@]}" ]; do
    a="${ARGV[$i]}"
    case "$a" in
      -f|--file|-E|--exec|-i|--include|-l|--load) AWKF=1; i=$((i+2)); continue;;
      -f*|--file=*|-E*|--exec=*|-i*|--include=*) AWKF=1;;
      -e|--source) AWKP="$AWKP${NL}${ARGV[$((i+1))]:-}"; i=$((i+2)); continue;;
      --source=*) AWKP="$AWKP${NL}${a#*=}";;
      -F|-v|--field-separator|--assign) i=$((i+2)); continue;;
      --) i=$((i+1)); [ -n "$AWKP" ] || [ $AWKF -eq 1 ] || AWKP="${ARGV[$i]:-}"; return;;
      -*) ;;
      *) [ -n "$AWKP" ] || [ $AWKF -eq 1 ] || AWKP="$a"; return;;
    esac
    i=$((i+1))
  done
}
awk_statements() { # AWKS: the awk program split into statements, one per line
  AWKS="$1"; AWKS="${AWKS//;/$NL}"; AWKS="${AWKS//\{/$NL}"; AWKS="${AWKS//\}/$NL}"
}
readonly_awk() {
  local st
  awk_program
  [ $AWKF -eq 0 ] || refuse "awk with a program file or an include cannot be read in read-only mode"
  case "$AWKP" in *system*|*'|'*getline*|*'|&'*) refuse "awk runs a command";; esac
  awk_statements "$AWKP"
  while IFS= read -r st; do
    case "$st" in *print*'>'*|*print*'|'*) refuse "awk print with a redirection writes a file or runs a command";; esac
  done <<EOF
$AWKS
EOF
}
awk_pipes() { # command mode: an awk pipe to or from a command built at run time cannot be read
  local st after before
  awk_statements "$1"
  while IFS= read -r st; do
    case "$st" in
      *'|&'*) refuse "awk |& runs a coprocess that cannot be read";;
      *print*'|'*)
        after="${st#*print}"; after="${after#*|}"
        case "$after" in '|'*) continue;; esac
        after="${after#"${after%%[! ]*}"}"
        case "$after" in '"'*) CODE_EXEC=1;; *) refuse "awk print pipes to a command built at run time";; esac;;
      *'|'*getline*)
        before="${st%|*}"; before="${before%"${before##*[! ]}"}"
        case "$before" in *'|') ;; *'"') CODE_EXEC=1;; *) refuse "awk getline reads from a command built at run time";; esac;;
    esac
  done <<EOF
$AWKS
EOF
}

# code_exec_check <code>: CODE_EXEC=1 when an interpreter one-liner runs a
# command (system, exec, spawn, popen, subprocess, backticks); refuse when
# the command is not a literal the guard can read.
code_exec_check() {
  local s="$1" lang="${2:-}" key rest pre a keys
  CODE_EXEC=0
  # backticks run a command in shell, Ruby, Perl and PHP; in Python they are
  # text and in JavaScript a template string
  case "$lang" in python|js) ;; *) case "$s" in *'`'*) CODE_EXEC=1;; esac;; esac
  keys='system exec spawn popen Popen shell_exec passthru proc_open pcntl_exec subprocess. check_output check_call getoutput'
  case "$s" in *subprocess*) keys="$keys run call";; esac
  for key in $keys; do
    rest="$s"
    while :; do
      case "$rest" in *"$key"*) ;; *) break;; esac
      pre="${rest%%"$key"*}"; rest="${rest#*"$key"}"
      case "$pre" in *[A-Za-z0-9_]) continue;; esac   # part of a longer word (ecosystem)
      a="${rest#"${rest%%[!A-Za-z0-9_]*}"}"         # the rest of the name (execSync, spawnSync)
      case "$key" in
        *.) ;;                                          # subprocess.<method>: the method is the call
        *) case "${rest%%[!A-Za-z0-9_]*}" in            # exec_module, system_prompt are other names
             ''|Sync|File|FileSync|v|l|ve|le|vp|lp|vpe|lpe|_command) ;;
             *) continue;;
           esac;;
      esac
      case "$a" in ' '*|'('*|"$TAB"*) ;; *) continue;; esac  # not a call
      CODE_EXEC=1
      a="${a#"${a%%[! (${TAB}]*}"}"
      case "$a" in \"*|"$SQCH"*|'`'*|'['*|'') ;; *) refuse "an interpreter one-liner runs a command built at run time ($key); it cannot be read";; esac
    done
  done
}

check_tokens() {
  local depth="$1" t0 t i sub found first sk st a script info
  local saved=() rest=() pcmd=() fx
  ARGV=("${TOK[@]}")
  drop_redirections; sk="$STDIN_KIND"; st="$STDIN_TEXT"
  strip_wrappers
  [ "${#ARGV[@]}" -gt 0 ] || return 0
  t0="${ARGV[0]}"
  if [ "$LENIENT" -eq 0 ]; then
    # The program must be readable: not a substitution, and a bare variable
    # only when this command assigned it ($VAR/path/prog is judged by its name).
    case "$t0" in *"$SUBST"*) refuse "the program name comes from a command substitution";; esac
    case "$t0" in
      */*) case "${t0##*/}" in '$'*) refuse "the program name is a variable that cannot be read";; esac;;
      '$'*)
        var_name_of "$t0"
        if [ -n "$VN" ] && resolve_vars_and_recurse $((depth+1)); then return 0; fi
        refuse "the program name is a variable that cannot be read";;
    esac
  fi
  t0="${t0##*/}"; ARGV[0]="$t0"
  if [ "$t0" = git ]; then strip_git_options; git_checks || return 0; fi
  if [ "$READONLY" -eq 1 ]; then readonly_check; fi
  found=0; is_table_tool "$t0" && found=1
  if [ $found -eq 1 ] && [ "$LENIENT" -eq 0 ] && [ "${#ARGV[@]}" -gt 1 ]; then
    # A variable this command assigned is replaced by its value and re-checked.
    resolve_vars_and_recurse $((depth+1)) && return 0
    # A verb under a guarded tool must be readable too (git $X; gh pr $Y).
    check_verb_token 1
    if [ "${#ARGV[@]}" -gt 2 ]; then
      case "$SUBVERBS" in *" $t0:${ARGV[1]} "*) check_verb_token 2;; esac
    fi
  fi
  if [ $found -eq 1 ] && ! is_help_only; then
    match_tool_rules "$t0"
    # Any other variable or substitution argument: refuse when it could make a blocked verb.
    if [ "$LENIENT" -eq 0 ]; then
      i=1; while [ $i -lt "${#ARGV[@]}" ]; do is_wild "${ARGV[$i]}" && { wild_tool_rules "$t0"; break; }; i=$((i+1)); done
    fi
  fi
  # A blocked verb among the arguments of a program that runs its arguments
  # (setsid-like wrappers the list above does not name): refuse the same way.
  # Not in the text of Python or JavaScript code that runs no command, where
  # "the step runs helm upgrade" is prose, not a wrapper.
  [ "$CODE_TEXT" -eq 0 ] && case "$TEXT_PROGS" in *" $t0 "*) ;; *)
    i=1
    while [ $i -lt "${#ARGV[@]}" ]; do
      t="${ARGV[$i]##*/}"
      if is_table_tool "$t"; then
        saved=("${ARGV[@]}"); ARGV=("$t")
        [ $((i+1)) -ge "${#saved[@]}" ] || ARGV=("$t" "${saved[@]:$((i+1))}")
        is_help_only || match_tool_rules "$t" nonempty
        ARGV=("${saved[@]}")
      fi
      i=$((i+1))
    done;;
  esac
  # Wrappers that run another command: check what they run.
  case "$t0" in
    eval) sub="$(argv_rest_plain 1)"; recurse "$sub" $((depth+1));;
    trap) case "${ARGV[1]:-}" in -*|'') ;; *) recurse "${ARGV[1]}" $((depth+1));; esac;;
    alias) i=1; while [ $i -lt "${#ARGV[@]}" ]; do case "${ARGV[$i]}" in *=*) recurse "${ARGV[$i]#*=}" $((depth+1));; esac; i=$((i+1)); done;;
    sh|bash|zsh|dash|ksh|mksh|fish|su|runuser|sg)
      i=1; found=0; script=''; info=0
      while [ $i -lt "${#ARGV[@]}" ]; do
        a="${ARGV[$i]}"
        case "$a" in
          --version|--help) info=1;;
          --command|--session-command) found=1; break;;
          --command=*) found=2; break;;
          -o|-O|+o|+O|--rcfile|--init-file) i=$((i+1));;
          --*) ;;
          -*c*) found=1; break;;
          -*|+*) case "$t0:$a" in su:-s|su:-g|su:-G|runuser:-s|runuser:-g|runuser:-G|runuser:-u|runuser:-w) i=$((i+1));; esac;;
          *) [ -n "$script" ] || script="$a"; case "$t0" in su|runuser|sg) ;; *) break;; esac;;
        esac
        i=$((i+1))
      done
      if [ $found -eq 1 ]; then
        # "sh -c <string>" runs the string: check it.
        [ $((i+1)) -lt "${#ARGV[@]}" ] || refuse "$t0 -c without a command string"
        recurse "${ARGV[$((i+1))]}" $((depth+1))
      elif [ $found -eq 2 ]; then
        recurse "${ARGV[$i]#*=}" $((depth+1))
      elif [ "$t0" = sg ] && [ "${#ARGV[@]}" -gt 2 ]; then
        recurse "$(argv_rest_plain 2)" $((depth+1))
      elif [ "$t0" = su ] || [ "$t0" = runuser ] || [ "$t0" = sg ]; then
        [ "$LENIENT" -gt 0 ] || refuse "$t0 without -c starts a shell that cannot be read"
      elif [ -n "$script" ]; then
        # "bash file args" runs the same unread file as "./file args", so it
        # gets the same check as that command. Refusing only the bash form
        # would stop nothing and would break every kit helper called as
        # bash "${CLAUDE_PLUGIN_ROOT}/bin/...". A shell reading a pipe or
        # stdin (below) is different: those commands are built at run time.
        recurse "$(argv_rest_plain "$i")" $((depth+1))
      elif [ $info -eq 1 ] || [ "$LENIENT" -gt 0 ]; then :
      elif [ "$sk" = heredoc ]; then :   # the heredoc body is checked as commands
      elif [ "$sk" = string ]; then recurse "$st" $((depth+1))
      else refuse "$t0 reading commands from a pipe or a file cannot be read"
      fi;;
    script)
      i=1; found=0
      while [ $i -lt "${#ARGV[@]}" ]; do
        a="${ARGV[$i]}"
        case "$a" in
          --command) found=1; recurse "${ARGV[$((i+1))]:-}" $((depth+1)); break;;
          --command=*) found=1; recurse "${a#*=}" $((depth+1)); break;;
          --*) ;;
          -*c*) found=1; t="${a#*c}"; if [ -n "$t" ]; then recurse "$t" $((depth+1)); else recurse "${ARGV[$((i+1))]:-}" $((depth+1)); fi; break;;
        esac
        i=$((i+1))
      done
      [ $found -eq 1 ] || [ "$LENIENT" -gt 0 ] || refuse "script without -c starts a shell that cannot be read";;
    xargs)
      shift_argv; sub=''
      while [ "${#ARGV[@]}" -gt 0 ]; do
        case "${ARGV[0]}" in
          -I) sub="${ARGV[1]:-}"; shift_argv 2;;
          -I*) sub="${ARGV[0]#-I}"; shift_argv;;
          -i|--replace) sub='{}'; shift_argv;;
          -i*|--replace=*) sub="${ARGV[0]#*[i=]}"; shift_argv;;
          -n|-P|-d|-L|-s|-E|-a|--max-args|--max-procs|--delimiter|--max-lines|--max-chars|--eof|--arg-file) shift_argv 2;;
          --) shift_argv; break;;
          -*) shift_argv;;
          *) break;;
        esac
      done
      [ "${#ARGV[@]}" -gt 0 ] || return 0
      # the arguments come from stdin at run time: they stand in as a variable
      if [ -n "$sub" ]; then
        i=0; while [ $i -lt "${#ARGV[@]}" ]; do ARGV[$i]="${ARGV[$i]//"$sub"/$INPUT_VAR}"; i=$((i+1)); done
        quote_rest 0; recurse "$QREST" $((depth+1))
      else
        quote_rest 0; recurse "$QREST $INPUT_VAR" $((depth+1))
      fi;;
    parallel)
      shift_argv
      skip_opts "-j --jobs -S --sshlogin -N -n -I --delay --timeout --results --joblog -d --delimiter --colsep -C --tagstring --tmpdir --workdir --env --halt -E --max-args --max-replace-args --basefile --return --memfree --load"
      pcmd=(); t=''
      while [ "${#ARGV[@]}" -gt 0 ]; do
        case "${ARGV[0]}" in ':::'|':::+') t=args; shift_argv; break;; '::::'|'::::+'|-a|--arg-file) t=files; break;; esac
        pcmd[${#pcmd[@]}]="${ARGV[0]}"; shift_argv
      done
      if [ "${#pcmd[@]}" -eq 0 ]; then
        [ "$t" = args ] || refuse "parallel reading its commands from stdin or a file cannot be read"
        while [ "${#ARGV[@]}" -gt 0 ]; do case "${ARGV[0]}" in ':::'*) ;; *) recurse "${ARGV[0]}" $((depth+1));; esac; shift_argv; done
      else
        rest=(); [ "${#ARGV[@]}" -eq 0 ] || rest=("${ARGV[@]}")
        ARGV=("${pcmd[@]}"); i=0
        while [ $i -lt "${#ARGV[@]}" ]; do ARGV[$i]="${ARGV[$i]//\{\}/$INPUT_VAR}"; i=$((i+1)); done
        quote_rest 0
        case "$QREST" in *"$INPUT_VAR"*) recurse "$QREST" $((depth+1));; *) recurse "$QREST $INPUT_VAR" $((depth+1));; esac
        ARGV=(); [ "${#rest[@]}" -eq 0 ] || ARGV=("${rest[@]}")
      fi;;
    npx)
      shift_argv
      if [ "${#ARGV[@]}" -gt 1 ]; then case "${ARGV[0]}" in -c|--call) recurse "${ARGV[1]}" $((depth+1));; esac; fi
      skip_opts "-p --package -c --call"; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };;
    pnpm|yarn|npm|bun|pipx|uv|poetry)
      if [ "${#ARGV[@]}" -gt 1 ]; then
        case "$t0:${ARGV[1]}" in
          pnpm:dlx|pnpm:exec|yarn:dlx|yarn:exec|npm:exec|npm:x|bun:x|pipx:run|uv:run|uvx:*|poetry:run)
            shift_argv 2; skip_opts "--filter -F -C --dir --directory --project -p --python --with --package --from --spec --workspace -w"
            [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };;
        esac
      fi;;
    bunx|uvx) shift_argv; skip_opts "--from --with -p --python --bun"; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };;
    timeout) shift_argv; skip_opts "-s --signal -k --kill-after"; shift_argv; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };;
    watch) shift_argv; skip_opts "-n --interval"; [ "${#ARGV[@]}" -eq 0 ] || recurse "$(argv_rest_plain 0)" $((depth+1));;
    make)
      i=1; found=0
      while [ $i -lt "${#ARGV[@]}" ]; do case "${ARGV[$i]}" in -C|-C*|--directory|--directory=*) found=1;; esac; i=$((i+1)); done
      if [ $found -eq 1 ]; then shift_argv; skip_opts "-C -f --directory --file -j -l -o -W -I"; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); }; fi;;
    docker|podman|nerdctl)
      first="${ARGV[1]:-}"
      if [ "$first" = compose ] && [ "${#ARGV[@]}" -gt 2 ]; then
        case "${ARGV[2]}" in exec|run) shift_argv 3; skip_opts "-e -u -w --env --user --workdir --entrypoint --name -p --publish -v --volume -l --label --env-file"; shift_argv; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };; esac
      else
        case "$first" in
          exec|run) shift_argv 2; skip_opts "-e -u -w -v -p -m -h -l --env --user --workdir --entrypoint --name --network --mount --volume --publish --label --env-file --platform --pull --restart --add-host --cap-add --device --dns --ip --log-driver --memory --cpus --hostname --cidfile --cgroup-parent --detach-keys --gpus --runtime --security-opt --shm-size --stop-signal --tmpfs --ulimit --workdir"; shift_argv; [ "${#ARGV[@]}" -eq 0 ] || { quote_rest 0; recurse "$QREST" $((depth+1)); };;
        esac
      fi;;
    find)
      i=1
      while [ $i -lt "${#ARGV[@]}" ]; do
        case "${ARGV[$i]}" in
          -exec|-execdir|-ok|-okdir)
            fx=''; i=$((i+1))
            while [ $i -lt "${#ARGV[@]}" ]; do case "${ARGV[$i]}" in ';'|'+') break;; esac; sq "${ARGV[$i]}"; fx="$fx${fx:+ }$SQ"; i=$((i+1)); done
            [ -z "$fx" ] || recurse "$fx" $((depth+1));;
        esac
        i=$((i+1))
      done;;
    python|python2|python3|node|ruby|perl|php|deno)
      i=1
      while [ $i -lt "${#ARGV[@]}" ]; do
        case "${ARGV[$i]}" in -c|-e|-E|-r|-p|--eval|--print) [ $((i+1)) -lt "${#ARGV[@]}" ] && [ "$READONLY" -eq 0 ] && check_code_string "${ARGV[$((i+1))]}" $((depth+1)) "$(code_lang "$t0")";; esac
        i=$((i+1))
      done;;
    awk|gawk|mawk|nawk)
      if [ "$READONLY" -eq 0 ]; then awk_program; [ -z "$AWKP" ] || check_code_string "$AWKP" $((depth+1)) awk; fi;;
  esac
  return 0
}

# check_code_string <code> <depth> [awk|python|js]: an interpreter one-liner (python -c,
# node -e, awk). Every quoted literal is checked as a shell command, and so is
# the code with quotes, commas and brackets flattened to spaces (["git",
# "push"]). When the code runs commands, its literals are checked strictly
# (a variable program is refused) and a command built at run time is refused.
check_code_string() {
  local s="$1" depth="$2" lang="${3:-}" i=0 n q='' lit='' rest run pat strict=0 bare='' from=0 k=0 qpat="$PAT_Q"
  local lits=()
  [ "$lang" != python ] || qpat="$PAT_QP"
  n=${#s}
  # one pass: the literals, and the code with each literal reduced to "L" (bare)
  while [ $i -lt $n ]; do
    rest="${s:$i}"
    if [ -z "$q" ]; then
      run=${rest%%$qpat*}; i=$((i+${#run})); [ $i -lt $n ] || break
      q="${s:$i:1}"; bare="$bare${s:$from:$((i-from))}$q"
      if [ "$lang" = python ] && [ "${s:$i:3}" = "$q$q$q" ]; then
        # a triple-quoted string runs to the next triple quote, apostrophes and all
        rest="${s:$((i+3))}"; run="${rest%%"$q$q$q"*}"
        lits[${#lits[@]}]="$run"; bare="${bare}L$q"
        i=$((i+6+${#run})); from=$i; q=''; continue
      fi
      i=$((i+1)); lit=''; continue
    fi
    case "$q" in "'") pat="$PAT_Q1";; '"') pat="$PAT_Q2";; *) pat="$PAT_BT";; esac
    run=${rest%%$pat*}; lit="$lit$run"; i=$((i+${#run})); [ $i -lt $n ] || break
    if [ "${s:$i:1}" = '\' ]; then lit="$lit${s:$((i+1)):1}"; i=$((i+2)); continue; fi
    lits[${#lits[@]}]="$lit"; lit=''; bare="${bare}L$q"; q=''; i=$((i+1)); from=$i
  done
  if [ -z "$q" ]; then bare="$bare${s:$from}"; else [ -z "$lit" ] || lits[${#lits[@]}]="$lit"; bare="${bare}L"; fi
  code_exec_check "$bare" "$lang"
  [ "$lang" != awk ] || awk_pipes "$bare"
  [ "$CODE_EXEC" -eq 1 ] && strict=1
  [ $strict -eq 1 ] || LENIENT=$((LENIENT+1))
  # A literal is checked as the command it could become. In Python or
  # JavaScript code that runs no command, backticks in a string are text
  # (a doc line "runs `helm upgrade` by hand"), so they are read as spaces;
  # once the code runs commands, a string may reach a shell and they count.
  local text=0
  case "$lang:$strict" in python:0|js:0) text=1; CODE_TEXT=$((CODE_TEXT+1));; esac
  while [ $k -lt "${#lits[@]}" ]; do
    lit="${lits[$k]}"
    [ $text -eq 0 ] || lit="$(printf '%s' "$lit" | tr '`' ' ')"
    recurse "$lit" "$depth"; k=$((k+1))
  done
  [ $strict -eq 0 ] || LENIENT=$((LENIENT+1))
  recurse "$(printf '%s' "$s" | tr '"'"'"'`,[]' '      ')" "$depth"
  LENIENT=$((LENIENT-1))
  [ $text -eq 0 ] || CODE_TEXT=$((CODE_TEXT-1))
}

code_lang() { # code_lang <program>: python, js or nothing (backticks execute)
  case "${1##*/}" in python*) echo python;; node|nodejs|deno|bun) echo js;; esac
}

# recurse <string> <depth>: check a nested command and keep the caller's ARGV.
recurse() {
  local keep=()
  [ "${#ARGV[@]}" -eq 0 ] || keep=("${ARGV[@]}")
  check_string "$1" "$2"
  ARGV=()
  [ "${#keep[@]}" -eq 0 ] || ARGV=("${keep[@]}")
}

# check_string <string> <depth>: the entry point for a command string.
check_string() {
  local s="$1" depth="$2"
  [ "$depth" -le "$MAX_DEPTH" ] || refuse "command nesting deeper than $MAX_DEPTH levels"
  case "$s" in *[![:space:]]*) ;; *) return 0;; esac
  extract_substitutions "$s" "$depth"
  scan_segments "$EXTRACTED" "$depth"
}

# strip_data_heredocs <command>: a heredoc body fed to a data sink (cat, tee,
# printf, a file) is text, not a command; scanning it produces false
# refusals on prose that mentions git or holds backticks. A body fed to a
# shell or an unknown program is still scanned as commands; one fed to an
# interpreter is checked as code (HEREDOC_CODE). An unquoted delimiter means
# the shell expands $(...) and `...` in the body, so those bodies are kept in
# HEREDOC_DATA for their substitutions. The operator is found with a quote-
# aware scan: << inside quotes, a <<< here-string and << inside $((...)) are
# not heredocs. Bash 3.2 safe: line by line, no regex captures.
hd_prog() { # HD_PROG: the first command word of a segment prefix
  local w
  HD_PROG=''
  for w in $1; do
    case "$w" in *=*|env|sudo|doas|command|exec|nohup|time|nice|builtin|'{'|'!'|then|do|else|if|while|until|'>'*|'<'*|[0-9]'>'*|-*) continue;; esac
    HD_PROG="${w##*/}"; break
  done
}
hd_scan_line() { # hd_scan_line <line>: track quote context in HS_STK; queue each heredoc operator
  local l="$1" i=0 n c top rest run seg=0 prev=' ' d quoted t pos kind
  n=${#l}
  while [ $i -lt $n ]; do
    if [ -n "$HS_STK" ]; then top="${HS_STK#"${HS_STK%?}"}"; else top=''; fi
    rest="${l:$i}"
    case "$top" in
      "'") run=${rest%%"$SQCH"*}; i=$((i+${#run})); [ $i -lt $n ] || break
           HS_STK="${HS_STK%?}"; i=$((i+1)); prev="'"; continue;;
      '"') run=${rest%%$PAT_XD*}; i=$((i+${#run})); [ $i -lt $n ] || break
           case "${l:$i:1}" in
             '\') i=$((i+2));;
             '"') HS_STK="${HS_STK%?}"; i=$((i+1)); prev='"';;
             '`') HS_STK="$HS_STK\`"; i=$((i+1)); seg=$i;;
             '$') case "${l:$((i+1)):2}" in '(('*) HS_STK="${HS_STK}AA"; i=$((i+3));; '('*) HS_STK="$HS_STK("; i=$((i+2)); seg=$i;; *) i=$((i+1));; esac;;
           esac
           continue;;
      A) run=${rest%%$PAT_AR*}; i=$((i+${#run})); [ $i -lt $n ] || break
         case "${l:$i:1}" in '(') HS_STK="${HS_STK}A";; *) HS_STK="${HS_STK%?}";; esac
         i=$((i+1)); continue;;
    esac
    run=${rest%%$PAT_HC*}
    if [ -n "$run" ]; then i=$((i+${#run})); prev="${run#"${run%?}"}"; fi
    [ $i -lt $n ] || break
    c="${l:$i:1}"
    case "$c" in
      '\') i=$((i+2)); prev=x; continue;;
      "'"|'"') HS_STK="$HS_STK$c"; i=$((i+1));;
      '(') if [ "${l:$((i+1)):1}" = '(' ]; then HS_STK="${HS_STK}AA"; i=$((i+2)); else HS_STK="$HS_STK("; i=$((i+1)); seg=$i; fi;;
      ')') [ "$top" != '(' ] || HS_STK="${HS_STK%?}"; i=$((i+1));;
      '`') if [ "$top" = '`' ]; then HS_STK="${HS_STK%?}"; else HS_STK="$HS_STK\`"; seg=$((i+1)); fi; i=$((i+1));;
      '$') case "${l:$((i+1)):2}" in '(('*) HS_STK="${HS_STK}AA"; i=$((i+3));; '('*) HS_STK="$HS_STK("; i=$((i+2)); seg=$i;; *) i=$((i+1));; esac;;
      '#') case "$prev" in ' '|"$TAB"|';'|'&'|'|'|'('|'`') break;; esac; i=$((i+1));;
      ';'|'&'|'|') i=$((i+1)); seg=$i;;
      '<')
        if [ "${l:$((i+1)):1}" != '<' ]; then i=$((i+1)); prev="$c"; continue; fi
        if [ "${l:$((i+2)):1}" = '<' ]; then i=$((i+3)); prev="$c"; continue; fi   # <<< here-string
        pos=$i; i=$((i+2)); t=0
        if [ "${l:$i:1}" = '-' ]; then t=1; i=$((i+1)); fi
        while [ $i -lt $n ]; do case "${l:$i:1}" in ' '|"$TAB") i=$((i+1));; *) break;; esac; done
        d=''; quoted=0
        while [ $i -lt $n ]; do
          c="${l:$i:1}"
          case "$c" in
            ' '|"$TAB"|';'|'&'|'|'|'<'|'>'|'('|')') break;;
            "'") quoted=1; rest="${l:$((i+1))}"; run=${rest%%"$SQCH"*}; d="$d$run"; i=$((i+${#run}+2));;
            '"') quoted=1; rest="${l:$((i+1))}"; run=${rest%%\"*}; d="$d$run"; i=$((i+${#run}+2));;
            '\') quoted=1; d="$d${l:$((i+1)):1}"; i=$((i+2));;
            *) d="$d$c"; i=$((i+1));;
          esac
        done
        [ -n "$d" ] || continue
        hd_prog "${l:$seg:$((pos-seg))}"
        case "$HD_PROG" in
          cat|tee|printf|echo|head|tail|grep|sort|wc|less|more|cut|tr|awk|sed|diff|cmp|base64|md5sum|sha256sum|shasum|jq|yq|xxd|od|column|fold|nl|paste|'')
            if [ $quoted -eq 1 ]; then kind=data; else kind=datax; fi
            HEREDOC_STRIPPED="$HEREDOC_STRIPPED$d ";;
          python*|node|nodejs|ruby|perl|php|deno|bun) if [ $quoted -eq 1 ]; then kind=code; else kind=codex; fi
            HEREDOC_LANG="$(code_lang "$HD_PROG")";;
          git|gh|glab)
            # a message read from stdin (commit -F -, tag -F -, --body-file -) is text
            case " ${l:$seg:$((pos-seg))} " in
              *' -F - '*|*' --file=- '*|*' --file - '*|*' --body-file - '*|*' --body-file=- '*|*' -F- '*)
                if [ $quoted -eq 1 ]; then kind=data; else kind=datax; fi
                HEREDOC_STRIPPED="$HEREDOC_STRIPPED$d ";;
              *) kind=keep;;
            esac;;
          *) kind=keep;;
        esac
        HD_D[$HD_N]="$d"; HD_K[$HD_N]="$kind"; HD_T[$HD_N]="$t"; HD_N=$((HD_N+1))
        prev=x; continue;;
      *) i=$((i+1));;
    esac
    prev="$c"
  done
}
strip_data_heredocs() {
  local s="$1" hd_out='' line tw
  HEREDOC_STRIPPED=''; HEREDOC_CODE=''; HEREDOC_DATA=''; HEREDOC_LANG=''
  HS_STK=''; HD_N=0; HD_I=0; HD_D=(); HD_K=(); HD_T=()
  while IFS= read -r line || [ -n "$line" ]; do
    if [ $HD_I -lt $HD_N ]; then
      # inside a body: a line equal to the delimiter (tabs allowed with <<-) ends it
      tw="$line"
      if [ "${HD_T[$HD_I]}" = 1 ]; then while [ "${tw#"$TAB"}" != "$tw" ]; do tw="${tw#"$TAB"}"; done; fi
      if [ "$tw" = "${HD_D[$HD_I]}" ]; then
        HD_I=$((HD_I+1)); [ $HD_I -lt $HD_N ] || { HD_I=0; HD_N=0; }
        hd_out="$hd_out$NL"; continue
      fi
      case "${HD_K[$HD_I]}" in
        keep) hd_out="$hd_out$line$NL";;
        code) HEREDOC_CODE="$HEREDOC_CODE$line$NL"; hd_out="$hd_out$NL";;
        codex) HEREDOC_CODE="$HEREDOC_CODE$line$NL"; HEREDOC_DATA="$HEREDOC_DATA$line$NL"; hd_out="$hd_out$NL";;
        datax) HEREDOC_DATA="$HEREDOC_DATA$line$NL"; hd_out="$hd_out$NL";;
        *) hd_out="$hd_out$NL";;
      esac
      continue
    fi
    hd_out="$hd_out$line$NL"
    hd_scan_line "$line"
  done <<EOF_GUARD
$s
EOF_GUARD
  STRIPPED="$hd_out"
}

# --- changed files, for the hooks. git status (and diff, add) re-reads a
# file whose stat changed, which runs any filter driver .gitattributes names,
# and a driver can appear in an included config between git_lockdown's
# enumeration and the git that reads it. So no hook runs them: brg-changed
# (beside this script) reads the index, HEAD's tree and the untracked list
# and compares mtimes and sizes. Without it, nothing is counted.
changed_short() { [ -f "$(dirname "$0")/brg-changed" ] && bash "$(dirname "$0")/brg-changed" --root "$root" --short; }
changed_since() { [ -f "$(dirname "$0")/brg-changed" ] && bash "$(dirname "$0")/brg-changed" --root "$root" --since "$1"; }

# --- the edit hook's formatters. A hook runs outside the sandbox, so a
# formatter is taken only from the allow-list in the format subcommand (gofmt,
# prettier, ruff format, ktlint, swiftformat, terraform fmt, shfmt), only from
# fmt_dirs (never the inherited PATH, never node_modules/.bin or anything else
# in the working tree, never `uv run`, which builds the project), and runs in
# a cleared environment (env -i: HOME, LANG, TMPDIR and PATH set to fmt_dirs).
fmt_dirs() {
  printf '%s\n' /opt/homebrew/bin /usr/local/bin /usr/local/go/bin /usr/bin /bin "${HOME:-/nonexistent}/.local/bin" "${HOME:-/nonexistent}/go/bin"
}
fmt_bin() { # fmt_bin <tool>: FB is the first <dir>/<tool> from fmt_dirs outside the repository; rc 1 when none
  local d
  FB=""
  while IFS= read -r d; do
    [ -n "$d" ] && [ -f "$d/$1" ] && [ -x "$d/$1" ] || continue
    case "$(cd -P "$d" 2>/dev/null && pwd -P)/" in ("$root"/*) continue ;; esac
    FB="$d/$1"; return 0
  done <<EOF
$(fmt_dirs)
EOF
  return 1
}
# prettier_config_ok <file>: 0 when the prettier config that applies to the
# file (the nearest directory, up to the repository root, holding one) is
# JSON data of plain formatting options; 1 otherwise. Prettier reads its
# config and loads what it names (plugins, a parser module, a shared config,
# a JS or TS config), and a text match is not enough: JSON and YAML keys may
# be escaped ("\u0070lugins" is plugins). So PRETTIER_PY parses the config
# with python3 -I and accepts only .prettierrc.json and a package.json
# "prettier" object whose every key is on the allow-list below (overrides
# only as files, excludeFiles and options of those keys; parser only a
# built-in name). Any other config file in that directory (.prettierrc,
# YAML, TOML, JSON5, JS, TS, package.yaml), a link, a FIFO, invalid JSON or
# any other key means prettier is not run. Files are opened O_NOFOLLOW and
# O_NONBLOCK and read only when regular. ruff, shfmt, ktlint, swiftformat,
# gofmt and terraform fmt read only data.
PRETTIER_PY='import json, os, sys
start, root = sys.argv[1], sys.argv[2]
PLAIN = {"printWidth", "tabWidth", "useTabs", "semi", "singleQuote", "quoteProps", "jsxSingleQuote",
         "trailingComma", "bracketSpacing", "bracketSameLine", "objectWrap", "arrowParens", "proseWrap",
         "endOfLine", "htmlWhitespaceSensitivity", "embeddedLanguageFormatting", "singleAttributePerLine",
         "vueIndentScriptAndStyle", "experimentalTernaries", "insertPragma", "requirePragma"}
PARSERS = {"babel", "babel-flow", "babel-ts", "flow", "typescript", "espree", "meriyah", "acorn", "css",
           "less", "scss", "json", "json5", "jsonc", "json-stringify", "graphql", "markdown", "mdx", "vue",
           "yaml", "glimmer", "html", "angular", "lwc", "mjml"}
NAMES = {"package.json", "package.yaml", ".prettierrc", ".prettierrc.json", ".prettierrc.yaml",
         ".prettierrc.yml", ".prettierrc.json5", ".prettierrc.toml", ".prettierrc.js", ".prettierrc.cjs",
         ".prettierrc.mjs", ".prettierrc.ts", ".prettierrc.cts", ".prettierrc.mts", "prettier.config.js",
         "prettier.config.cjs", "prettier.config.mjs", "prettier.config.ts", "prettier.config.cts",
         "prettier.config.mts"}
def scalar(v):
    return isinstance(v, (bool, int, str)) and not isinstance(v, float)
def options_ok(o):
    if not isinstance(o, dict):
        return False
    for k, v in o.items():
        if k == "parser":
            if v not in PARSERS:
                return False
        elif k not in PLAIN or not scalar(v):
            return False
    return True
def globs_ok(v):
    return isinstance(v, str) or (isinstance(v, list) and all(isinstance(x, str) for x in v))
def config_ok(c):
    if not isinstance(c, dict):
        return False
    for k, v in c.items():
        if k == "$schema":
            if not isinstance(v, str):
                return False
        elif k == "overrides":
            if not isinstance(v, list):
                return False
            for o in v:
                if not isinstance(o, dict) or not set(o) <= {"files", "excludeFiles", "options"}:
                    return False
                if "files" not in o or not globs_ok(o["files"]):
                    return False
                if "excludeFiles" in o and not globs_ok(o["excludeFiles"]):
                    return False
                if "options" in o and not options_ok(o["options"]):
                    return False
        elif not options_ok({k: v}):
            return False
    return True
def load(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if st.st_mode & 0o170000 != 0o100000 or st.st_size > 1048576:
            raise ValueError("not a regular file")
        return json.loads(os.read(fd, 1048577).decode("utf-8"))
    finally:
        os.close(fd)
root = os.path.realpath(root)
def inside(p):
    return p == root or p.startswith(root.rstrip("/") + "/")
# prettier walks the path it is given, so this walks the same one: from the
# directory of the file (os.path.abspath, no link resolved) up to the directory
# that is the root. A link on that walk, or a directory that resolves outside
# the root, could put a config the agent chose on the walk prettier takes.
walk = []
d = os.path.abspath(start)
while os.path.realpath(d) != root:
    if os.path.islink(d) or not inside(os.path.realpath(d)):
        sys.exit(2)
    walk.append(d)
    if os.path.dirname(d) == d:
        sys.exit(2)
    d = os.path.dirname(d)
walk.append(root)
for d in walk:
    found = False
    for n in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if n not in NAMES:
            continue
        p = os.path.join(d, n)
        try:
            if n == "package.json":
                c = load(p)
                if not isinstance(c, dict):
                    sys.exit(1)
                if "prettier" not in c:
                    continue
                c = c["prettier"]
            elif n == ".prettierrc.json":
                c = load(p)
            else:
                sys.exit(1)
        except (OSError, ValueError):
            sys.exit(1)
        if not config_ok(c):
            sys.exit(1)
        found = True
    if found:
        sys.exit(0)
sys.exit(0)
'
prettier_config_ok() { # rc 0 run prettier; 2 a link on the walk; 1 any other refusal
  local d
  case "$1" in (*/*) d="${1%/*}" ;; (*) d=. ;; esac
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -I -S -c "$PRETTIER_PY" "$d" "$root" < /dev/null > /dev/null 2>&1
}

guard_command() {
  local cmd="$1"
  set -f
  # bytes, not characters: lengths are byte counts and the scanners index in O(1)
  LC_ALL=C; export LC_ALL
  case "$cmd" in *[![:space:]]*) ;; *) refuse "could not read the command";; esac
  case "$cmd" in *"$SENTINEL"*)
    # the adapter could not read the event; name the tool when it is jq
    command -v jq >/dev/null 2>&1 || refuse "could not read the command: jq not found in $PATH; run brg-doctor"
    refuse "could not read the command";;
  esac
  case "$cmd" in *"$RD"*|*"$SUBST"*|*'__BRG_INPUT'*) refuse "the command holds a guard marker";; esac
  [ "${#cmd}" -le "$MAX_LEN" ] || refuse "command too long to check (${#cmd} bytes, limit $MAX_LEN); run it yourself"
  case "$cmd" in *':(){'*|*':() {'*) deny "fork bomb";; esac
  load_rules
  case "$cmd" in *'<<'*) strip_data_heredocs "$cmd"; cmd="$STRIPPED"; [ -z "${BEARING_GUARD_DEBUG:-}" ] || printf 'stripped: %s\n' "$cmd" >&2;; esac
  check_string "$cmd" 0
  # an unquoted heredoc body is expanded by the shell: its substitutions run
  [ -z "${HEREDOC_DATA:-}" ] || extract_substitutions "$HEREDOC_DATA" 1 body
  # a heredoc body fed to an interpreter is code: every quoted literal and the flattened text are checked
  [ -z "${HEREDOC_CODE:-}" ] || check_code_string "$HEREDOC_CODE" 1 "${HEREDOC_LANG:-}"
  gate_log "$(guard_gate)" allowed
  exit 0
}

case "$sub" in
  command)
    guard_command "${1:-}";;
  readonly)
    READONLY=1; guard_command "${1:-}";;
  --verbs)
    verb_table; exit 0;;
  --version)
    v="$BEARING_GUARD_VERSION"
    # Unstamped (run from the plugin): the version in the plugin's manifest.
    pj="$(dirname "$0")/../.claude-plugin/plugin.json"
    if [ "$v" = "__VERSION__" ] && [ -f "$pj" ]; then v="$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$pj" | head -1)"; fi
    echo "brg-guard $v"; exit 0;;
  format)
    file="${1:-}"; [ -n "$file" ] && [ -f "$file" ] && [ ! -L "$file" ] || exit 0
    root="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$file")"; cd "$root" || exit 0
    root="$(pwd -P)"
    fmt_outcome=skipped
    FMT_PATH="$(fmt_dirs | tr '\n' ':')"; FMT_PATH="${FMT_PATH%:}"
    note() { echo "bearing format: $*"; }
    run() { # run <tool> <args...>: the tool from fmt_dirs only, in a cleared environment
      local t="$1"; shift
      fmt_bin "$t" || { note "$t not installed"; return 0; }
      if /usr/bin/env -i HOME="${HOME:-/}" PATH="$FMT_PATH" LANG="${LANG:-C}" TMPDIR="${TMPDIR:-/tmp}" "$FB" "$@" >/dev/null 2>&1; then
        fmt_outcome=formatted; note "$t formatted ${file##*/}"
      else fmt_outcome=failed; note "$t failed on ${file##*/} (left as written)"; fi
    }
    case "$file" in
  *.go) run gofmt -w "$file";;
  *.ts|*.tsx|*.js|*.jsx|*.json|*.css|*.md|*.yml|*.yaml)
    prettier_config_ok "$file"; prc=$?
    if [ "$prc" -eq 0 ]; then run prettier --log-level silent --write "$file"
    elif [ "$prc" -eq 2 ]; then fmt_outcome=not-run; note "prettier not run: a directory between ${file##*/} and the repository root is a link or leads outside it, so prettier could load a config from anywhere; format ${file##*/} in the session"
    else fmt_outcome=not-run; note "prettier not run: the repository's prettier config is not .prettierrc.json or a package.json prettier object of plain formatting options, so it could load code; format ${file##*/} in the session"; fi;;
  *.py) run ruff format --quiet "$file";;
  *.kt|*.kts) run ktlint -F "$file";;
  *.swift) run swiftformat --quiet "$file";;
  *.tf|*.tfvars) run terraform fmt "$file";;
  *.sh) run shfmt -w -i 2 "$file";;
esac
    gate_log format "$fmt_outcome" "${file##*.}"
    exit 0;;
  task-id)
    prompt="${1:-}"
    [ "$prompt" != "$SENTINEL" ] || exit 0
    # An auto push result not yet shown (brg-push status --unseen prints it once).
    if [ -f "$BRG_PUSH" ] && proot="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -f "$proot/.bearing/state/push-result" ]; then
      ( cd "$proot" && CLAUDE_PROJECT_DIR="$proot" bash "$BRG_PUSH" status --unseen 2>/dev/null )
    fi
    task="$(git branch --show-current 2>/dev/null | grep -oE '[A-Z][A-Z0-9]*(-[0-9]+)+' | head -1)"
    [ -n "$task" ] || exit 0
    case "$prompt" in *"$task"*) exit 0;; esac
    echo "Task: ${task} (from branch $(git branch --show-current)). Use it in commit messages as [${task}]."
    exit 0;;
  session)
    sid=""; source=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --id) sid="${2:-}"; shift; [ $# -gt 0 ] && shift;;
        --source) source="${2:-}"; shift; [ $# -gt 0 ] && shift;;
        *) shift;;
      esac
    done
    [ "$sid" != "$SENTINEL" ] || sid=""
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "bearing: not a git repository, nothing to report."; exit 0; }
    # Mark when this session began, so stop-gate only holds a session to
    # files it changed; resume and compact keep the first mark. Old marks go.
    # SESSION_MARK_PY makes, prunes and marks through no link (a linked
    # .bearing or state is refused); an id that is not a plain name is none.
    case "$sid" in (.*|*[!A-Za-z0-9._-]*) sid="";; esac
    if [ -n "$sid" ] && [ -d "$root/.bearing" ] && command -v python3 >/dev/null 2>&1; then
      python3 -I -S -c "$SESSION_MARK_PY" "$root" "$sid" < /dev/null > /dev/null 2>&1
    fi
    # Auto push: record whether bearing.env opts this repository in (the
    # sandbox hides bearing.env from the agent), and show a result not yet seen.
    if [ -f "$BRG_PUSH" ]; then
      ( cd "$root" && CLAUDE_PROJECT_DIR="$root" bash "$BRG_PUSH" optin-record >/dev/null 2>&1
        CLAUDE_PROJECT_DIR="$root" bash "$BRG_PUSH" status --unseen 2>/dev/null )
    fi
    branch="$(git branch --show-current 2>/dev/null)"
    task="$(printf '%s' "$branch" | grep -oE '[A-Z][A-Z0-9]*(-[0-9]+)+' | head -1)"
    changed="$(changed_short | wc -l | tr -d ' ')"
    echo "bearing session: branch=${branch:-detached} task=${task:-none} changed_files=${changed}"
    # Nobody to ask in a non-interactive session: brg-autopilot's claude -p
    # child (BEARING_AUTOPILOT), or BEARING_NONINTERACTIVE=1 in the
    # environment or bearing.env. Then no AskUserQuestion line is printed.
    headless=0
    if [ -n "${BEARING_AUTOPILOT:-}" ] && [ "${BEARING_AUTOPILOT}" != 0 ]; then headless=1
    elif [ -n "${BEARING_NONINTERACTIVE+x}" ]; then [ "$BEARING_NONINTERACTIVE" = 1 ] && headless=1
    elif [ -f "$(dirname "$0")/brg-config" ] && [ "$(bash "$(dirname "$0")/brg-config" get noninteractive --user 2>/dev/null)" = 1 ]; then headless=1; fi
    [ "$headless" -eq 0 ] || export BEARING_NONINTERACTIVE=1
    # A newer release, once a day, on a fresh start only; 3 s at most inside the hook's 10 s.
    if [ "$source" = "startup" ] && [ -f "$(dirname "$0")/brg-update-check" ]; then
      up="$(bash "$(dirname "$0")/brg-update-check" --budget 3 2>/dev/null)"
      if [ -n "$up" ]; then
        upold="$(printf '%s\n' "$up" | sed -n '1s/^BEARING_UPDATE: \([^ ]*\) -> .*/\1/p')"; upnew="$(printf '%s\n' "$up" | sed -n '1s/.* -> \(.*\)$/\1/p')"
        printf '%s\n' "$up"
        [ "$headless" -eq 1 ] || echo "Bearing $upnew is available (you have $upold). Ask the user with AskUserQuestion: Upgrade now (run the upgrade-tools skill) / Remind me tomorrow (brg-config set update-snooze-until $(( $(date +%s) + 86400 )) --user) / Skip this version (brg-config set update-skip $upnew --user)."
      fi
    fi
    # Opt-in local learnings: ask once, or read back the top few for the next step.
    if [ "$source" = "startup" ] && [ -f "$(dirname "$0")/brg-learn" ]; then
      lstate="$(bash "$(dirname "$0")/brg-learn" state 2>/dev/null)"
      if [ "$lstate" = ask ]; then
        [ "$headless" -eq 1 ] || echo "BEARING_LEARNING: ask. Ask the user once with AskUserQuestion: Yes, learn locally (brg-config set learning on --user) / No (brg-config set learning off --user). Nothing leaves this machine."
      elif [ "$lstate" = on ]; then
        nx="$(bash "$(dirname "$0")/brg-session" next-step --branch "$branch" 2>/dev/null)"
        tops="$(bash "$(dirname "$0")/brg-learn" top --skills "$nx" --n 5 2>/dev/null)"
        [ -z "$tops" ] || { echo "Learnings for the next step:"; printf '%s\n' "$tops"; }
      fi
    fi
    sf="$root/.bearing/state/$(printf '%s' "$branch" | tr '/' '_').md"
    [ -f "$sf" ] && { echo "Handoff state from the previous session (${sf#"$root"/}):"; head -8 "$sf"; }
    if [ "$source" != "compact" ]; then
      bash "$(dirname "$0")/brg-session" resume --source "${source:-startup}" 2>/dev/null || gate_log resume not-run "brg-session resume failed"
    fi
    [ -f "$root/CLAUDE.md" ] && ! head -1 "$root/CLAUDE.md" | grep -q '^@AGENTS.md' && echo "note: CLAUDE.md does not start with @AGENTS.md; run onboard-repo to fix the import."
    # The stack checklists, so any review in this session (gstack /review
    # included) applies them; absent where the guard is vendored alone.
    lists="$(dirname "$0")/brg-checklists"
    if [ -x "$lists" ] && paths="$("$lists" --repo "$root" 2>/dev/null | grep '^/')" && [ -n "$paths" ]; then
      echo "Review checklists for this repository; any code review (gstack /review, branch-review) applies every item and reports it as a finding or checked, none found:"
      printf '%s\n' "$paths" | sed 's/^/  /'
    fi
    # Each stack's conventions skill, named with where that stack lives: a
    # trigger eval found Claude starts coding without loading them, whatever
    # the description says. A stack whose plugin is missing gets the install
    # line instead. Absent where the guard is vendored alone.
    stacks="$(dirname "$0")/brg-stacks"; kp="$(dirname "$0")/brg-kit-paths"
    if [ -x "$stacks" ] && [ -x "$kp" ] && found="$("$stacks" "$root" 2>/dev/null | grep -v '^brg-stacks:')" && [ -n "$found" ]; then
      echo "Stacks in this repository. Before writing or changing code in one, load its conventions skill first (a code review goes to branch-review, which applies them):"
      for lane in $(printf '%s\n' "$found" | cut -f1 | sort -u); do
        dirs="$(printf '%s\n' "$found" | awk -F'\t' -v l="$lane" '$1 == l {print ($2 == "." ? "the root" : $2)}' | head -3 | tr '\n' ',' | sed -e 's/,$//' -e 's/,/, /g')"
        more=$(( $(printf '%s\n' "$found" | awk -F'\t' -v l="$lane" '$1 == l' | wc -l) - 3 ))
        [ "$more" -gt 0 ] && dirs="$dirs and $more more"
        if "$kp" --skill "$lane" >/dev/null 2>&1; then
          echo "  ${lane} (${dirs}): $("$kp" --owner "$lane"):${lane}"
        else
          owner="$("$kp" --owner "$lane")"
          echo "  ${lane} (${dirs}): not installed, /plugin install ${owner}@bearing"
        fi
      done
    fi
    snap="$root/.bearing/state/$(printf '%s' "$branch" | tr '/' '_').compact.md"
    if [ "$source" = "compact" ] && [ -f "$snap" ] && [ ! -L "$snap" ]; then
      echo "The context was just summarised. What stood before it (${snap#"$root"/}):"
      head -60 "$snap"
    fi
    exit 0;;
  stop-gate)
    sid=""; active=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --id) sid="${2:-}"; shift; [ $# -gt 0 ] && shift;;
        --active) active=1; shift;;
        *) shift;;
      esac
    done
    [ "$sid" != "$SENTINEL" ] || sid=""
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    state="$root/.bearing/state"; marker="$state/.check-passed"; start="$state/.session-$sid"
    # Hold the session only to files it changed after its own start and after
    # the last passing check. Without a start mark, or in a repository whose
    # Makefile never writes the marker, there is nothing fair to hold it to.
    [ -n "$sid" ] && [ -f "$start" ] && grep -qs 'check-passed' "$root/Makefile" || { gate_log stop-gate reminder-only "no session mark or marker"; exec "$BASH" "$0" stop; }
    [ -f "$(dirname "$0")/brg-changed" ] || { gate_log stop-gate not-run "missing brg-changed"; exit 0; }
    cc="$state/.check-changed-passed"
    newest="$marker"; [ -f "$cc" ] && { [ ! -f "$marker" ] || [ "$cc" -nt "$marker" ]; } && newest="$cc"
    fresh=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ "$root/$f" -nt "$start" ] || continue
      fresh=$((fresh+1))
    done <<EOF
$(bash "$(dirname "$0")/brg-changed" --root "$root" --since "$newest" --skip-notes)
EOF
    if [ "$fresh" -eq 0 ]; then
      gate_log stop-gate passed
      # A push merge-request or autopilot requested goes only on a stop that
      # passes. brg-push run judges it from files, starts the push detached and
      # returns; its last line is the one shown.
      if [ -f "$state/push-request" ] || [ -L "$state/push-request" ]; then
        if [ -f "$BRG_PUSH" ]; then
          ( cd "$root" && CLAUDE_PROJECT_DIR="$root" bash "$BRG_PUSH" run --id "$sid" 2>&1 ) | tail -1
        fi
      fi
      exit 0
    fi
    target="make check"; grep -qs '^check-changed:' "$root/Makefile" && target="make check-changed"
    msg="bearing: ${fresh} file(s) changed in this session since the last check."
    if [ "$active" -eq 1 ]; then
      echo "$msg Not checked; say so under Not done in the report."
      gate_log stop-gate reminded "$fresh file(s), second stop"
      exit 0
    fi
    echo "$msg Run ${target} and fix what fails before finishing. If it cannot run here, say why under Not done in the report and stop." >&2
    gate_log stop-gate blocked "$fresh file(s), ${target}"
    bash "$(dirname "$0")/brg-learn" log --kind gate-block --skill stop-gate --key "$target" --insight "stop gate blocked; ${target} needed" >/dev/null 2>&1
    exit 2;;
  check-file)
    # The per-file check runs the repository's own Makefile or linters
    # (make check-file, eslint from node_modules, go vet), all of which the
    # agent can write, and a hook runs outside the sandbox. So no hook runs
    # it: it runs in the session (make check-file FILE=<path>), and the Stop
    # gate holds the session to make check. This prints the one line that
    # says so; exit 0 always.
    file="${1:-}"
    [ -n "$file" ] && [ "$file" != "$SENTINEL" ] && [ -f "$file" ] || exit 0
    root="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$file")"
    case "$file" in /*) rel="${file#"$root"/}";; *) rel="$file";; esac
    # git prints the physical top level; on macOS a temp path under /var is
    # /private/var there, so compare against the file's physical directory.
    case "$rel" in /*)
      phys="$(cd "$(dirname "$file")" 2>/dev/null && pwd -P)/${file##*/}"
      rel="${phys#"$root"/}";;
    esac
    if [ -f "$root/Makefile" ] && grep -q '^check-file:' "$root/Makefile" 2>/dev/null; then
      echo "bearing check-file: not run by the hook (hooks run no repository command); run make check-file FILE=$rel in the session"
    else
      echo "bearing check-file: not run by the hook (hooks run no repository command); lint ${rel##*/} in the session"
    fi
    gate_log check-file not-run "hook"
    exit 0;;
  precompact)
    transcript="${1:-}"; [ "$transcript" != "$SENTINEL" ] || transcript=""
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    [ -d "$root/.bearing" ] || exit 0
    branch="$(git -C "$root" branch --show-current 2>/dev/null)"
    task="$(printf '%s' "$branch" | grep -oE '[A-Z][A-Z0-9]*(-[0-9]+)+' | head -1)"
    snapname="$(printf '%s' "${branch:-detached}" | tr '/' '_').compact.md"
    snap="$root/.bearing/state/$snapname"
    base="$(git -C "$root" rev-parse -q --verify origin/HEAD 2>/dev/null || git -C "$root" rev-parse -q --verify main 2>/dev/null || git -C "$root" rev-parse -q --verify master 2>/dev/null)"
    marker="$root/.bearing/state/.check-passed"
    {
      echo "# Before compaction, $(date '+%Y-%m-%d %H:%M')"
      echo "Branch: ${branch:-detached}   Task: ${task:-none}"
      echo
      echo "## Uncommitted changes"
      st="$(changed_short | head -30)"
      printf '%s\n' "${st:-none}"
      if [ -n "$base" ]; then
        echo
        echo "## Commits on this branch"
        lg="$(git -C "$root" log --oneline "$base..HEAD" 2>/dev/null | head -10)"
        printf '%s\n' "${lg:-none}"
      fi
      echo
      echo "## make check"
      newest="$(changed_since "$marker" | wc -l | tr -d ' ')"
      if [ "$newest" -eq 0 ]; then echo "passed after the last change (or nothing changed)"; else echo "not passed since ${newest} file(s) last changed"; fi
      if [ -n "$transcript" ] && [ -f "$transcript" ] && command -v jq >/dev/null 2>&1; then
        asks="$(tail -n 4000 "$transcript" | jq -c 'select(.type == "user" and ((.isMeta // false) | not) and ((.isCompactSummary // false) | not) and (.message.content | type) == "string") | .message.content | select(startswith("<") | not) | .[0:800]' 2>/dev/null | tail -3)"
        if [ -n "$asks" ]; then
          echo
          echo "## The user's last requests, verbatim (oldest first)"
          printf '%s\n' "$asks" | while IFS= read -r line; do printf -- '- %s\n' "$(printf '%s' "$line" | jq -r '.')"; done
        fi
      fi
    } | ( cd "$root" && state_write put "$snapname" ) || { gate_log precompact failed; exit 0; }
    echo "bearing: compaction snapshot written to ${snap#"$root"/}"
    gate_log precompact written
    exit 0;;
  log)
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo "brg-guard log: a gate and an outcome are required" >&2; exit 1; }
    gate_log "$1" "$2" "${3:-}" "${4:-0}"
    exit 0;;
  state-write)
    case "${1:-}" in (put|add) ;; (*) echo "brg-guard state-write: put or add, and a file name, are required" >&2; exit 1;; esac
    case "${2:-}" in (''|.|..|*/*) echo "brg-guard state-write: one plain file name under .bearing/state is required" >&2; exit 1;; esac
    state_write "$1" "$2" "${3:-0}" || { echo "brg-guard state-write: ${2} not written (a link, a FIFO, no .bearing or no python3)" >&2; exit 1; }
    exit 0;;
  stats)
    root="$(bearing_root)" || { echo "brg-guard stats: not a Bearing repository (no .bearing/), nothing logged" >&2; exit 1; }
    log="$root/.bearing/state/gates.log"
    n="$(cat "$log.1" "$log" 2>/dev/null | wc -l | tr -d ' ')"
    [ "$n" -gt 0 ] || { echo "brg-guard stats: 0 gate decisions logged in ${log#"$root"/}, nothing to report" >&2; exit 1; }
    cat "$log.1" "$log" 2>/dev/null | awk -F'\t' 'NR==1{f=$1} {l=$1} END{printf "brg-guard stats: %d gate decisions, %s to %s\n", NR, f, l}'
    cat "$log.1" "$log" 2>/dev/null | awk -F'\t' '{print $2" "$3"\t"$4}' | sort -t"$(printf '\t')" -k1,1 -k2,2n |
      awk -F'\t' '
        function flush() { if (n) { m=v[int((n+1)/2)]; p=v[int(n*0.9+0.999)]; if (p=="") p=v[n];
          printf "  %-28s %6d  median %5d ms  p90 %5d ms  max %6d ms\n", k, n, m, p, v[n] } }
        $1!=k { flush(); k=$1; n=0 } { v[++n]=$2+0 } END { flush() }'
    r="$(cat "$log.1" "$log" 2>/dev/null | awk -F'\t' '$3=="refused"{c[$5]++} END{for (k in c) printf "%6d  %s\n", c[k], k}' | sort -rn | head -5)"
    [ -z "$r" ] || { echo "  most refused:"; printf '%s\n' "$r" | sed 's/^/  /'; }
    exit 0;;
  stop)
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    changed="$(changed_short | wc -l | tr -d ' ')"
    [ "$changed" -gt 0 ] || exit 0
    marker="$root/.bearing/state/.check-passed"
    if [ -f "$marker" ]; then
      newer="$(changed_since "$marker" | wc -l | tr -d ' ')"
      [ "$newer" -gt 0 ] || exit 0
    fi
    echo "bearing: ${changed} changed file(s) and make check has not passed since. Run make check (or definition-of-done) before calling this done."
    # a Makefile whose check never records a pass is why this is only a reminder
    if [ -f "$root/Makefile" ] && [ -d "$root/.bearing" ] && ! grep -qs 'check-passed' "$root/Makefile"; then
      echo "bearing: make check here does not record a pass, so this is a reminder, not a gate; onboard-repo proposes the one line that makes it one."
    fi
    exit 0;;
  -h|--help|"") sed -n '3,39p' "$0" | sed 's/^# \{0,1\}//'; exit 2;;
  *) echo "brg-guard: unknown subcommand $sub" >&2; exit 2;;
esac
