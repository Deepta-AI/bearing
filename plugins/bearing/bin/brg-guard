#!/usr/bin/env bash
BEARING_GUARD_VERSION="__VERSION__"
# brg-guard: the harness-neutral guard logic behind every hook adapter.
#
#   brg-guard command "<shell command>"   exit 2 and a message when the command
#                                         publishes, rewrites history, deploys
#                                         or destroys; exit 2 when the command
#                                         cannot be read (fail closed)
#   brg-guard format <file>               format one file with the repo's formatter
#   brg-guard task-id ["<prompt>"]        print "Task: <ID> ..." when the branch
#                                         carries a ticket id the prompt lacks
#   brg-guard session                     print branch, task, changes, handoff state
#   brg-guard stop                        print a reminder when changes are unchecked
#   brg-guard stop-gate --id <session> [--active]
#                                         exit 2 (reason on stderr) when files
#                                         changed in this session since make
#                                         check last passed; --active (the
#                                         harness already continued once) only
#                                         reminds, so it never loops
#   brg-guard check-file <file>           lint one edited file (make check-file
#                                         when the Makefile has it); exit 2 and
#                                         the problems on stderr
#   brg-guard precompact [<transcript>]   write .bearing/state/<branch>.compact.md
#   brg-guard session [--id <session>] [--source startup|resume|compact]
#   brg-guard stats                       what the gates decided here, how often
#                                         and at what cost (.bearing/state/gates.log)
#   brg-guard readonly "<shell command>"  exit 2 unless every program in the
#                                         command is a read-only tool (git
#                                         diff|log|show|status|blame|ls-files,
#                                         ls, cat, grep, rg, find without -exec,
#                                         sed without -i, jq and similar);
#                                         used by the read-only subagents
#   brg-guard --verbs                     the blocked verb table (tool, pattern,
#                                         label; tab-separated) for generators
#   brg-guard --version                   the version stamp
#
# Claude Code hooks, Cursor hooks and any other harness adapter call these
# subcommands and translate their own event JSON into arguments. One logic,
# one behaviour on every harness. Runs on bash 3.2 (macOS) and needs no tool
# beyond git for the session subcommands.
set -u
sub="${1:-}"; shift || true
READONLY=0

# --------------------------------------------------------------------------
# The blocked verb table. One rule per line: tool|pattern|label.
#   tool     argv[0] after wrappers are stripped and the path removed; a
#            case glob (mkfs*)
#   pattern  space-separated tokens, matched against argv[1..]:
#              word      the next positional argument (flags in between are
#                        skipped, and one argument after a flag may be that
#                        flag's value); a case glob (publish*)
#              *         any positional argument
#              --x / -x  that flag anywhere (also --x=value)
#              ~abc      one of the letters a, b, c inside a short-flag
#                        cluster anywhere (-fd, -xf)
#              @danger   any argument that leaves the repository: /, ~, ~user,
#                        ., .., *, an absolute path, a relative path whose ..
#                        climbs out, or a variable or substitution (it may
#                        be anything, even empty)
#              @remote   any argument of the form host:path or user@host:path
#            an empty pattern blocks the tool outright
#   label    what the block message names
# The engineer pushes, merges and deploys; the agent prepares.
# --------------------------------------------------------------------------
verb_table() { verb_rows | tr '|' '\t'; }
verb_rows() {
  cat <<'EOF'
git|push|git push
git|commit --amend|git commit --amend
git|rebase|git rebase
git|reset --hard|git reset --hard
git|filter-repo|git filter-repo
git|filter-branch|git filter-branch
git|clean ~f ~dx|git clean -fdx
git|clean --force ~dx|git clean -fdx
git|remote set-url|git remote set-url
git|remote remove|git remote remove
git|remote rm|git remote remove
git|branch ~D|git branch -D
git|branch ~d ~f|git branch -D
git|branch --delete ~f|git branch -D
git|branch ~d --force|git branch -D
git|branch --delete --force|git branch -D
git|stash drop|git stash drop
git|stash clear|git stash clear
git|worktree remove|git worktree remove
git|reflog expire|git reflog expire
git|gc --prune|git gc --prune
git|update-ref ~d|git update-ref -d
git|tag ~d|git tag -d
git|tag --delete|git tag -d
glab|mr create|glab mr create
glab|mr merge|glab mr merge
glab|mr approve|glab mr approve
glab|release create|glab release create
glab|release delete|glab release delete
glab|repo delete|glab repo delete
gh|pr create|gh pr create
gh|pr merge|gh pr merge
gh|pr review --approve|gh pr review --approve
gh|pr review ~a|gh pr review --approve
gh|release create|gh release create
gh|release delete|gh release delete
gh|repo delete|gh repo delete
npm|publish|npm publish
pnpm|publish|pnpm publish
yarn|publish|yarn publish
yarn|npm publish|yarn npm publish
cargo|publish|cargo publish
twine|upload|twine upload
uv|publish|uv publish
poetry|publish|poetry publish
gem|push|gem push
mvn|deploy|mvn deploy
gradle|publish*|gradle publish
gradlew|publish*|gradlew publish
dotnet|nuget push|dotnet nuget push
goreleaser|release|goreleaser release
docker|push|docker push
docker|image push|docker push
docker|compose push|docker compose push
docker|build --push|docker build --push
docker|buildx build --push|docker buildx build --push
podman|push|podman push
terraform|apply|terraform apply
terraform|destroy|terraform destroy
terraform|import|terraform import
terraform|taint|terraform taint
terraform|state rm|terraform state rm
terraform|state push|terraform state push
tofu|apply|tofu apply
tofu|destroy|tofu destroy
terragrunt|apply|terragrunt apply
terragrunt|destroy|terragrunt destroy
terragrunt|run-all apply|terragrunt apply
terragrunt|run-all destroy|terragrunt destroy
pulumi|up|pulumi up
pulumi|update|pulumi up
pulumi|destroy|pulumi destroy
kubectl|apply|kubectl apply
kubectl|delete|kubectl delete
kubectl|rollout|kubectl rollout
kubectl|scale|kubectl scale
kubectl|patch|kubectl patch
kubectl|replace|kubectl replace
kubectl|drain|kubectl drain
kubectl|cordon|kubectl cordon
helm|install|helm install
helm|upgrade|helm upgrade
helm|uninstall|helm uninstall
helm|delete|helm uninstall
helm|rollback|helm rollback
flyctl|deploy|fly deploy
fly|deploy|fly deploy
vercel|--prod|vercel --prod
vercel|deploy|vercel deploy
netlify|deploy|netlify deploy
railway|up|railway up
serverless|deploy|serverless deploy
sls|deploy|serverless deploy
sam|deploy|sam deploy
cdk|deploy|cdk deploy
cdk|destroy|cdk destroy
gcloud|run deploy|gcloud run deploy
gcloud|app deploy|gcloud app deploy
gcloud|functions deploy|gcloud functions deploy
gcloud|compute instances delete|gcloud compute instances delete
aws|deploy|aws deploy
aws|s3 sync|aws s3 sync
aws|s3 rm|aws s3 rm
aws|s3 rb|aws s3 rb
aws|cloudformation deploy|aws cloudformation deploy
aws|cloudformation delete-stack|aws cloudformation delete-stack
aws|lambda update-function-code|aws lambda update-function-code
az|webapp deploy|az webapp deploy
az|deployment|az deployment
fastlane|*|fastlane
eas|submit|eas submit
eas|build|eas build
eas|update|eas update
firebase|deploy|firebase deploy
ansible-playbook||ansible-playbook
cap|deploy*|cap deploy
cap|* deploy*|cap deploy
capistrano||capistrano
rm|~rR ~f @danger|rm -rf outside the repository
rm|--recursive ~f @danger|rm -rf outside the repository
rm|~rR --force @danger|rm -rf outside the repository
rm|--recursive --force @danger|rm -rf outside the repository
dd||dd
mkfs*||mkfs
chmod|~R 777|chmod -R 777
chmod|--recursive 777|chmod -R 777
chown|~R * /|chown -R /
chown|--recursive * /|chown -R /
shutdown||shutdown
