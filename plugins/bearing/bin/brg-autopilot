#!/usr/bin/env python3
"""brg-autopilot: the state, the gates and the report of an unattended run from
one requirement statement to a prepared merge request.

The autopilot skill drives the stages; this script is the part that cannot
be talked around: which stage is next, whether its gate holds (checked on
disk, never taken from the model's word), how many attempts are left, the
digest of every decision taken on the user's behalf, and the report. Nothing
here pushes, merges or deploys; a push, where the engineer opted the repository
in, is brg-push's from the Stop hook. The run stops at a prepared merge request.

  brg-autopilot start "<statement>" [--dir D]   begin a run (refuses when one is open)
  brg-autopilot next [--dir D]                  the next stage, its skill and its gate
  brg-autopilot done <stage> [--dir D]          check the gate; mark done or say what is missing
  brg-autopilot fail <stage> "<why>" [--dir D]  count a failed attempt (3 and the stage is blocked)
  brg-autopilot decision <key> <choice> <alternatives> <why> [--adr PATH] [--dir D]
                                                one row of the decision digest
  brg-autopilot report [--dir D]                write docs/autopilot/<run>.md (the MR carries it)
  brg-autopilot status [--dir D]                the stages, attempts and decisions so far
  brg-autopilot profile --ui|--data|--api|--deploy yes|no [--llm yes|no] [--scope lean|full] --why W [--dir D]
                                                what the product has; decides which stages apply
                                                and how much document each one needs
  brg-autopilot stages                          the stage names, in order
  brg-autopilot launch "<statement>" [--dir D] [--print]
                                                run it headless: claude -p with autopilot,
                                                then any smoke it asked for, outside the sandbox
  brg-autopilot smoke-request [--id ID] [--dir D]
                                                headless dod: ask the launcher to run the smoke
  brg-autopilot repos-request [--dir D]         headless repos: ask the launcher to scaffold the
                                                repo plan's missing repositories beside this one

State lives in <dir>/.bearing/state/autopilot.json. Every command prints what it
checked and exits 1 when a gate fails or there is nothing to act on.
"""

import argparse
import datetime
import glob
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request

MAX_ATTEMPTS = 3
MAX_SMOKE_ROUNDS = 3
TRUNKS = ("main", "master", "develop", "trunk")

# stage, the skill that does it, and the gate in words; the gate functions below
# check the same thing on disk
STAGES = [
    ("repo", "new-repo (empty directory); an existing repository gets only what this gate reads, "
     "never a full onboard-repo",
     "a git repository whose Makefile check target records a pass (.check-passed)"),
    # the branch comes before any document: every stage after repo commits on
    # the task branch, never on the trunk (AGENTS.md ground rule 1)
    ("branch", "start-task",
     "a working branch that is not the trunk"),
    ("prd", "prd",
     "docs/product/PRD.md with at least one REQ-nnn statement"),
    ("stories", "backlog",
     "docs/product/backlog.md with at least one US- story and docs/product/coverage.md"),
    ("decide", "tech-decision (auto: the recommendation, recorded Proposed), then brg-autopilot profile",
     "every decision this run took is in the digest, no ADR this run wrote says Accepted, and the "
     "product profile (ui, data, api, deploy) is recorded"),
    ("architecture", "architecture-diagram (scope full); lean: nothing, the existing shape stands",
     "scope full: at least one docs/architecture/*-c4.md with a mermaid diagram; lean: nothing"),
    ("design", "scope full: high-level-design, then deployment-architecture (profile deploy) and "
     "genai-design (profile llm); the data model, API contract and threat model wait for the screens "
     "(contract); lean: low-level-design as one note",
     "scope full: docs/design/*-hld.md passing arch_check; by profile, docs/architecture/deployment.md "
     "with a mermaid diagram and docs/genai/*-solution.md; lean: one docs/design/*.md written this run"),
    ("repos", "scope full: new-repo for each docs/architecture/repo-plan.json entry, beside this repository "
     "(headless: brg-autopilot repos-request); lean: nothing",
     "scope full: every repo-plan entry other than this repository is a git repository beside it whose "
     "make check records a pass and has passed; lean: nothing"),
    ("ux", "profile ui, scope full: ux-flows, design-directions --unattended, design-system, motion-design, "
     "then screen-design --unattended with each feature's data-needs.md; lean: the existing screens and design system "
     "are the precedent",
     "profile ui: flows passing flows_check and tokens passing contrast; on react-shadcn (the default) "
     "a chosen direction (an impeccable pick over at least one challenger, or the highest of 3 scored "
     "variants), docs/design/motion.md, every screen in the design gallery passing gallery_check, and "
     "design-lint; on another stack HTML screens passing states_check"),
    # the contract follows the screens: the API and the data model answer
    # what each screen's data-needs.md says it shows and does
    ("contract", "scope full: data-model (profile data), openapi-spec (profile api), then threat-model, "
     "all from docs/design/screens/*/data-needs.md; lean: the design note covers the contract",
     "scope full: docs/security/threat-model-*.md passing threats_check; by profile, "
     "docs/design/data-model.md passing model_check (with --needs) and api/openapi.yaml; profile ui with "
     "data or api: a docs/design/screens/<feature>/data-needs.md for every feature whose flows list "
     "screens, passing states_check --needs against the newest flows file, and (profile api) "
     "api_doc.py needs; lean: nothing"),
    # after the contract, as in the handbook's greenfield order (screens, then
    # data model, API and threat model, then low-level design): a front-end
    # component's design names the screens, a server component's design needs
    # the API and the data model. The handbook's design-critique of the screens
    # runs here as design_review, on the running app after the build.
    ("lld", "scope full: low-level-design, one per component in the HLD's What gets built table that "
     "this run builds; lean: the design note already is the low-level design",
     "scope full: at least one docs/design/*-lld.md written this run; lean: nothing"),
    ("test_cases", "test-cases",
     "docs/testing/risks.md and docs/testing/test-cases.md passing cases_check against "
     "docs/product/backlog.md and the threat models"),
    ("build", "test-first implementation, story by story (superpowers:test-driven-development), "
     "the stack skill (go, react, ...) and the design system for UI",
     "tests added on the branch, and make check passed after the last change (and make build, "
     "when the Makefile records a build pass)"),
    ("test_automation", "test-automation; profile llm: llm-guardrails and llm-eval",
     "every case in docs/testing/test-cases.md not manual-only or retired is named by its TC id in a "
     "test file, and make check passed after the last change; profile llm: guardrails/policy.yaml and "
     "docs/genai/evals.md"),
    ("test_run", "test-run --changed",
     "a .scratch/test-run/<branch>-changed.json for HEAD with at least one suite run, 0 failed, and every "
     "suite not run left to CI by a recorded decision; a docs-only change passes with 0 layers when the "
     "diff has files (layers [] and files above 0)"),
    ("design_review", "profile ui: design-critique --unattended on the design gallery of the running app",
     "profile ui: a review scoring overall 8.0 with no category below 7 and every screenshot present; "
     "otherwise nothing"),
    ("review", "branch-review",
     "the newest .scratch/review/*/verdict.txt reviews more than 0 files at a commit this branch made (an "
     "ancestor of HEAD past its merge base with the default branch), and "
     "a 'not ready to merge' verdict has every blocking finding fixed in a later commit listed in fixed.txt"),
    ("dod", "definition-of-done",
     "make check passed after the last change, every change committed on the branch, when the "
     "repository ships something runnable a .scratch/smoke-*.md newer than the last commit with "
     "'smoke: N requests checked, 0 failed' (N > 0), and a .scratch/test-run/<branch>-full.json of an "
     "unfiltered run (selection null or except unit) with more than 0 tests, 0 failed, whose sha differs from HEAD only by docs/testing/reports/ (every suite beyond unit left to "
     "CI by decisions passes; a unit-only repository needs the item 14 n/a)"),
    ("mr", "merge-request, then brg-autopilot report",
     "a merge request description in .scratch/, docs/autopilot/<run>.md committed, nothing pushed except by brg-push under the opt-in"),
]
NAMES = [s[0] for s in STAGES]


def sh(args, cwd):
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True)


def git(d, *args):
    return sh(["git", *args], d).stdout.strip()


def porcelain(d):
    """git status --porcelain, unstripped: the first line's leading space is the
    status column, and git() would strip it, turning " M e2e/a.ts" into a
    path that does not exist, so an unstaged change went unseen."""
    return sh(["git", "status", "--porcelain", "--untracked-files=all"], d).stdout.rstrip("\n")


def state_path(d):
    return os.path.join(d, ".bearing", "state", "autopilot.json")


def load(d):
    p = state_path(d)
    if not os.path.isfile(p):
        print("brg-autopilot: no run here; start one with: brg-autopilot start \"<statement>\"", file=sys.stderr)
        sys.exit(1)
    st = json.load(open(p))
    carry_contract(st)
    carry_test_run(st)
    # a run started by an older brg-autopilot lacks the stages added since;
    # they join as pending so the run continues instead of failing on a key
    for n in NAMES:
        st["stages"].setdefault(n, {"status": "pending", "attempts": 0, "checked": "", "notes": []})
    return st


CARRIED = "carried from the old design gate, which checked the data model, API contract and threat models"


def carry_contract(st):
    """A run from before the contract stage, resumed with design done and a
    stage after ux done: its old design gate already held the data model,
    API contract and threat models, so contract is marked done rather than
    pulling the run back behind its low-level design."""
    stages = st.get("stages") or {}
    if "contract" in stages or (stages.get("design") or {}).get("status") != "done":
        return
    later = NAMES[NAMES.index("contract") + 1:]
    if any((stages.get(n) or {}).get("status") == "done" for n in later):
        stages["contract"] = {"status": "done", "attempts": 0, "checked": CARRIED, "notes": [CARRIED]}
        print(f"brg-autopilot: contract {CARRIED}", file=sys.stderr)


TEST_RUN_CARRIED = ("carried: the run was past test_automation before the test_run stage existed; "
                    "dod's full run still checks every suite")


def carry_test_run(st):
    """A run from before the test_run stage, resumed with test_automation done
    and a stage after test_run done: the stage it would rejoin as pending sits
    behind where the run stood, so it is marked done rather than pulling the
    run back, as carry_contract does. A run that stopped right after
    test_automation runs the new gate in its turn. The dod gate's full run
    still holds every suite to 0 failed."""
    stages = st.get("stages") or {}
    if "test_run" in stages or (stages.get("test_automation") or {}).get("status") != "done":
        return
    later = NAMES[NAMES.index("test_run") + 1:]
    if not any((stages.get(n) or {}).get("status") == "done" for n in later):
        return
    stages["test_run"] = {"status": "done", "attempts": 0, "checked": TEST_RUN_CARRIED, "notes": [TEST_RUN_CARRIED]}
    print(f"brg-autopilot: test_run {TEST_RUN_CARRIED}", file=sys.stderr)


def save(d, st):
    os.makedirs(os.path.dirname(state_path(d)), exist_ok=True)
    with open(state_path(d), "w") as f:
        json.dump(st, f, indent=1)
        f.write("\n")


def slug(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:40] or "run"


def read(d, rel):
    """A file's text; bytes that are not UTF-8 (an audio fixture beside the tests) are dropped."""
    try:
        return open(os.path.join(d, rel), encoding="utf-8", errors="ignore").read()
    except OSError:
        return ""


# The Claude Code sandbox holds empty placeholders for protected paths in
# whichever directory a command runs (the root, or a subdirectory such as web/);
# they are not work, and neither is this run's own report folder before the
# mr stage commits it. Emptiness is the test: a real one of these has content.
PLACEHOLDERS = {".vscode", ".idea", ".mcp.json", ".gitmodules", ".githooks", ".ripgreprc", ".bashrc",
                ".bash_profile", ".zshrc", ".zprofile", ".profile", ".gitconfig", ".claude"}
# ...and these inside a .claude directory
CLAUDE_PLACEHOLDERS = {"agents", "commands", "hooks", "launch.json", "loop.md", "output-styles", "routines",
                       "scheduled_tasks.json", "skills", "workflows", "agent-memory", ".cc-writes"}


def holds_nothing(p):
    if os.path.isfile(p):
        return os.path.getsize(p) == 0
    if os.path.isdir(p):
        return all(os.path.getsize(os.path.join(r, f)) == 0 for r, _, fs in os.walk(p) for f in fs)
    return False


def not_work(d, rel):
    rel = rel.rstrip("/")
    if rel == "docs/autopilot" or rel.startswith("docs/autopilot/"):
        return True
    parts = rel.split("/")
    named = parts[-1] in PLACEHOLDERS or (parts[-1] in CLAUDE_PLACEHOLDERS and ".claude" in parts[:-1])
    return named and holds_nothing(os.path.join(d, rel))


def changed_since_check(d, target="check"):
    """Files changed (tracked or new) that are newer than the last passing make <target>."""
    marker = os.path.join(d, ".bearing", "state", f".{target}-passed")
    out = porcelain(d)
    files = [l[3:].split(" -> ")[-1].strip('"') for l in out.splitlines() if l.strip()]
    files = [f for f in files if not not_work(d, f)]
    if not os.path.isfile(marker):
        return files or [f"(make {target} has never passed)"]
    m = os.path.getmtime(marker)
    return [f for f in files if os.path.exists(os.path.join(d, f)) and os.path.getmtime(os.path.join(d, f)) > m]


def base_ref(d):
    for b in TRUNKS:
        if git(d, "rev-parse", "-q", "--verify", b):
            return b
    return ""


# --- the gates: each returns (ok, what was checked or what is missing)
def g_repo(d, st):
    if not os.path.isdir(os.path.join(d, ".git")):
        return False, "not a git repository"
    mk = read(d, "Makefile")
    if not re.search(r"^check\s*:", mk, re.M):
        return False, "no Makefile check target"
    if "check-passed" not in mk:
        return False, ("make check does not record a pass; add one last recipe line to check: "
                       "@mkdir -p .bearing/state && touch .bearing/state/.check-passed")
    return True, "git repository; make check records a pass"


def g_prd(d, st):
    parts = os.path.join(d, "docs/product/prd")
    text = read(d, "docs/product/PRD.md") + "".join(
        read(d, f"docs/product/prd/{n}") for n in (sorted(os.listdir(parts)) if os.path.isdir(parts) else [])
        if n.endswith(".md"))
    n = len(set(re.findall(r"\bREQ-\d{3}\b", text)))
    k = len([x for x in os.listdir(parts) if x.endswith(".md")]) if os.path.isdir(parts) else 0
    return (n > 0, f"docs/product/PRD.md{f' and {k} parts' if k else ''}: {n} REQ statements")


def g_stories(d, st):
    # story ids only: US-01-001, not an acceptance criterion's AC-US-01-001-2
    n = len(set(re.findall(r"(?<![\w-])US-\d+-\d+(?![\w-])", read(d, "docs/product/backlog.md"))))
    cov = os.path.isfile(os.path.join(d, "docs/product/coverage.md"))
    return (n > 0 and cov, f"backlog: {n} stories; coverage.md: {'present' if cov else 'missing'}")


def g_decide(d, st):
    started = st["started_epoch"]
    accepted = []
    for p in glob.glob(os.path.join(d, "docs", "**", "*.md"), recursive=True):
        if "/adr/" not in p.replace(os.sep, "/") and "/decisions/" not in p.replace(os.sep, "/"):
            continue
        if os.path.getmtime(p) < started:
            continue
        if re.search(r"^\s*(\*\*)?status(\*\*)?\s*:?\s*(\*\*)?\s*accepted", read(d, os.path.relpath(p, d)), re.I | re.M):
            accepted.append(os.path.relpath(p, d))
    n = len(st["decisions"])
    if accepted:
        return False, f"ADRs written this run say Accepted (the user decided nothing): {', '.join(accepted)}"
    if n == 0 and not st.get("no_open_decisions"):
        return False, "0 decisions in the digest; record each with brg-autopilot decision, or none-open with a reason"
    if not st.get("profile"):
        return False, ("no product profile: record it with brg-autopilot profile --ui yes|no --data yes|no "
                       "--api yes|no --deploy yes|no --why \"<reason>\"; later gates require what it names")
    return True, f"{n} decisions in the digest, none recorded as Accepted; profile: {profile_text(st)}"


KIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROFILE_KEYS = ("ui", "data", "api", "deploy")
MERMAID = re.compile(r"^```mermaid\s*$", re.M)


DEFAULT_UI_STACK = "react-shadcn"


def profile_text(st):
    pr = st.get("profile") or {}
    return (" ".join(f"{k}={pr.get(k, '?')}" for k in PROFILE_KEYS) + f" llm={pr.get('llm', 'no')}"
            + f" ui_stack={ui_stack(st)}" + f" scope={scope(st)}")


def ui_stack(st):
    """React with shadcn/ui and Tailwind unless the run chose another stack."""
    return (st.get("profile") or {}).get("ui_stack") or DEFAULT_UI_STACK


def wants(st, key):
    return (st.get("profile") or {}).get(key) == "yes"


def scope(st):
    """How much document the run owes. lean: a change to a repository that
    already had code when the run started, or a new product with no UI,
    data, API or deployment (a CLI, a library); full otherwise, or when the
    profile says so. A 12-line search command once came with 25 documents
    (C4 set, tenets, HLD, test plan) and a reviewer had to wade through 1,145
    lines to find it."""
    pr = st.get("profile") or {}
    if pr.get("scope") in ("lean", "full"):
        return pr["scope"]
    if st.get("existing"):
        return "lean"
    if pr and not any(wants(st, k) for k in PROFILE_KEYS):
        return "lean"
    return "full"


def scope_why(st):
    pr = st.get("profile") or {}
    if pr.get("scope") in ("lean", "full"):
        return "set in the profile"
    if st.get("existing"):
        return "a change to an existing repository"
    return "no ui, data, api or deploy"


def diagrams(d, rel):
    return len(MERMAID.findall(read(d, rel)))


def checker(d, script, *args):
    """Run a skill's own checker script; (passed, its last non-empty line)."""
    r = sh(["python3", os.path.join(KIT, "skills", script), *args], d)
    lines = [l_ for l_ in (r.stdout + r.stderr).splitlines() if l_.strip()]
    return r.returncode == 0, (lines[-1].strip() if lines else f"{script}: no output")


# openapi-spec writes YAML; api_doc.py reads it with PyYAML, which a plain
# python3 rarely has. Run it as openapi-spec does, through uv with the pinned
# PyYAML (pinned-packs.txt); --no-project keeps uv from syncing the product's
# own pyproject.toml.
YAML_PYTHON = "uv run --quiet --no-project --with pyyaml==6.0.3 python".split()


def api_needs(d, spec, needs):
    """api_doc.py needs over the screens' data needs; (passed, the first
    problem and the counts line). Without uv it falls back to python3, and a
    YAML spec there fails naming the missing dependency."""
    interp = YAML_PYTHON if shutil.which("uv") else ["python3"]
    r = sh([*interp, os.path.join(KIT, "skills", "openapi-spec/scripts/api_doc.py"), "needs",
            "--spec", spec, "--needs", *needs], d)
    out = r.stdout + r.stderr
    if r.returncode != 0 and "PyYAML is not installed" in out:
        return False, (f"{os.path.relpath(spec, d)} is YAML and neither uv nor PyYAML is installed "
                       "(install uv, or PyYAML 6.0.3 for python3)")
    lines = [l_.strip() for l_ in out.splitlines() if l_.strip()]
    last = lines[-1] if lines else "api_doc.py needs: no output"
    first = next((l_ for l_ in lines if l_.startswith("problem:")), "")
    return r.returncode == 0, (f"{first}; {last}" if first and r.returncode != 0 else last)


def rels(d, pattern):
    return sorted(os.path.relpath(p, d) for p in glob.glob(os.path.join(d, pattern), recursive=True))


def g_architecture(d, st):
    if scope(st) == "lean":
        return True, f"scope lean ({scope_why(st)}): no C4 set; the existing shape stands"
    files = rels(d, "docs/architecture/*-c4.md")
    if not files:
        return False, "no docs/architecture/*-c4.md (architecture-diagram)"
    n = sum(diagrams(d, f) for f in files)
    if n == 0:
        return False, f"{len(files)} C4 file(s) but 0 mermaid diagrams"
    model = os.path.join(d, "docs/architecture/architecture.json")
    if not os.path.isfile(model):
        return False, "no docs/architecture/architecture.json (architecture-diagram step 9)"
    ok, last = checker(d, "architecture-diagram/scripts/diagram_check.py",
                       "--model", model, "--dir", os.path.join(d, "docs/architecture/diagrams"))
    if not ok:
        return False, f"diagram_check failed: {last}"
    return True, f"{len(files)} C4 file(s), {n} mermaid diagram(s); {last}"


def g_design(d, st):
    if scope(st) == "lean":
        notes = [f for f in rels(d, "docs/design/*.md")
                 if os.path.getmtime(os.path.join(d, f)) >= st["started_epoch"]
                 and len(read(d, f).strip()) >= 200]
        if not notes:
            return False, ("scope lean: no design note written this run (one docs/design/<name>.md: what "
                           "changes, where, the rules it follows, what it leaves alone)")
        return True, f"scope lean ({scope_why(st)}): design note {', '.join(notes)}"
    h = rels(d, "docs/design/*-hld.md")
    missing = [] if h else ["docs/design/*-hld.md (high-level-design)"]
    if wants(st, "deploy") and not os.path.isfile(os.path.join(d, "docs/architecture/deployment.md")):
        missing.append("docs/architecture/deployment.md (deployment-architecture)")
    if missing:
        return False, "missing: " + ", ".join(missing)
    ok, last = checker(d, "high-level-design/scripts/arch_check.py", *[os.path.join(d, x) for x in h],
                       "--arch", os.path.join(d, "docs/architecture"), "--adr-dir", os.path.join(d, "docs/adr"))
    if not ok:
        return False, f"arch_check failed: {last}"
    if wants(st, "llm") and not rels(d, "docs/genai/*-solution.md"):
        return False, "missing: docs/genai/*-solution.md (genai-design: the profile says the product calls a model)"
    parts = [f"HLD {len(h)}"]
    if wants(st, "llm"):
        parts.append("GenAI solution")
    if wants(st, "deploy"):
        n = diagrams(d, "docs/architecture/deployment.md")
        if n == 0:
            return False, "docs/architecture/deployment.md has no mermaid diagram"
        parts.append(f"deployment with {n} diagram(s)")
    return True, ", ".join(parts) + ("" if wants(st, "deploy") else "; profile: deploy=no")


SCREEN_ROW = re.compile(r"^\|\s*S-\d+\s*\|", re.M)


def screened_features(d):
    """Feature folders under docs/design/flows whose newest flows file lists
    at least one screen (an S-nn row)."""
    return [os.path.basename(os.path.dirname(f)) for f in newest_flows(rels(d, "docs/design/flows/*/flows*.md"))
            if SCREEN_ROW.search(read(d, f))]


def g_contract(d, st):
    """The data model, the API contract and the threat model, after the
    screens: each screen's data-needs.md says what it shows and what it asks
    the server to do, and the contract answers exactly that."""
    if scope(st) == "lean":
        return True, f"scope lean ({scope_why(st)}): the design note covers the contract"
    need = [("data", "docs/design/data-model.md", "data-model"), ("api", "api/openapi.yaml", "openapi-spec")]
    missing = [f"{rel} ({skill})" for key, rel, skill in need
               if wants(st, key) and not os.path.isfile(os.path.join(d, rel))]
    if missing:
        return False, "missing: " + ", ".join(missing)
    threats = rels(d, "docs/security/threat-model-*.md")
    if not threats:
        return False, "missing: docs/security/threat-model-*.md (threat-model: it needs the data model and API)"
    for t in threats:
        ok, last = checker(d, "threat-model/scripts/threats_check.py", os.path.join(d, t))
        if not ok:
            return False, f"threats_check failed for {t}: {last}"
    needs = rels(d, "docs/design/screens/*/data-needs.md")
    # the data model and the API both derive from the screens: a UI product
    # with either owes every screened feature's data-needs.md
    if wants(st, "ui") and (wants(st, "data") or wants(st, "api")):
        if not needs:
            return False, ("no docs/design/screens/*/data-needs.md (screen-design: the API and data model "
                           "derive from the screens' data needs)")
        lacking = [f for f in screened_features(d)
                   if not os.path.isfile(os.path.join(d, f"docs/design/screens/{f}/data-needs.md"))]
        if lacking:
            return False, ("features with screens but no data needs: "
                           + ", ".join(f"{f} (docs/design/screens/{f}/data-needs.md, screen-design)" for f in lacking))
    if wants(st, "data"):
        ok, last = checker(d, "data-model/scripts/model_check.py", "--dir", os.path.join(d, "docs/design"),
                           *(["--needs", *[os.path.join(d, n) for n in needs]] if needs else []))
        if not ok:
            return False, f"model_check failed: {last}"
    if wants(st, "ui"):
        for n in needs:
            feature = os.path.basename(os.path.dirname(n))
            fl = feature_flows(d, feature)
            if not fl:
                return False, f"no docs/design/flows/{feature}/flows*.md for {n} (ux-flows)"
            ok, last = checker(d, "screen-design/scripts/states_check.py", "--needs", os.path.join(d, n),
                               "--flows", os.path.join(d, fl))
            if not ok:
                return False, f"data needs check failed for {n}: {last}"
    needs_line = ""
    if wants(st, "api") and needs:
        ok, needs_line = api_needs(d, os.path.join(d, "api/openapi.yaml"), [os.path.join(d, n) for n in needs])
        if not ok:
            return False, f"needs check failed: {needs_line}"
    parts = [label for key, label in (("data", "data model"), ("api", "API contract")) if wants(st, key)]
    parts.append(f"threat models {len(threats)}")
    off = [f"{k}=no" for k in ("data", "api") if not wants(st, k)]
    return True, (", ".join(parts) + (f"; {needs_line}" if needs_line else "")
                  + (f"; profile: {' '.join(off)}" if off else ""))


PLAN = "docs/architecture/repo-plan.json"


def same_repo(name, d):
    """ShopApi names the run's own repository when it lives in shop-api, ShopApi
    or shop_api: the repository the run's documents are in is not created again."""
    def norm(x):
        return re.sub(r"[^a-z0-9]", "", x.lower())
    return norm(name) == norm(os.path.basename(d))


def plan_entries(d):
    """The repo plan's entries as (name, stack, local path), or (None, why)."""
    p = os.path.join(d, PLAN)
    if not os.path.isfile(p):
        return None, f"no {PLAN} (high-level-design)"
    try:
        repos = json.load(open(p)).get("repos") or []
    except (OSError, ValueError, AttributeError) as e:
        return None, f"{PLAN} does not parse: {e}"
    parent = os.path.dirname(d)

    def where(r):
        # "path" places an entry explicitly, relative to this repository: "."
        # when the code lives beside the documents in the repository the run
        # is in, whatever the entry's PascalCase name.
        if r.get("path"):
            return os.path.normpath(os.path.join(d, r["path"]))
        return d if same_repo(r.get("name", ""), d) else os.path.join(parent, r.get("name", ""))
    return [(r.get("name", ""), r.get("stack", ""), where(r)) for r in repos], ""


def repo_problem(path):
    """Why the scaffolded repository at path is not ready, or ""."""
    if not os.path.isdir(path):
        return "missing"
    ok, what = g_repo(path, {})
    if not ok:
        return what
    if not os.path.isfile(os.path.join(path, ".bearing", "state", ".check-passed")):
        return "make check has never passed"
    return ""


def repos_n(n):
    return f"{n} repo{'' if n == 1 else 's'}"


def missing_repos(d, entries):
    return [(n, s, p) for n, s, p in entries if p != d and repo_problem(p) == "missing"]


def g_repos(d, st):
    if scope(st) == "lean":
        return True, f"scope lean ({scope_why(st)}): no repo plan; this repository is the only one"
    entries, why = plan_entries(d)
    if entries is None:
        return False, why
    if not entries:
        return False, f"{PLAN}: 0 repos"
    st["repos"] = [{"name": n, "stack": s, "path": "this repository" if p == d else p} for n, s, p in entries]
    home = [n for n, _, p in entries if p == d]
    beside = [(n, s, p) for n, s, p in entries if p != d]
    bad = [(n, s, p, repo_problem(p)) for n, s, p in beside]
    bad = [b for b in bad if b[3]]
    head = f"{repos_n(len(entries))} in the plan"
    if bad:
        hints = [f"new-repo {s} {n} --dir {p}" for n, s, p, why in bad if why == "missing"]
        return False, (head + "; " + "; ".join(f"{n}: {why}" for n, _, _, why in bad)
                       + (f" (run {', '.join(hints)}; headless: brg-autopilot repos-request)" if hints else ""))
    parts = [f"{', '.join(home)} is this repository"] if home else []
    if beside:
        parts.append(f"{', '.join(n for n, _, _ in beside)} scaffolded beside it, make check passed in each")
    return True, head + ": " + "; ".join(parts)


def g_ux(d, st):
    if not wants(st, "ui"):
        return True, "no UI in the profile"
    if scope(st) == "lean":
        return True, "scope lean: the existing screens and design system are the precedent"
    flows = rels(d, "docs/design/flows/*/flows*.md")
    if not flows:
        return False, "no docs/design/flows/*/flows*.md (ux-flows)"
    ok, last = checker(d, "ux-flows/scripts/flows_check.py")
    if not ok:
        return False, f"flows_check failed: {last}"
    if not os.path.isfile(os.path.join(d, "docs/design/tokens.json")):
        return False, "no docs/design/tokens.json (design-system)"
    ok, last = checker(d, "design-system/scripts/contrast.py", "--tokens", os.path.join(d, "docs/design/tokens.json"))
    if not ok:
        return False, f"contrast failed: {last}"
    if ui_stack(st) == DEFAULT_UI_STACK:
        return ux_screens_as_code(d, flows)
    features = sorted({os.path.dirname(f) for f in rels(d, "docs/design/screens/*/*.html")})
    if not features:
        return False, "no docs/design/screens/<feature>/*.html (screen-design)"
    for feat in features:
        name = os.path.basename(feat)
        fl = feature_flows(d, name)
        args = ["--screens", os.path.join(d, feat)] + (["--flows", os.path.join(d, fl)] if fl else [])
        ok, last = checker(d, "screen-design/scripts/states_check.py", *args)
        if not ok:
            return False, f"states_check failed for {feat}: {last}"
    ok, last = checker(d, "screen-design/scripts/bundle.py", "check",
                       "--design", os.path.join(d, "docs/design"), "--flows-root", os.path.join(d, "docs/design/flows"))
    if not ok:
        return False, f"bundle check failed: {last}"
    return True, (f"flows: {len(flows)} file(s) passed; tokens: contrast passed; "
                  f"screens: {len(features)} feature(s) passed; {last}")


FLOWS_FILE = re.compile(r"^flows(?:-v(\d+))?\.md$")


def flows_version(path):
    """flows.md is version 1, flows-v<n>.md version n; any other name is None.
    ux-flows writes flows-v<n+1>.md beside the old file, and a text sort put
    flows.md after flows-v2.md and flows-v2.md after flows-v10.md."""
    m = FLOWS_FILE.match(os.path.basename(path))
    return (int(m.group(1)) if m.group(1) else 1) if m else None


def newest_flows(flows):
    """The newest flows file per feature folder, by version number
    (flows-v10.md over flows-v2.md over flows.md); flows-notes.md is not one."""
    by_feature = {}
    for f in flows:
        if flows_version(f) is not None:
            by_feature.setdefault(os.path.dirname(f), []).append(f)
    return [max(v, key=flows_version) for _, v in sorted(by_feature.items())]


def feature_flows(d, feature):
    """The newest flows file of one feature folder, or ""."""
    fl = newest_flows(rels(d, f"docs/design/flows/{feature}/flows*.md"))
    return fl[0] if fl else ""


def ux_screens_as_code(d, flows):
    """The react-shadcn design pipeline: a chosen direction, a motion spec,
    every screen as a *.screen.tsx in the design gallery with every state, and
    design-lint over the app. Screens drawn as HTML beside the app drifted
    from it; screens as code cannot. The direction comes from impeccable's one
    round (source impeccable: a pick over at least one challenger) or from
    Bearing's own variants (source bearing or absent: the highest of 3 scored)."""
    approved = rels(d, "docs/design/variants/*/approved.json")
    if not approved:
        return False, "no chosen design direction: docs/design/variants/*/approved.json (design-directions)"
    try:
        rec = json.load(open(os.path.join(d, approved[-1])))
    except (OSError, ValueError) as e:
        return False, f"{approved[-1]} does not parse: {e}"
    chosen = rec.get("chosen") or ""
    if rec.get("source") == "impeccable":
        rivals = rec.get("challengers")
        if not chosen:
            return False, f"{approved[-1]}: no direction picked yet (impeccable round; chosen is empty)"
        if rivals is None:
            rivals = []
        if not isinstance(rivals, list) or not all(isinstance(c, str) and c.strip() for c in rivals):
            return False, f"{approved[-1]}: challengers must be a list of direction names, got {json.dumps(rivals)}"
        if chosen in rivals:
            return False, f"{approved[-1]}: {chosen} is both chosen and a challenger"
        if not rivals:
            return False, f"{approved[-1]}: {chosen} picked over no challenger; an impeccable pick names its challengers"
        picked = f"direction: {chosen}, an impeccable pick over {len(rivals)} challenger(s)"
    else:
        scores = rec.get("scores") or rec.get("ratings") or {}
        if len(scores) < 3:
            return False, f"{approved[-1]}: {len(scores)} scored variants; a direction is chosen from 3"
        if chosen not in scores:
            return False, f"{approved[-1]}: chosen {chosen or 'nothing'} is not one of the scored variants"
        picked = f"direction: {chosen} of {len(scores)} scored variants"
    if not os.path.isfile(os.path.join(d, "docs/design/motion.md")):
        return False, "no docs/design/motion.md (motion-design)"
    src = next((s_ for s_ in ("src", "web/src") if os.path.isfile(os.path.join(d, s_, "design", "screen.ts"))), "")
    if not src:
        return False, "no design gallery: src/design/screen.ts or web/src/design/screen.ts (react-web template)"
    ok, last = checker(d, "screen-design/scripts/gallery_check.py", "--src", src, "--flows", *newest_flows(flows))
    if not ok:
        return False, f"gallery_check failed: {last}"
    gallery = last
    if not os.path.isfile(os.path.join(d, "scripts", "design-lint.sh")):
        return False, "no scripts/design-lint.sh (design-system)"
    # the repository's own target (its roots and allowances) when it has one
    has_target = re.search(r"^design-lint\s*:", read(d, "Makefile"), re.M)
    r = sh(["make", "-s", "design-lint"] if has_target else ["bash", "scripts/design-lint.sh"], d)
    lines = [l_ for l_ in (r.stdout + r.stderr).splitlines() if l_.startswith("design-lint:")]
    if r.returncode != 0:
        return False, f"design-lint failed: {lines[-2] if len(lines) > 1 else (lines[-1] if lines else 'no output')}"
    return True, (f"flows: {len(flows)} file(s) passed; tokens: contrast passed; "
                  f"{picked}; motion spec; {gallery}; design-lint passed")


CASES = "docs/testing/test-cases.md"
TC_ROW = re.compile(r"^\|\s*(TC-\d+)\s*\|(.*)$", re.M)


def g_lld(d, st):
    """One low-level design per component this run builds, written after the
    screens so a front-end component's design can name them."""
    if scope(st) == "lean":
        return True, f"scope lean ({scope_why(st)}): the design note is the low-level design"
    l_ = [f for f in rels(d, "docs/design/*-lld.md")
          if os.path.getmtime(os.path.join(d, f)) >= st["started_epoch"] and len(read(d, f).strip()) >= 200]
    if not l_:
        return False, "no docs/design/*-lld.md written this run (low-level-design, one per component it builds)"
    return True, f"LLD {len(l_)}: {', '.join(l_)}"


def g_test_cases(d, st):
    if not os.path.isfile(os.path.join(d, CASES)):
        return False, f"no {CASES} (test-cases)"
    ok, last = checker(d, "test-cases/scripts/cases_check.py",
                       "--backlog", os.path.join(d, "docs/product/backlog.md"), "--cases", os.path.join(d, CASES),
                       "--risks", os.path.join(d, "docs/testing/risks.md"),
                       "--threats", os.path.join(d, "docs/security/threat-model-*.md"))
    return (True, last) if ok else (False, f"cases_check failed: {last}")


TEST_FILE = re.compile(r"(^|/)(test_[^/]*|[^/]*(_test|\.test|\.spec|Test|Tests)\.[a-z]+)$|(^|/)(tests?|e2e|__tests__|androidTest|UITests)/")


def tc_named(tc, text):
    """TC-0012 named in a test file: as TC-0012, or as tc_0012 in a test name such as
    test_tc_0012_rejects_blank. The id must not run on into more digits (TC-00120 is
    another case), but a word character after it is the rest of the test name: a \\b
    there missed test-automation's own naming, where _ follows the id."""
    snake = tc.lower().replace("-", "_")
    return bool(re.search(r"(?:" + re.escape(tc) + "|" + re.escape(snake) + r")(?!\d)", text, re.I))


def g_test_automation(d, st):
    rows = TC_ROW.findall(read(d, CASES))
    if not rows:
        return False, f"0 cases in {CASES}; test-cases writes them"
    skip = {tc for tc, rest in rows if re.search(r"\b(manual-only|retired)\b", rest)}
    auto = sorted({tc for tc, _ in rows} - skip)
    tests = [f for f in git(d, "ls-files", "-co", "--exclude-standard").splitlines()
             if TEST_FILE.search(f) and "node_modules/" not in f]
    text = "\n".join(read(d, f) for f in tests)
    named = {tc for tc in auto if tc_named(tc, text)}
    unnamed = [tc for tc in auto if tc not in named]
    if unnamed:
        return False, (f"{len(unnamed)} automatable case(s) with no test naming them: {', '.join(unnamed[:8])}"
                       f"{' ...' if len(unnamed) > 8 else ''} (test-automation)")
    if wants(st, "llm"):
        gone = [f"{rel} ({skill})" for rel, skill in (("guardrails/policy.yaml", "llm-guardrails"),
                                                       ("docs/genai/evals.md", "llm-eval"))
                if not os.path.isfile(os.path.join(d, rel))]
        if gone:
            return False, "profile llm: missing " + ", ".join(gone)
    stale = changed_since_check(d)
    if stale:
        return False, f"make check has not passed since: {', '.join(stale[:5])}"
    return True, (f"{len(named)} of {len(auto)} automatable case(s) named by a test ({len(skip)} manual-only or "
                  f"retired)" + ("; guardrails policy and evals report present" if wants(st, "llm") else ""))


REVIEW_OVERALL = 8.0
REVIEW_CATEGORY = 7
SCORE_ROW = re.compile(r"^\|\s*([a-z][a-z /-]*?)\s*\|\s*(n/a[^|]*|\d+(?:\.\d+)?)\s*\|\s*\d+%", re.M)
EVIDENCE = re.compile(r"(\d+) of (\d+) screenshots present.*?(\d+) of (\d+) dark shots differ from light, (\d+) problems")


def g_design_review(d, st):
    """The design bar, measured: an overall score of 8.0, no category below 7,
    and screenshots at 375, 768 and 1440 in light and dark for every page.
    A review that exists but scores low is a design that is not done."""
    if not wants(st, "ui"):
        return True, "no UI in the profile"
    files = rels(d, "docs/design/reviews/*-review.md")
    if not files:
        return False, "no docs/design/reviews/*-review.md (design-critique)"
    notes = []
    for rel in files:
        text = read(d, rel)
        overall = re.findall(r"^Overall:\s*(\d+(?:\.\d+)?)", text, re.M)
        if not overall:
            return False, f"{rel}: no 'Overall: <score>' line"
        o = float(overall[-1])
        if o < REVIEW_OVERALL:
            return False, f"{rel}: overall {o} is below {REVIEW_OVERALL}"
        rows = SCORE_ROW.findall(text)
        scored = [(c.strip(), float(v)) for c, v in rows if not v.startswith("n/a")]
        na = len(rows) - len(scored)
        if not scored:
            return False, f"{rel}: no scored category rows"
        low = [f"{c} scored {v:g}" for c, v in scored if v < REVIEW_CATEGORY]
        if low:
            return False, f"{rel}: {', '.join(low)}, below {REVIEW_CATEGORY}"
        ev = EVIDENCE.findall(text)
        if not ev:
            return False, f"{rel}: no evidence line from evidence.py check"
        have, want, dark, dark_want, probs = (int(x) for x in ev[-1])
        if want == 0 or have < want or dark < dark_want or probs:
            return False, (f"{rel}: evidence incomplete: {have} of {want} screenshots, "
                           f"{dark} of {dark_want} dark shots differ, {probs} problems")
        notes.append(f"overall {o:g}; {len(scored)} categories scored, none below {REVIEW_CATEGORY}, {na} n/a; "
                     f"{have} of {want} screenshots, {dark} of {dark_want} dark shots differ")
    return True, "; ".join(notes) + (f" ({len(files)} reviews)" if len(files) > 1 else "")


def g_branch(d, st):
    b = git(d, "branch", "--show-current")
    ok = bool(b) and b not in TRUNKS
    if ok:
        st["branch"] = b
    return ok, f"branch: {b or 'detached'}"


def g_build(d, st):
    base = base_ref(d)
    diff = git(d, "diff", "--name-only", f"{base}...HEAD") if base else ""
    wt = porcelain(d)
    names = set(diff.splitlines()) | {l[3:] for l in wt.splitlines()}
    tests = [f for f in names if re.search(r"(^|/)(test_[^/]*|[^/]*(_test|\.test|\.spec|Test)\.[a-z]+)$|(^|/)tests?/", f)]
    stale = changed_since_check(d)
    if not tests:
        return False, "no test file added or changed on the branch"
    if stale:
        return False, f"make check has not passed since {len(stale)} change(s): {', '.join(stale[:5])}"
    # A production build fails on what make check never runs (a Next.js page
    # that cannot prerender). A Makefile whose build records a pass owes one.
    if "build-passed" not in read(d, "Makefile"):
        return True, (f"{len(tests)} test file(s) on the branch; make check passed after the last change; "
                      "make build: not recorded by this Makefile")
    unbuilt = changed_since_check(d, "build")
    if unbuilt == ["(make build has never passed)"]:
        return False, "make build has never passed"
    if unbuilt:
        return False, f"make build has not passed since {len(unbuilt)} change(s): {', '.join(unbuilt[:5])}"
    return True, (f"{len(tests)} test file(s) on the branch; make check and make build passed "
                  "after the last change")


# test-run's evidence (skills/test-run/references/runners.md): one file per
# scope, named from the branch, overwritten by each run; a run that stops
# before any suite writes none, so a reader compares sha and scope itself.
EVIDENCE_KEYS = ("scope", "sha", "dirty", "suites", "tests", "failed", "not_run", "selection")
UNIT_ONLY = "no suite beyond unit"


def evidence(d, scope):
    """The parsed .scratch/test-run/<branch>-<scope>.json, or None and why."""
    b = git(d, "branch", "--show-current")
    if not b:
        return None, "detached HEAD: no branch name for the evidence file"
    rel = f".scratch/test-run/{b.replace('/', '_')}-{scope}.json"
    p = os.path.join(d, rel)
    if not os.path.isfile(p):
        return None, f"no file {rel}"
    try:
        with open(p, encoding="utf-8") as f:
            ev = json.load(f)
    except json.JSONDecodeError as e:
        return None, f"{rel}: not valid JSON ({e.msg} at line {e.lineno}); run test-run again"
    except (OSError, UnicodeDecodeError) as e:
        return None, f"{rel}: unreadable ({e})"
    if not isinstance(ev, dict):
        return None, f"{rel}: not a JSON object"
    for k in EVIDENCE_KEYS:
        if k not in ev:
            return None, f"{rel}: no \"{k}\" key"
    if not isinstance(ev["suites"], list) or not all(isinstance(s, dict) for s in ev["suites"]):
        return None, f"{rel}: \"suites\" is not a list of suites"
    if not isinstance(ev["not_run"], list):
        return None, f"{rel}: \"not_run\" is not a list"
    for k in ("tests", "failed"):
        if not isinstance(ev[k], int) or isinstance(ev[k], bool):
            return None, f"{rel}: \"{k}\" is not a number"
    if ev["scope"] != scope:
        return None, f"{rel}: scope is {ev['scope']!r}, not {scope!r}"
    ev["_rel"] = rel
    return ev, rel


def filtered(ev, allow_except_unit=False):
    """Why the run was filtered (its --suite, --tag, --tc or --except values),
    or "" for an unfiltered run: selection null, or {"except": ["unit"]} when
    the reader is definition-of-done item 14's full run."""
    sel = ev.get("selection")
    if sel is None or (allow_except_unit and sel == {"except": ["unit"]}):
        return ""
    if not isinstance(sel, dict) or not sel:
        return repr(sel)
    return "; ".join(f"{k} {' '.join(map(str, v)) if isinstance(v, list) else v}" for k, v in sel.items())


def not_run_split(st, ev):
    """The suites the run did not run (its not_run list and any suite marked
    "not run"), split into those a test_run.<suite> decision left to CI (its
    choice starts "left to CI") and those with none."""
    decided = {x.get("key") for x in st.get("decisions") or []
               if str(x.get("choice") or "").startswith("left to CI")}
    names = list(ev.get("not_run") or [])
    names += [s.get("name") for s in ev["suites"] if s.get("status") == "not run" and s.get("name") not in names]
    return ([n for n in names if f"test_run.{n}" in decided],
            [n for n in names if f"test_run.{n}" not in decided])


def not_run_undecided(st, ev):
    """Suites the run did not run with no test_run.<suite> decision leaving them to CI."""
    return not_run_split(st, ev)[1]


def left_to_ci(st, ev):
    return not_run_split(st, ev)[0]


def same_run(d, ev, what):
    """The run is of HEAD on a committed tree, or why not."""
    head = git(d, "rev-parse", "HEAD")
    if ev["sha"] != head:
        return f"the {what} is on {str(ev['sha'])[:7]}, HEAD is {head[:7]}: run test-run again"
    if ev["dirty"]:
        return f"the {what} was on an uncommitted tree: commit, then run again"
    return ""


def undecided_msg(names):
    return (f"not run with no decision: {', '.join(names)} (only when a CI job runs it: "
            f"brg-autopilot decision test_run.<suite> \"left to CI job <job>\" ...)")


def committed_since(d, target="check"):
    """Files the branch changed (merge base with the default branch to HEAD)
    whose mtime is after the last passing make <target>: a commit made after
    the check passed. Every file when the marker is missing."""
    base = base_ref(d)
    mb = git(d, "merge-base", base, "HEAD") if base else ""
    if not mb:
        return []
    files = [f for f in git(d, "diff", "--name-only", mb, "HEAD").splitlines()
             if f and os.path.exists(os.path.join(d, f)) and not not_work(d, f)]
    marker = os.path.join(d, ".bearing", "state", f".{target}-passed")
    if not os.path.isfile(marker):
        return files
    m = os.path.getmtime(marker)
    return [f for f in files if os.path.getmtime(os.path.join(d, f)) > m]


def g_test_run(d, st):
    """test-run --changed on HEAD: at least one suite ran or was covered by a
    make check that still holds, nothing failed, and every suite not run is
    left to CI by a recorded decision. A documentation-only diff passes on the
    file count test-run recorded, never on an empty one."""
    ev, why = evidence(d, "changed")
    if ev is None and why.startswith("no file "):
        ev, why_full = evidence(d, "full")
        if ev is None and why_full.startswith("no file "):
            return False, f"no test-run evidence ({why[len('no file '):]}; test-run --changed)"
        why = why_full
    if ev is None:
        return False, why
    rel = ev["_rel"]
    sel = filtered(ev, allow_except_unit=ev["scope"] == "full")
    if sel:
        return False, f"{rel}: a filtered run ({sel}) is not the run this stage needs; run test-run --changed"
    suites = ev["suites"]
    ran = [s for s in suites if s.get("status") in ("run", "covered")]
    covered = [s for s in ran if s.get("status") == "covered"]
    docs_only = ev["scope"] == "changed" and ev.get("layers") == [] and not suites
    if docs_only:
        n = ev.get("files")
        if not isinstance(n, int) or isinstance(n, bool) or n <= 0:
            return False, f"{rel}: 0 layers and {n if n is not None else 'no'} files: nothing was tested"
    elif not ran:
        return False, f"{rel}: 0 suites ran"
    if ev["failed"] > 0:
        return False, f"{rel}: {ev['failed']} failed"
    other = same_run(d, ev, "run")
    if other:
        return False, other
    if ev["tests"] == 0 and not covered and not docs_only:
        return False, f"{rel}: 0 tests ran in {len(ran)} suite(s)"
    for s in covered:
        target = "check-changed" if "check-changed" in str(s.get("reason") or "") else "check"
        stale = changed_since_check(d, target)
        stale += [f for f in committed_since(d, target) if f not in stale]
        if stale:
            return False, (f"{s.get('name', '?')} covered by make {target}, but make "
                           f"{target} has not passed since: {', '.join(stale[:5])}")
    open_ = not_run_undecided(st, ev)
    if open_:
        return False, f"{rel}: {undecided_msg(open_)}"
    if docs_only:
        return True, f"0 layers touched by {ev['files']} files: nothing to test ({rel})"
    layers = ", ".join(ev.get("layers") or []) or ev["scope"]
    ci = left_to_ci(st, ev)
    return True, (f"{ev['tests']} tests in {len(ran)} suites ({layers}), 0 failed"
                  + (f"; left to CI: {', '.join(ci)}" if ci else ""))


# branch-review's verdict.txt (skills/branch-review/SKILL.md, output contract).
# The range may hold spaces and "...", so the first line anchors on its end.
VERDICT_HEAD = re.compile(r"^review: (.*) @ ([0-9a-f]{7,40}), (\d+) files?\s*$")
VERDICT_LINE = re.compile(r"^Verdict: (ready to merge|ready after ([0-9][0-9 ]*)|not ready to merge)\s*$", re.M)
FINDINGS_LINE = re.compile(r"^findings: (\d+) critical, (\d+) high, (\d+) medium, (\d+) low; verified (\d+): "
                           r"(\d+) confirmed, (\d+) refuted, (\d+) uncertain\s*$", re.M)
BLOCKING_LINE = re.compile(r"^blocking: (none|\d+(?: \d+)*)\s*$", re.M)


def newest_verdict(d):
    """The newest .scratch/review/*/verdict.txt (by mtime, a tie by folder
    name), parsed, or None and why."""
    files = [f for f in glob.glob(os.path.join(d, ".scratch", "review", "*", "verdict.txt")) if os.path.isfile(f)]
    if not files:
        return None, "no .scratch/review/*/verdict.txt (branch-review)"
    p = max(files, key=lambda f: (os.path.getmtime(f), f))
    rel = os.path.relpath(p, d)
    text = open(p, encoding="utf-8", errors="replace").read()
    lines = text.splitlines()
    head = VERDICT_HEAD.match(lines[0]) if lines else None
    if not head:
        return None, f"{rel}: no first line 'review: <range> @ <sha>, <N> files'; run branch-review again"
    v = {"range": head.group(1), "sha": head.group(2), "files": int(head.group(3)),
         "slug": os.path.basename(os.path.dirname(p)), "rel": rel}
    if v["files"] == 0:
        v.update(verdict="", findings=None, blocking=[])
        return v, rel
    verdict = VERDICT_LINE.search(text)
    if not verdict:
        return None, f"{rel}: no 'Verdict:' line"
    findings = FINDINGS_LINE.search(text)
    blocking = BLOCKING_LINE.search(text)
    v["verdict"] = verdict.group(1)
    v["items"] = (verdict.group(2) or "").split()
    v["findings"] = dict(zip(("critical", "high", "medium", "low", "verified", "confirmed", "refuted", "uncertain"),
                             (int(x) for x in findings.groups()))) if findings else None
    v["blocking"] = [] if not blocking or blocking.group(1) == "none" else [int(n) for n in blocking.group(1).split()]
    v["has_blocking"] = bool(blocking)
    return v, rel


def is_ancestor(d, a, b):
    return sh(["git", "merge-base", "--is-ancestor", a, b], d).returncode == 0


def g_review(d, st):
    """The verdict branch-review wrote: a review of more than 0 files, at a
    commit this branch made (an ancestor of HEAD that is not an ancestor of
    the merge base with any default branch, so a leftover verdict from a
    merged branch fails); "not ready to merge" passes only when every blocking
    finding has a fix, a commit after the reviewed one, in fixed.txt."""
    v, why = newest_verdict(d)
    if v is None:
        return False, why
    rel = v["rel"]
    if v["files"] == 0:
        return False, f"{rel}: 0 files reviewed, which is never a pass; review the branch's diff"
    if v["findings"] is None:
        return False, f"{rel}: no findings: line; run branch-review again"
    if not v["has_blocking"]:
        return False, f"{rel}: no blocking: line; run branch-review again"
    reviewed = v["sha"]
    if not is_ancestor(d, reviewed, "HEAD"):
        return False, f"{rel}: the reviewed commit {reviewed[:7]} is not an ancestor of HEAD; review this branch"
    for trunk in TRUNKS:
        if not git(d, "rev-parse", "-q", "--verify", trunk):
            continue
        mb = git(d, "merge-base", trunk, "HEAD")
        if mb and is_ancestor(d, reviewed, mb):
            return False, (f"{rel}: the reviewed commit {reviewed[:7]} is on {trunk}, not on this branch; "
                           f"review this branch")
    fixed = 0
    if v["verdict"] == "not ready to merge":
        if not v["blocking"]:
            return False, f"{rel}: not ready to merge with no blocking finding to fix; read the verdict and review again"
        fx = os.path.join(d, ".scratch", "review", v["slug"], "fixed.txt")
        reviewed_full = git(d, "rev-parse", reviewed)
        fixes = {}
        for line in read(d, os.path.relpath(fx, d)).splitlines():
            m = re.match(r"^\s*(\d+)\s+([0-9a-f]{7,40})\s*$", line)
            if m:
                fixes.setdefault(int(m.group(1)), []).append(m.group(2))
        for n in v["blocking"]:
            ok = False
            for sha in fixes.get(n, []):
                full = git(d, "rev-parse", "-q", "--verify", f"{sha}^{{commit}}")
                if full and full != reviewed_full and is_ancestor(d, reviewed, full) \
                        and is_ancestor(d, full, "HEAD"):
                    ok = True
                    break
            if not ok:
                return False, (f"{rel}: finding {n} has no fix in .scratch/review/{v['slug']}/fixed.txt "
                               f"('{n} <sha>', a commit after {reviewed[:7]} on this branch)")
            fixed += 1
        verdict = v["verdict"]
    elif v["items"]:
        verdict = f"ready after {len(v['items'])} items ({' '.join(v['items'])})"
    else:
        verdict = v["verdict"]
    return True, f"review of {v['files']} files: {verdict}; {v['findings']['confirmed']} confirmed, {fixed} fixed ({rel})"


REPORTS = "docs/testing/reports/"


def full_run(d, st):
    """definition-of-done item 14's full run: every suite beyond unit on HEAD,
    or on a commit that only its report followed."""
    ev, why = evidence(d, "full")
    if ev is None:
        if why.startswith("no file "):
            return False, f"no full test-run evidence ({why[len('no file '):]}; definition-of-done item 14)"
        return False, why
    rel = ev["_rel"]
    sel = filtered(ev, allow_except_unit=True)
    if sel:
        return False, (f"{rel}: a filtered run ({sel}) is not the full run; run test-run --except unit "
                       f"(definition-of-done item 14)")
    exc = ev.get("except")
    if exc not in ([], ["unit"]):
        named = ", ".join(map(str, exc)) if isinstance(exc, list) else repr(exc)
        return False, f"{rel}: except {named}: a full run leaves out only unit"
    suites = ev["suites"]
    unit_only = not suites and exc == ["unit"] and ev.get("n_a") == UNIT_ONLY
    ran = [s for s in suites if s.get("status") in ("run", "covered")]
    if ev["failed"] > 0:
        return False, f"{rel}: {ev['failed']} failed"
    if not suites and not unit_only:
        return False, f"{rel}: 0 suites ran (a unit-only repository has \"n_a\": \"{UNIT_ONLY}\")"
    if ev["dirty"]:
        return False, "the full run was on an uncommitted tree: commit, then run again"
    sha = str(ev["sha"])
    if not git(d, "rev-parse", "-q", "--verify", f"{sha}^{{commit}}"):
        return False, f"the full run is on {sha[:7]}, which is not in this repository: run it again"
    after = [f for f in git(d, "diff", "--name-only", sha, "HEAD").splitlines() if f]
    code = [f for f in after if not f.startswith(REPORTS)]
    if code:
        return False, (f"changed since the full run on {sha[:7]}: {', '.join(code[:5])}"
                       f"{' ...' if len(code) > 5 else ''}; run it again (definition-of-done item 14)")
    open_ = not_run_undecided(st, ev)
    if open_:
        return False, f"{rel}: {undecided_msg(open_)}"
    if suites and not ran and not left_to_ci(st, ev):
        return False, f"{rel}: 0 suites ran"
    if ran and ev["tests"] == 0 and not any(s.get("status") == "covered" for s in ran):
        return False, f"{rel}: 0 tests ran in {len(ran)} suite(s)"
    if unit_only:
        return True, "full run: 0 suites beyond unit (n/a: make check ran unit)"
    ci = left_to_ci(st, ev)
    return True, (f"full run: {len(ran)} suites, {ev['tests']} tests, 0 failed"
                  + (f"; left to CI: {', '.join(ci)}" if ci else ""))


def g_dod(d, st):
    stale = changed_since_check(d)
    dirty = [l for l in porcelain(d).splitlines()
             if l.strip() and not l[3:].startswith(".scratch") and not not_work(d, l[3:].strip('"'))]
    base = base_ref(d)
    ahead = git(d, "rev-list", "--count", f"{base}..HEAD") if base else "0"
    if stale:
        return False, f"make check has not passed since: {', '.join(stale[:5])}"
    if dirty:
        return False, f"{len(dirty)} uncommitted change(s)"
    if not ahead or int(ahead) == 0:
        return False, "no commit on the branch"
    contradictions = profile_contradictions(d, st)
    if contradictions:
        return False, "; ".join(contradictions) + " (run the stages it skipped, or correct the profile)"
    ok, smoke = smoke_evidence(d)
    if not ok:
        return False, smoke
    ok, full = full_run(d, st)
    if not ok:
        return False, full
    return True, f"{ahead} commit(s) on the branch, clean, make check passed after the last change; {smoke}; {full}"


RUN_FILES = re.compile(r"(^|/)((docker-)?compose\.ya?ml|Dockerfile)$")
RUN_TARGET = re.compile(r"^(dev|up)\s*:", re.M)
SMOKE_LINE = re.compile(r"^smoke: (\d+) requests? checked, (\d+) failed\s*$", re.M)


def runnable(d):
    """What the repository ships that a person would start, or an empty list."""
    found = [f for f in git(d, "ls-files").splitlines() if RUN_FILES.search(f) and "node_modules/" not in f]
    for mk in ("Makefile", "GNUmakefile"):
        p = os.path.join(d, mk)
        if os.path.isfile(p) and RUN_TARGET.search(open(p, encoding="utf-8", errors="replace").read()):
            found.append(f"{mk} dev/up target")
    return found


UI_DEPS = re.compile(r'"(react|react-dom|vue|svelte|next|@angular/core|solid-js|preact)"\s*:')
SCHEMA = re.compile(r"(^|/)(migrations?|alembic)/|(^|/)(schema\.prisma|sqlc\.ya?ml|schema\.sql)$")


def profile_contradictions(d, st):
    """A profile that says no to something the code plainly has skipped stages."""
    pr = st.get("profile")
    if not pr:
        return []
    files = [f for f in git(d, "ls-files").splitlines() if "node_modules/" not in f]
    out = []
    if pr.get("ui") == "no":
        ui = [f for f in files if (f.endswith("package.json") and UI_DEPS.search(read(d, f)))
              or f.endswith("AndroidManifest.xml") or f.endswith(".swift")]
        if ui:
            out.append(f"the profile says ui=no, but {ui[0]} is a UI")
    if pr.get("data") == "no":
        db = [f for f in files if SCHEMA.search(f)]
        if db:
            out.append(f"the profile says data=no, but {db[0]} is a schema")
    return out


def smoke_evidence(d):
    """make check proves the tests, not the product: a repository that ships
    something runnable must show definition-of-done's smoke run of it (the app started as
    a user starts it, its main flow driven against the real backend), recorded
    after the last commit with at least one request checked and none failed."""
    ships = runnable(d)
    if not ships:
        return True, "smoke: nothing to run (no compose file, Dockerfile or make dev/up target)"
    files = sorted(glob.glob(os.path.join(d, ".scratch", "smoke-*.md")), key=os.path.getmtime)
    if not files:
        return False, (f"the app was never run: no .scratch/smoke-*.md, but the repository ships "
                       f"{', '.join(ships[:3])} (definition-of-done item 13)")
    newest = files[-1]
    rel = os.path.relpath(newest, d)
    m = SMOKE_LINE.findall(open(newest, encoding="utf-8", errors="replace").read())
    if not m:
        return False, f"{rel} has no 'smoke: N requests checked, F failed' line"
    checked, failed = (int(x) for x in m[-1])
    if checked == 0:
        return False, f"{rel}: smoke checked 0 requests, so it proved nothing"
    if failed:
        return False, f"{rel}: smoke: {failed} of {checked} requests failed"
    head = git(d, "log", "-1", "--format=%ct")
    if head and os.path.getmtime(newest) < int(head):
        return False, f"{rel}: the smoke run is older than the last commit; run it again"
    return True, f"smoke: {checked} requests checked, 0 failed ({rel})"


def upstream_sha(d):
    """The commit the branch's upstream points at, or "" when it has none."""
    if not os.path.isdir(os.path.join(d, ".git")):
        return ""
    r = sh(["git", "rev-parse", "-q", "--verify", "@{upstream}"], d)
    return r.stdout.strip() if r.returncode == 0 else ""


def pushed_by_brg_push(d):
    """The sha .bearing/state/push-result records as pushed by brg-push, or "".
    brg-push writes `pushed <branch> <sha> to <key> <time>` after a push from a
    fresh clone; anything else (a failure, a refusal, no file) gives "". The file
    is agent-writable: a link or a FIFO planted there is not followed or waited on."""
    try:
        fd = os.open(os.path.join(d, ".bearing", "state", "push-result"),
                     os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return ""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return ""
        line = os.read(fd, 512).decode("utf-8", "replace").split("\n", 1)[0]
    except OSError:
        return ""
    finally:
        os.close(fd)
    m = re.match(r"^pushed (\S+) ([0-9a-f]{40}) to \S+ ", line)
    return m.group(2) if m else ""


def g_mr(d, st):
    mr = glob.glob(os.path.join(d, ".scratch", "mr-*.md"))
    rep = f"docs/autopilot/{st['run']}.md"
    committed = bool(git(d, "ls-files", rep))
    upstream = git(d, "rev-parse", "--abbrev-ref", "@{upstream}")
    note = ""
    # The opt-in push (brg-push run, from the Stop hook) is the one push a run may
    # cause. It pushes from a fresh clone, which sets no upstream and leaves the
    # working repository's origin/<branch> where it was, so this branch fires only
    # after a fetch (rare); it accepts the upstream only at HEAD and only when
    # push-result records that very sha.
    has_upstream = bool(upstream) and "fatal" not in upstream
    pushed = pushed_by_brg_push(d) if has_upstream else ""
    if pushed and upstream_sha(d) == git(d, "rev-parse", "HEAD") == pushed:
        note = f"; upstream {upstream} pushed by brg-push at {pushed[:8]}"
    elif has_upstream:
        before = st.get("upstream_at_start") or ""
        if not before:
            return False, f"the branch has an upstream ({upstream}): the run must not push"
        if upstream_sha(d) != before:
            return False, f"{upstream} was pushed during the run (it moved from {before[:8]}): the run must not push"
        note = f"; upstream {upstream} unchanged since the run started"
    return (bool(mr) and committed,
            f"MR description: {len(mr)}; {rep}: {'committed' if committed else 'not committed'}{note}")


GATES = {"repo": g_repo, "branch": g_branch, "prd": g_prd, "stories": g_stories, "decide": g_decide,
         "architecture": g_architecture, "design": g_design, "repos": g_repos, "ux": g_ux,
         "contract": g_contract, "lld": g_lld,
         "test_cases": g_test_cases,
         "build": g_build, "test_automation": g_test_automation,
         "test_run": g_test_run, "design_review": g_design_review, "review": g_review, "dod": g_dod, "mr": g_mr}
assert list(GATES) == NAMES, "every stage has its gate, in order"


# The stages a planning run (--until) may stop after: the build starts at repos.
PLANNING = NAMES[: NAMES.index("design") + 1]


def run_names(st):
    """The stages this run covers: all of them, or up to --until (planning only)."""
    u = st.get("until")
    return NAMES[: NAMES.index(u) + 1] if u in NAMES else NAMES


def next_stage(st):
    for n in run_names(st):
        s = st["stages"][n]
        if s["status"] == "blocked":
            return n, "blocked"
        if s["status"] != "done":
            return n, s["status"]
    return None, "done"


# Files that are not code: a repository holding only these (a PRD, ADRs and
# designs from the earlier stages, a README, an ignore file) is a product not
# built yet, not a change to an existing one.
NOT_CODE = re.compile(r"^(docs/|\.[^/]+$)|\.(md|txt|rst|adoc)$|(^|/)(LICEN[CS]E|NOTICE|COPYING)[^/]*$", re.I)


def existing_repo(d):
    """A repository with code before the run: its change is scope lean. A
    repository holding only documents (a run that begins after the PRD,
    backlog, ADRs and HLD were committed) is a new product, scope full."""
    if not os.path.isdir(os.path.join(d, ".git")) or not git(d, "rev-parse", "-q", "--verify", "HEAD"):
        return False
    return any(not not_work(d, f) and not NOT_CODE.search(f) for f in git(d, "ls-files").splitlines())


def cmd_start(a):
    d = a.dir
    # a workspace Claude Code does not trust ignores the settings allow list,
    # so every command in the run would wait on a prompt nobody answers
    top = git(d, "rev-parse", "--show-toplevel") if os.path.isdir(d) else ""
    root = top.strip() or d
    ts = ""
    try:
        r = subprocess.run(["bash", os.path.join(os.path.dirname(os.path.abspath(__file__)), "brg-doctor"), "--trust-state", root],
                           capture_output=True, text=True, timeout=10)
        ts = r.stdout.strip()
        why = "" if ts else f"brg-doctor printed nothing (exit {r.returncode})"
    except (OSError, subprocess.SubprocessError) as e:
        why = str(e)
    if not ts:
        print(f"autopilot: trust check not run: {why}", file=sys.stderr)
    m = re.match(r"untrusted (\d+)$", ts)
    if m and int(m.group(1)) > 0:
        print(f"brg-autopilot: workspace not trusted; {m.group(1)} allow entries would be ignored and every command would wait. "
              f"Run claude in {root} once and accept the trust dialog, then rerun.", file=sys.stderr)
        return 1
    if os.path.isfile(state_path(d)):
        st = json.load(open(state_path(d)))
        n, _ = next_stage(st)
        if n:
            print(f"brg-autopilot: run {st['run']} is open at stage {n}; continue it, or finish it first", file=sys.stderr)
            return 1
    now = datetime.datetime.now()
    st = {
        "run": f"{now:%Y-%m-%d}-{slug(a.statement)}",
        "statement": a.statement,
        "started": now.isoformat(timespec="seconds"),
        "started_epoch": now.timestamp(),
        "stages": {n: {"status": "pending", "attempts": 0, "checked": "", "notes": []} for n in NAMES},
        "decisions": [],
        # where an upstream the engineer pushed stood when the run began; the
        # mr gate refuses only a move during the run
        "upstream_at_start": upstream_sha(d),
        # a repository with commits and files before the run: a change, scope lean
        "existing": existing_repo(d),
    }
    # --until <stage>: a planning run (prd, stories, decisions, architecture,
    # design) that stops there with the digest, for a user who has a plan
    # and wants the documents without the build
    if a.until:
        st["until"] = a.until
    os.makedirs(d, exist_ok=True)
    save(d, st)
    upto = f", until {a.until}" if a.until else ""
    print(f"brg-autopilot: run {st['run']} started, {len(run_names(st))} of {len(NAMES)} stages{upto}")
    return cmd_next(a)


def cmd_continue(a):
    """A planning run goes on into the build: --until is dropped, every stage
    done and every decision recorded stay."""
    st = load(a.dir)
    if not st.get("until"):
        print("brg-autopilot: this run is not a planning run; use next", file=sys.stderr)
        return 1
    print(f"brg-autopilot: run {st['run']} continues past {st.pop('until')}, {len(st['decisions'])} decisions kept")
    save(a.dir, st)
    return cmd_next(a)


def cmd_next(a):
    st = load(a.dir)
    n, status = next_stage(st)
    if n is None:
        if st.get("until"):
            rest = NAMES[len(run_names(st)):]
            print(f"brg-autopilot: planning done through {st['until']}; not run: {', '.join(rest)}. "
                  "Write the report (brg-autopilot report). The build: brg-autopilot continue, which keeps every "
                  "decision, or start-task on the first story by hand")
            return 0
        print("brg-autopilot: every stage is done; the merge request is prepared")
        return 0
    stage = dict((s[0], s) for s in STAGES)[n]
    if status == "blocked":
        print(f"brg-autopilot: stage {n} is blocked after {MAX_ATTEMPTS} attempts; write the report (brg-autopilot report) and stop")
        return 1
    print(f"next: {n}  (attempt {st['stages'][n]['attempts'] + 1} of {MAX_ATTEMPTS})")
    print(f"skill: {stage[1]}")
    print(f"gate: {stage[2]}")
    return 0


def cmd_done(a):
    st = load(a.dir)
    n, _ = next_stage(st)
    if a.stage != n:
        print(f"brg-autopilot: the next stage is {n}, not {a.stage}; stages run in order", file=sys.stderr)
        return 1
    ok, what = GATES[a.stage](a.dir, st)
    st["stages"][a.stage]["checked"] = what
    if ok:
        st["stages"][a.stage]["status"] = "done"
        save(a.dir, st)
        print(f"gate {a.stage}: passed ({what})")
        return cmd_next(a)
    save(a.dir, st)
    print(f"gate {a.stage}: not met ({what}); fix it and run done again, or record a failed attempt with fail")
    return 1


def cmd_fail(a):
    st = load(a.dir)
    s = st["stages"][a.stage]
    s["attempts"] += 1
    s["notes"].append(a.why)
    s["status"] = "blocked" if s["attempts"] >= MAX_ATTEMPTS else "retry"
    save(a.dir, st)
    print(f"stage {a.stage}: attempt {s['attempts']} of {MAX_ATTEMPTS} failed ({a.why}); {s['status']}")
    return 1 if s["status"] == "blocked" else 0


def cmd_decision(a):
    st = load(a.dir)
    if a.key == "none-open":
        st["no_open_decisions"] = a.why
        save(a.dir, st)
        print(f"decisions: none open ({a.why})")
        return 0
    st["decisions"].append({"key": a.key, "choice": a.choice, "alternatives": a.alternatives,
                            "why": a.why, "adr": a.adr or "", "status": "Proposed"})
    save(a.dir, st)
    print(f"decision {len(st['decisions'])}: {a.key} = {a.choice} (Proposed)")
    return 0


def cmd_report(a):
    st = load(a.dir)
    rel = f"docs/autopilot/{st['run']}.md"
    L = [f"# Autopilot run {st['run']}", "",
         f"Statement: {st['statement']}", "",
         f"Started {st['started']}; branch {st.get('branch', 'none')}. Every decision below was taken on",
         "the user's behalf with the recommended option and is Proposed until the user accepts or",
         "changes it. Nothing was merged or deployed; the push is the engineer's, or brg-push's where",
         "the repository is opted in.", "",
         "## Decisions to review", "",
         "| Key | Choice | Alternatives | Why | ADR |", "| --- | --- | --- | --- | --- |"]
    for x in st["decisions"]:
        L.append(f"| {x['key']} | {x['choice']} | {x['alternatives']} | {x['why']} | {x['adr'] or 'none'} |")
    if not st["decisions"]:
        L.append(f"| none | | | {st.get('no_open_decisions', 'no decision recorded')} | |")
    L += ["", "## Stages", "", "| Stage | Status | Attempts | Gate checked |", "| --- | --- | --- | --- |"]
    for n in NAMES:
        s = st["stages"][n]
        L.append(f"| {n} | {s['status']} | {s['attempts']} | {s['checked'] or 'not checked'} |")
    notes = [(n, x) for n in NAMES for x in st["stages"][n]["notes"]]
    if st.get("repos"):
        L += ["", "## Repositories", "", "| Repository | Stack | Where |", "| --- | --- | --- |"]
        L += [f"| {r['name']} | {r['stack']} | {r['path']} |" for r in st["repos"]]
    L += ["", "## Not done", ""]
    covered = run_names(st)
    open_ = [n for n in covered if st["stages"][n]["status"] != "done" and n != "mr"]
    later = [f"- {n}: not run (planning run, until {st.get('until')})" for n in NAMES if n not in covered]
    L += [f"- {n}: {st['stages'][n]['status']}" for n in open_] + later or ["- none"]
    if notes:
        L += ["", "## Failed attempts", ""] + [f"- {n}: {x}" for n, x in notes]
    os.makedirs(os.path.join(a.dir, "docs", "autopilot"), exist_ok=True)
    with open(os.path.join(a.dir, rel), "w") as f:
        f.write("\n".join(L) + "\n")
    print(f"brg-autopilot: report written to {rel} ({len(st['decisions'])} decisions, "
          f"{sum(st['stages'][n]['status'] == 'done' for n in NAMES)} of {len(NAMES)} stages done)")
    return 0


def cmd_status(a):
    st = load(a.dir)
    print(f"run {st['run']}: {st['statement']}")
    for n in NAMES:
        s = st["stages"][n]
        print(f"  {n:8} {s['status']:8} attempts {s['attempts']}  {s['checked']}")
    print(f"decisions: {len(st['decisions'])}")
    print(f"profile: {profile_text(st) if st.get('profile') else 'not recorded'}")
    return 0


def cmd_stages(a):
    print("\n".join(NAMES))
    return 0


def cmd_profile(a):
    """What the product has, which decides the stages that apply: ux and
    design_review need ui, the data model data, the API contract api, the
    deployment architecture deploy. Recorded as a row of the digest; the dod
    gate refuses a profile the code contradicts."""
    if a.llm == "yes":
        # A product that calls a model owes genai-design, which lives in the
        # optional bearing-genai plugin; refuse before anything is recorded.
        kp = os.path.join(os.path.dirname(os.path.abspath(__file__)), "brg-kit-paths")
        r = subprocess.run(["bash", kp, "--skill", "genai-design"], capture_output=True, text=True)
        if r.returncode != 0:
            hint = (r.stderr or r.stdout).strip().splitlines()
            print(f"profile llm: {hint[-1] if hint else 'genai-design did not resolve'}; no profile recorded",
                  file=sys.stderr)
            return 2
    st = load(a.dir)
    st["profile"] = {k: getattr(a, k) for k in PROFILE_KEYS}
    st["profile"]["llm"] = a.llm
    st["profile"]["ui_stack"] = a.ui_stack
    if a.scope != "auto":
        st["profile"]["scope"] = a.scope
    text = profile_text(st)
    st["decisions"] = [x for x in st["decisions"] if x["key"] != "profile"]
    st["decisions"].append({"key": "profile", "choice": text, "alternatives": "-", "why": a.why,
                            "adr": "", "status": "Proposed"})
    save(a.dir, st)
    print(f"profile: {text} (Proposed)")
    return 0


def make_targets(d):
    """The targets the repository's Makefile defines, by name."""
    for mk in ("Makefile", "GNUmakefile"):
        p = os.path.join(d, mk)
        if os.path.isfile(p):
            return set(re.findall(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", read(d, mk), re.M))
    return set()


def compose_file(d):
    for f in ("compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"):
        if os.path.isfile(os.path.join(d, f)):
            return f
    return ""


def branch_id(d):
    """The ticket key in the branch name (feature/T-5-app gives T-5), or ""."""
    m = re.search(r"([A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-\d+)", git(d, "branch", "--show-current"))
    return m.group(1) if m else ""


def plan_checks(text):
    """The plan's base URL and its (method, path, status) checks. A line is
    `base <url>`, `<METHOD> <path or url> <status>`, a blank or a # comment."""
    base, checks = "", []
    for line in text.splitlines():
        w = line.split("#", 1)[0].split()
        if len(w) == 2 and w[0].lower() == "base":
            base = w[1].rstrip("/")
        elif len(w) == 3 and w[2].isdigit():
            checks.append((w[0].upper(), w[1], int(w[2])))
    return base, checks


def cmd_smoke_request(a):
    """Headless at dod, the sandbox keeps Docker and .env out of reach, so the
    model hands the smoke to the launcher (which runs outside it) and ends its
    turn. Refused when there is nothing the launcher could run."""
    st = load(a.dir)
    sid = a.id or branch_id(a.dir) or "run"
    plan = f".scratch/smoke-plan-{sid}.txt"
    if "smoke" in make_targets(a.dir):
        how = "make smoke"
    else:
        if not os.path.isfile(os.path.join(a.dir, plan)):
            print(f"brg-autopilot: no make smoke target and no {plan}; write the checks there "
                  "(`base <url>`, then one `METHOD /path status` per line)", file=sys.stderr)
            return 1
        _, checks = plan_checks(read(a.dir, plan))
        if not checks:
            print(f"brg-autopilot: {plan} lists 0 checks; a smoke that checks nothing proves nothing",
                  file=sys.stderr)
            return 1
        how = f"{plan} ({len(checks)} checks)"
    st["smoke_request"] = {"pending": True, "id": sid, "requested": datetime.datetime.now().isoformat(timespec="seconds")}
    save(a.dir, st)
    print(f"smoke requested: {how}; end your turn now, the launcher runs it outside the sandbox "
          "and resumes this session with the verdict")
    if os.environ.get("BRG_AUTOPILOT_HEADLESS") != "1":
        print("note: not a headless run, so no launcher will pick this up; run the smoke yourself (definition-of-done item 13)")
    return 0


def cmd_repos_request(a):
    """Headless at repos, the sandbox lets the run write only inside its own
    directory, and the plan's repositories go beside it; the model hands them
    to the launcher (which scaffolds them outside it) and ends its turn.
    Refused when the plan names nothing that is missing."""
    st = load(a.dir)
    entries, why = plan_entries(a.dir)
    if entries is None:
        print(f"brg-autopilot: {why}", file=sys.stderr)
        return 1
    todo = missing_repos(a.dir, entries)
    if not todo:
        print(f"brg-autopilot: 0 repos to scaffold ({repos_n(len(entries))} in the plan, none missing); "
              "run brg-autopilot done repos", file=sys.stderr)
        return 1
    st["repos_request"] = {"pending": True, "names": [n for n, _, _ in todo],
                           "requested": datetime.datetime.now().isoformat(timespec="seconds")}
    save(a.dir, st)
    print(f"{repos_n(len(todo))} to scaffold outside the sandbox: "
          f"{', '.join(n for n, _, _ in todo)}; end your turn now, the launcher scaffolds them beside "
          "this repository and resumes this session")
    if os.environ.get("BRG_AUTOPILOT_HEADLESS") != "1":
        print("note: not a headless run, so no launcher will pick this up; run new-repo for each yourself")
    return 0


def scaffold_repos(d):
    """The repo plan's missing repositories, scaffolded beside d with brg-scaffold
    --check, outside the sandbox. Returns (made, failed) names; the scaffold's
    output goes to .bearing/state/repos.log."""
    entries, _ = plan_entries(d)
    todo = missing_repos(d, entries or [])
    scaffold = os.environ.get("BRG_SCAFFOLD") or os.path.join(KIT, "bin", "brg-scaffold")
    log = os.path.join(d, ".bearing", "state", "repos.log")
    print(f"brg-autopilot: scaffolding {repos_n(len(todo))} outside the sandbox: {', '.join(n for n, _, _ in todo)}")
    made, failed = [], []
    for name, stack, path in todo:
        rc = run_logged(["bash", scaffold, stack, name, "--dir", path, "--check"], d, log)
        (made if rc == 0 and not repo_problem(path) else failed).append(name)
    return made, failed


def run_logged(args, d, log):
    """Run a command in d with its output appended to log; its exit code."""
    with open(log, "a") as f:
        f.write(f"$ {' '.join(args)}\n")
        f.flush()
        try:
            return subprocess.run(args, cwd=d, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                  timeout=int(os.environ.get("BRG_SMOKE_TIMEOUT", "900"))).returncode
        except (OSError, subprocess.TimeoutExpired) as e:
            f.write(f"{e}\n")
            return 127


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def http_status(method, url, deadline):
    """The status the app answers, retrying a refused connection until the
    deadline (the stack may still be starting); 0 when it never answered."""
    opener = urllib.request.build_opener(NoRedirect)
    while True:
        try:
            with opener.open(urllib.request.Request(url, method=method), timeout=10) as r:
                return r.status, ""
        except urllib.error.HTTPError as e:
            return e.code, ""
        except (urllib.error.URLError, OSError) as e:
            if time.time() >= deadline:
                return 0, str(getattr(e, "reason", e))
            time.sleep(0.5)


def run_smoke(d, sid):
    """The smoke, outside the sandbox. make smoke when the Makefile has it
    (it writes the evidence and exits non-zero on failure); otherwise up,
    the plan's checks, and down, always. Returns (passed, evidence path, line)."""
    log = os.path.join(d, ".bearing", "state", "smoke.log")
    targets = make_targets(d)
    if "smoke" in targets:
        started = time.time() - 1
        rc = run_logged(["make", "smoke"], d, log)
        files = [f for f in glob.glob(os.path.join(d, ".scratch", "smoke-*.md")) if os.path.getmtime(f) >= started]
        if not files:
            return False, "", f"make smoke exited {rc} and wrote no .scratch/smoke-*.md"
        newest = max(files, key=os.path.getmtime)
        rel = os.path.relpath(newest, d)
        m = SMOKE_LINE.findall(read(d, rel))
        if not m:
            return False, rel, f"no 'smoke: N requests checked, F failed' line (make smoke exited {rc})"
        checked, failed = (int(x) for x in m[-1])
        line = f"smoke: {checked} requests checked, {failed} failed"
        if checked == 0:
            return False, rel, line + " (0 requests proves nothing)"
        return rc == 0 and failed == 0, rel, line + ("" if rc == 0 else f" (make smoke exited {rc})")
    rel = f".scratch/smoke-{sid}.md"
    base, checks = plan_checks(read(d, f".scratch/smoke-plan-{sid}.txt"))
    compose = compose_file(d)
    if "up" in targets:
        up, down = ["make", "up"], ["make", "down"]
    elif compose:
        up, down = (["docker", "compose", "up", "-d", "--build", "--wait"], ["docker", "compose", "down"])
    else:
        up = down = None
    made_env = False
    if not os.path.exists(os.path.join(d, ".env")) and os.path.isfile(os.path.join(d, ".env.example")):
        shutil.copyfile(os.path.join(d, ".env.example"), os.path.join(d, ".env"))
        made_env = True
    rows, notes = [], []
    try:
        if not up:
            notes.append("nothing to start: no make up target and no compose file")
        else:
            rc = run_logged(up, d, log)
            if rc != 0:
                notes.append(f"`{' '.join(up)}` exited {rc}; see .bearing/state/smoke.log")
            else:
                deadline = time.time() + int(os.environ.get("BRG_SMOKE_WAIT", "60"))
                for method, path, want in checks:
                    url = path if "://" in path else base + (path if path.startswith("/") else "/" + path)
                    got, err = http_status(method, url, deadline)
                    rows.append((method, path, want, got, err))
    finally:
        if down:
            rc = run_logged(down, d, log)
            if rc != 0:
                notes.append(f"`{' '.join(down)}` exited {rc}")
        if made_env:
            os.remove(os.path.join(d, ".env"))
    failed = sum(1 for r in rows if r[3] != r[2])
    line = f"smoke: {len(rows)} requests checked, {failed} failed"
    L = [f"# Smoke {sid}", "", f"Run by brg-autopilot launch, outside the sandbox, {datetime.datetime.now():%Y-%m-%d %H:%M}.",
         f"Started with `{' '.join(up) if up else 'nothing'}`, stopped with `{' '.join(down) if down else 'nothing'}`.", ""]
    L += [f"- {n}" for n in notes] + ([""] if notes else [])
    L += ["| Method | Path | Expected | Status |", "| --- | --- | --- | --- |"]
    L += [f"| {m} | {p} | {w} | {g or 'no answer: ' + e} |" for m, p, w, g, e in rows]
    L += ["", line]
    os.makedirs(os.path.join(d, ".scratch"), exist_ok=True)
    with open(os.path.join(d, rel), "w") as f:
        f.write("\n".join(L) + "\n")
    if not rows:
        return False, rel, line + " (0 requests proves nothing" + (f"; {notes[0]})" if notes else ")")
    return failed == 0 and not notes, rel, line + (f" ({'; '.join(notes)})" if notes else "")


def session_id(log, offset):
    """The session id of the newest init event written to log after offset."""
    sid = ""
    with open(log, encoding="utf-8", errors="replace") as f:
        f.seek(offset)
        for line in f:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if isinstance(ev, dict) and ev.get("type") == "system" and ev.get("subtype") == "init" and ev.get("session_id"):
                sid = ev["session_id"]
    return sid


def cmd_launch(a):
    claude = os.environ.get("BRG_CLAUDE", "claude")
    flags = ["--permission-mode", "acceptEdits", "--allowedTools", "Bash,Read,Write,Edit,Glob,Grep,Skill,Agent",
             "--output-format", "stream-json", "--verbose"]
    if os.environ.get("BRG_AUTOPILOT_PLUGIN_DIR"):
        flags = ["--plugin-dir", os.environ["BRG_AUTOPILOT_PLUGIN_DIR"]] + flags
    cmd = [claude, "-p", f"Run autopilot for this requirement: {a.statement}"] + flags
    if a.print:
        print(" ".join(repr(c) if " " in c else c for c in cmd))
        print(f"then, for each repos-request (at most {MAX_ATTEMPTS}): brg-scaffold outside the sandbox for each "
              "missing repo-plan entry, and claude -p --resume <session> with what it made")
        print(f"then, for each smoke-request (at most {MAX_SMOKE_ROUNDS}): the smoke outside the sandbox, "
              "and claude -p --resume <session> with its verdict")
        return 0
    if not shutil.which(claude):
        print(f"brg-autopilot: {claude} not found", file=sys.stderr)
        return 1
    os.makedirs(a.dir, exist_ok=True)
    log = os.path.join(a.dir, ".bearing", "state", "autopilot.log")
    os.makedirs(os.path.dirname(log), exist_ok=True)
    # BEARING_AUTOPILOT tells the child's SessionStart hook nobody is there to ask.
    env = dict(os.environ, BRG_AUTOPILOT_HEADLESS="1", BEARING_AUTOPILOT="1")
    print(f"brg-autopilot: running headless in {a.dir}; the stream goes to {os.path.relpath(log, a.dir)}")

    def claude_run(args):
        offset = os.path.getsize(log) if os.path.exists(log) else 0
        with open(log, "a") as f:
            rc = subprocess.run(args, cwd=a.dir, stdout=f, stderr=subprocess.STDOUT, env=env).returncode
        return rc, session_id(log, offset)

    rc, session = claude_run(cmd)
    rounds = repo_rounds = 0
    while True:
        st = json.load(open(state_path(a.dir))) if os.path.isfile(state_path(a.dir)) else {}
        rreq = st.get("repos_request") or {}
        if rreq.get("pending"):
            if repo_rounds >= MAX_ATTEMPTS:
                print(f"brg-autopilot: repos asked for a round {repo_rounds + 1}; the limit is {MAX_ATTEMPTS}; stopping")
                return 1
            repo_rounds += 1
            made, failed = scaffold_repos(a.dir)
            rreq.update(pending=False, round=repo_rounds, made=made, failed=failed)
            st["repos_request"] = rreq
            save(a.dir, st)
            if not session:
                print("brg-autopilot: no session id in the stream-json log, so the run cannot be resumed", file=sys.stderr)
                return 1
            msg = (f"brg-autopilot scaffolded the repo plan outside the sandbox, beside this repository: "
                   f"{', '.join(made) or 'none'}"
                   + (f"; failed: {', '.join(failed)} (see .bearing/state/repos.log)" if failed else "")
                   + ". Run brg-autopilot done repos and continue autopilot"
                   + ("; for a failure, read the log, then fail the stage or request again." if failed else "."))
            rc, resumed = claude_run([claude, "-p", msg, "--resume", session] + flags)
            session = resumed or session
            continue
        req = st.get("smoke_request") or {}
        if not req.get("pending"):
            break
        if rounds >= MAX_SMOKE_ROUNDS:
            print(f"brg-autopilot: smoke asked for a round {rounds + 1}; the limit is {MAX_SMOKE_ROUNDS}; stopping")
            return 1
        rounds += 1
        print(f"brg-autopilot: smoke round {rounds} of {MAX_SMOKE_ROUNDS}, outside the sandbox")
        ok, rel, line = run_smoke(a.dir, req.get("id") or "run")
        req.update(pending=False, round=rounds, passed=ok, evidence=rel, verdict=line)
        st["smoke_request"] = req
        save(a.dir, st)
        print(f"brg-autopilot: {rel or 'no evidence file'}: {line}; {'passed' if ok else 'failed'}")
        if not ok and rounds >= MAX_SMOKE_ROUNDS:
            print(f"brg-autopilot: smoke failed {rounds} rounds of {MAX_SMOKE_ROUNDS}; stopping. "
                  "Fix it by hand, or resume the session yourself")
            return 1
        if not session:
            print("brg-autopilot: no session id in the stream-json log, so the run cannot be resumed", file=sys.stderr)
            return 1
        if ok:
            msg = (f"brg-autopilot ran the smoke outside the sandbox: {rel}, {line}: passed. "
                   "Finish the dod stage (brg-autopilot done dod) and continue autopilot.")
        else:
            msg = (f"brg-autopilot ran the smoke outside the sandbox: {rel or 'no evidence file'}, {line}: failed "
                   f"(round {rounds} of {MAX_SMOKE_ROUNDS}). Read it and .bearing/state/smoke.log, fix each "
                   "failure test first, commit, then run brg-autopilot smoke-request again and end your turn.")
        rc, resumed = claude_run([claude, "-p", msg, "--resume", session] + flags)
        session = resumed or session
    print(f"brg-autopilot: claude exited {rc}; see brg-autopilot status and docs/autopilot/")
    return rc


def main():
    ap = argparse.ArgumentParser(prog="brg-autopilot", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    def add(name, fn, *args):
        p = sub.add_parser(name)
        for x in args:
            p.add_argument(x)
        p.add_argument("--dir", default=os.getcwd())
        p.set_defaults(fn=fn)
        return p
    p = add("start", cmd_start, "statement")
    p.add_argument("--until", default="", choices=[""] + PLANNING,
                   help="stop after this planning stage: design for a planning run (PRD, backlog, decisions, architecture, design)")
    add("continue", cmd_continue)
    add("next", cmd_next)
    p = add("done", cmd_done, "stage"); p.set_defaults(fn=cmd_done)
    add("fail", cmd_fail, "stage", "why")
    p = add("decision", cmd_decision, "key", "choice", "alternatives", "why")
    p.add_argument("--adr", default="")
    add("report", cmd_report)
    add("status", cmd_status)
    sub.add_parser("stages").set_defaults(fn=cmd_stages, dir=os.getcwd())
    p = add("profile", cmd_profile)
    for k in PROFILE_KEYS:
        p.add_argument(f"--{k}", required=True, choices=["yes", "no"])
    p.add_argument("--llm", default="no", choices=["yes", "no"],
                   help="the product calls a language model at run time: genai-design in design, "
                        "llm-guardrails and llm-eval before the tests are done")
    p.add_argument("--ui-stack", default=DEFAULT_UI_STACK,
                   help="react-shadcn (default: React, shadcn/ui, Tailwind, screens as code) or the stack "
                        "the implementer chose (html prototypes for any other)")
    p.add_argument("--scope", default="auto", choices=["auto", "lean", "full"],
                   help="auto (default): lean for a change to an existing repository or a product with no "
                        "ui, data, api or deploy; full otherwise. full when a change adds a service, a store, "
                        "an external integration or a new UI area")
    p.add_argument("--why", required=True)
    p = add("launch", cmd_launch, "statement")
    p.add_argument("--print", action="store_true")
    add("repos-request", cmd_repos_request)
    p = add("smoke-request", cmd_smoke_request)
    p.add_argument("--id", default="", help="the ticket key in smoke-<ID>.md; default: from the branch name")
    a = ap.parse_args()
    a.dir = os.path.abspath(a.dir)
    if getattr(a, "stage", None) and a.stage not in NAMES:
        print(f"brg-autopilot: unknown stage {a.stage}; stages: {', '.join(NAMES)}", file=sys.stderr)
        return 2
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
