# Copy to .env for local plans. Never commit .env. Every value here is
# non-secret: cloud credentials come from `gcloud auth application-default
# login` locally and from workload identity federation in CI.
TF_VAR_project=my-gcp-project-dev
TF_VAR_region=asia-south1
# State bucket, passed to `terraform init -backend-config` by make init and
# scripts/plan.sh. AWS: the S3 bucket name; also switch envs/*/backend.tf.
TF_BACKEND_BUCKET=__REPO_SLUG__-tfstate
# Local dependencies (docker compose). Throwaway defaults, never reused.
POSTGRES_PASSWORD=postgres
