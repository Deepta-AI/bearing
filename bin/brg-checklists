#!/usr/bin/env bash
# brg-checklists: the review checklists that apply, as absolute paths, one
# per line: the universal checklist first, then one per detected stack.
#
#   brg-checklists --repo [dir]        stacks from the repository's markers
#                                      (go.mod, pyproject.toml, package.json
#                                      dependencies, *.tf, pubspec.yaml ...)
#   brg-checklists --range <range>     stacks from the files a diff touches
#                                      (git diff --name-only <range>), with
#                                      package.json deciding react, next,
#                                      react-native or node for .ts/.tsx
#   brg-checklists --files <f>...      stacks from the named files
#
# Every consumer (branch-review, the reviewer agent, the SessionStart line
# that lets gstack /review apply them) detects stacks here, so they agree.
# The last line is "brg-checklists: N checklists (stacks: ...)"; exit 1 when
# no file was examined or the universal checklist is missing. bash 3.2 safe.
set -u
KIT="$(cd "$(dirname "$0")/.." && pwd)"
mode="${1:-}"; shift || true

# js_stack <dir>: the lane of the nearest package.json's dependencies.
js_stack() {
  local d="$1" pj=""
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -f "$d/package.json" ] && { pj="$d/package.json"; break; }
    d="$(dirname "$d")"
  done
  [ -n "$pj" ] || { echo node; return; }
  if grep -q '"next"' "$pj"; then echo nextjs
  elif grep -qE '"(expo|react-native)"' "$pj"; then echo react-native
  elif grep -q '"react"' "$pj"; then echo react
  else echo node; fi
}

# stack_of <root> <file>: the lane a file belongs to, or nothing.
stack_of() {
  local root="$1" f="$2"
  case "$f" in
    *.sql|*/migrations/*|migrations/*|*/alembic/versions/*|db/*) echo database ;;
  esac
  case "$f" in
    *.go) echo go ;;
    *.py) if [ -f "$root/dbt_project.yml" ] || [ -d "$root/dags" ]; then echo data-pipeline; else echo python; fi ;;
    *.tf|*.tfvars|k8s/*|*/k8s/*|kustomization.yaml|*/kustomization.yaml) echo infra ;;
    *.kt|*.kts) echo android ;;
    *.swift) echo ios ;;
    *.dart) echo flutter ;;
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) js_stack "$root/$(dirname "$f")" ;;
  esac
}

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
files=""
case "$mode" in
  --repo)
    root="${1:-$root}"
    for m in go.mod pyproject.toml requirements.txt package.json pubspec.yaml build.gradle.kts Package.swift dbt_project.yml; do
      [ -f "$root/$m" ] && files="$files$m
"
    done
    for d in "$root"/*.xcodeproj "$root"/*.tf "$root"/infra "$root"/k8s "$root"/migrations "$root"/db/migrations; do
      [ -e "$d" ] && files="$files${d#"$root"/}
"
    done
    # a marker names a lane directly where the extension rule cannot
    files="$(printf '%s' "$files" | sed -e 's/^go\.mod$/x.go/' -e 's/^pyproject\.toml$/x.py/' -e 's/^requirements\.txt$/x.py/' \
      -e 's/^package\.json$/x.ts/' -e 's/^pubspec\.yaml$/x.dart/' -e 's/^build\.gradle\.kts$/x.kts/' -e 's/^Package\.swift$/x.swift/' \
      -e 's/\.xcodeproj$/.swift/' -e 's/^dbt_project\.yml$/x.py/' -e 's/^infra$/x.tf/' -e 's/^k8s$/k8s\/x/' -e 's/^db\/migrations$/migrations\/x/' -e 's/^migrations$/migrations\/x/')"
    ;;
  --range)
    [ -n "${1:-}" ] || { echo "brg-checklists: --range needs a range" >&2; exit 2; }
    files="$(git -C "$root" diff --name-only "$1" 2>/dev/null)" || { echo "brg-checklists: cannot read range $1" >&2; exit 1; }
    ;;
  --files)
    files="$(printf '%s\n' "$@")"
    ;;
  *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

universal="$KIT/skills/branch-review/references/universal-checklist.md"
[ -f "$universal" ] || { echo "brg-checklists: universal checklist missing at $universal" >&2; exit 1; }

n=0; stacks=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  n=$((n+1))
  for s in $(stack_of "$root" "$f"); do
    case " $stacks " in *" $s "*) ;; *) stacks="$stacks $s" ;; esac
  done
done <<EOF
$files
EOF
[ "$n" -gt 0 ] || { echo "brg-checklists: 0 files examined, nothing checked" >&2; exit 1; }

echo "$universal"
count=1; missing=""
for s in $stacks; do
  c="$KIT/skills/$s/references/review-checklist.md"
  if [ -f "$c" ]; then echo "$c"; count=$((count+1)); else missing="$missing $s"; fi
done
echo "brg-checklists: $count checklists from $n files (stacks:${stacks:- none}${missing:+; no checklist:$missing})"
