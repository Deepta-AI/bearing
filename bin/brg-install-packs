#!/usr/bin/env bash
# brg-install-packs: install the open-source skills the workflow names as main
# choices, at user scope, idempotently. Alternates are documented in
# docs/THIRD_PARTY.md with their own install commands and are not installed
# here, so a session is not loaded with skills nobody chose.
#
#   brg-install-packs [--skip-official] [--skip-skills-cli] [--skip-playwright] [--skip-pinned]
#   Skill names are the SKILL.md names in each repository (npx skills add <repo> -l lists them).
#
# Sources: the official Claude Code marketplace (claude plugin install), the
# skills CLI (npx skills add, from vercel-labs/skills), the Playwright agent
# CLI (playwright-cli install --skills), and bin/pinned-packs.txt: repositories
# fetched at a fixed commit into ~/.cache/bearing-packs, their skill folders
# copied to ~/.claude/skills. Prints a count of installed, present and skipped
# entries.
set -uo pipefail
skip_official=0; skip_cli=0; skip_pw=0; skip_pin=0
while [ $# -gt 0 ]; do
  case "$1" in
    --skip-official) skip_official=1; shift;;
    --skip-skills-cli) skip_cli=1; shift;;
    --skip-playwright) skip_pw=1; shift;;
    --skip-pinned) skip_pin=1; shift;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
installed=0; present=0; skipped=0; failed=0
did() { echo "installed  $*"; installed=$((installed+1)); }
had() { echo "present    $*"; present=$((present+1)); }
skip() { echo "skipped    $*"; skipped=$((skipped+1)); }
fail() { echo "FAILED     $*"; failed=$((failed+1)); }

# 1. Official marketplace plugins (Anthropic-maintained or vetted).
OFFICIAL="frontend-design code-review claude-security mattpocock-skills mcp-server-dev playwright"
if [ "$skip_official" -eq 1 ]; then skip "official marketplace plugins"; else
  list="$(claude plugin list 2>/dev/null || true)"
  for p in $OFFICIAL; do
    if printf '%s' "$list" | grep -q "$p@claude-plugins-official"; then had "$p (official)"; continue; fi
    if claude plugin install "$p@claude-plugins-official" >/dev/null 2>&1; then did "$p (official)"; else fail "$p (official): claude plugin install $p@claude-plugins-official"; fi
  done
fi

# 2. Skills from git repositories through the skills CLI, user scope.
#    Format: repo|skill|folder-name-under-~/.claude/skills
CLI_SKILLS="
vercel-labs/agent-skills|vercel-react-best-practices|vercel-react-best-practices
vercel-labs/agent-skills|vercel-react-view-transitions|vercel-react-view-transitions
vercel-labs/agent-skills|web-design-guidelines|web-design-guidelines
educlopez/ui-craft||ui-craft
phuryn/pm-skills|create-prd|create-prd
phuryn/pm-skills|user-stories|user-stories
phuryn/pm-skills|job-stories|job-stories
phuryn/pm-skills|test-scenarios|test-scenarios
phuryn/pm-skills|release-notes|release-notes
phuryn/pm-skills|prioritization-frameworks|prioritization-frameworks
phuryn/pm-skills|sprint-plan|sprint-plan
phuryn/pm-skills|pre-mortem|pre-mortem
phuryn/pm-skills|customer-journey-map|customer-journey-map
phuryn/pm-skills|outcome-roadmap|outcome-roadmap
addyosmani/agent-skills|documentation-and-adrs|documentation-and-adrs
addyosmani/agent-skills|api-and-interface-design|api-and-interface-design
addyosmani/agent-skills|observability-and-instrumentation|observability-and-instrumentation
addyosmani/agent-skills|debugging-and-error-recovery|debugging-and-error-recovery
dash0hq/agent-skills|otel-instrumentation|otel-instrumentation
petrkindlmann/qa-skills|test-reliability|test-reliability
petrkindlmann/qa-skills|selector-drift-recovery|selector-drift-recovery
petrkindlmann/qa-skills|ai-test-generation|ai-test-generation
conventional-changelog/conventional-changelog|conventional-commit-message|conventional-commit-message
trailofbits/skills|differential-review|differential-review
"
if [ "$skip_cli" -eq 1 ]; then skip "skills CLI packs"; else
  command -v npx >/dev/null || { fail "npx not found; install node 22+"; skip "skills CLI packs"; }
  if command -v npx >/dev/null; then
    # The loop reads from a process substitution, not a pipe, so the counters
    # it bumps are the script's own and the summary and exit code are real.
    entries=0
    while IFS='|' read -r repo skill folder; do
      [ -n "$repo" ] || continue
      entries=$((entries+1))
      if ls -d "$HOME/.claude/skills/$folder" "$HOME/.claude/skills/"*"$folder"* >/dev/null 2>&1; then had "$repo ${skill:+($skill)}"; continue; fi
      args=(add "$repo" -a claude-code -g -y)
      [ -n "$skill" ] && args+=(--skill "$skill")
      if npx --yes skills "${args[@]}" </dev/null >/dev/null 2>&1; then did "$repo ${skill:+($skill)}"; else
        avail="$(npx --yes skills add "$repo" -l </dev/null 2>/dev/null | grep -oE '^[[:space:]]*- [a-z0-9._-]+' | tr -d ' -' | tr '\n' ' ')"
        fail "$repo ${skill:+($skill)}: npx skills ${args[*]}  (available: ${avail:-unknown})"; fi
    done < <(printf '%s\n' "$CLI_SKILLS" | sed '/^[[:space:]]*$/d')
    [ "$entries" -gt 0 ] || fail "skills CLI list is empty; nothing was checked"
  fi
fi

# 3. Playwright's own agent skill (run, debug, generate, heal, trace).
if [ "$skip_pw" -eq 1 ]; then skip "playwright-cli skill"; else
  if ls -d "$HOME/.claude/skills/playwright-cli"* >/dev/null 2>&1; then had "playwright-cli skill"; else
    if command -v npx >/dev/null && npx --yes @playwright/cli install --skills -g </dev/null >/dev/null 2>&1; then did "playwright-cli skill"; else skip "playwright-cli skill (npx @playwright/cli install --skills -g did not complete; optional)"; fi
  fi
fi

# 4. Pinned packs: each repository at the commit bin/pinned-packs.txt names.
#    A skill folder is copied with a .bearing-pack provenance file; a folder that
#    exists without one is someone else's and is left alone. A plugin row adds
#    the checkout as a local marketplace, so the plugin is pinned too.
PINNED="$(dirname "$0")/pinned-packs.txt"
CACHE="${BEARING_PACK_CACHE:-$HOME/.cache/bearing-packs}"
if [ "$skip_pin" -eq 1 ]; then skip "pinned packs"; else
  rows=0
  while IFS='|' read -r kind repo sha path name lic; do
    rows=$((rows+1))
    dir="$CACHE/$(printf '%s' "$repo" | tr '/' '_')@${sha:0:12}"
    if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$sha" ]; then
      rm -rf "$dir"; mkdir -p "$dir"
      if ! { git -C "$dir" init -q && git -C "$dir" remote add origin "https://github.com/$repo.git" \
             && git -C "$dir" fetch -q --depth 1 origin "$sha" && git -C "$dir" checkout -q FETCH_HEAD; } </dev/null >/dev/null 2>&1 \
         || [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$sha" ]; then
        fail "$name: could not fetch $repo at ${sha:0:12}"; continue
      fi
    fi
    if [ "$kind" = plugin ]; then
      plugin="${path%@*}"; market="${path#*@}"
      if claude plugin list 2>/dev/null | grep -q "$plugin@$market"; then had "$name ($repo, plugin)"; continue; fi
      claude plugin marketplace add "$dir" </dev/null >/dev/null 2>&1 || true
      if claude plugin install "$plugin@$market" </dev/null >/dev/null 2>&1; then did "$name ($repo@${sha:0:12}, plugin)"; else fail "$name: claude plugin install $plugin@$market (marketplace $dir)"; fi
      continue
    fi
    dest="$HOME/.claude/skills/$name"
    if [ -f "$dest/.bearing-pack" ] && grep -q "^commit=$sha\$" "$dest/.bearing-pack"; then had "$name ($repo)"; continue; fi
    if [ -e "$dest" ] && [ ! -f "$dest/.bearing-pack" ]; then skip "$name: $dest exists and is not from bearing"; continue; fi
    [ -f "$dir/$path/SKILL.md" ] || { fail "$name: no SKILL.md at $repo/$path"; continue; }
    rm -rf "$dest"; mkdir -p "$(dirname "$dest")"; cp -RL "$dir/$path" "$dest" || { fail "$name: copy failed (a link in $repo/$path does not resolve)"; continue; }
    # The installed name can differ from the folder's (testing-setup is too
    # generic beside other packs); the frontmatter name follows the folder.
    sed -i.bak "1,/^---\$/{s/^name:.*/name: $name/;}" "$dest/SKILL.md" 2>/dev/null; rm -f "$dest/SKILL.md.bak"
    printf 'repo=%s\ncommit=%s\npath=%s\nlicence=%s\n' "$repo" "$sha" "$path" "$lic" > "$dest/.bearing-pack"
    did "$name ($repo@${sha:0:12}, $lic)"
  done < <(grep -vE '^[[:space:]]*(#|$)' "$PINNED" 2>/dev/null)
  [ "$rows" -gt 0 ] || fail "pinned packs: $PINNED is missing or empty; nothing was checked"
  echo "pinned: $rows rows read from $(basename "$PINNED")"
fi

echo "packs: $installed installed, $present present, $failed failed"
echo "brg-install-packs: $installed installed, $present present, $skipped skipped, $failed failed. Restart Claude Code to load new skills."
[ "$failed" -eq 0 ] || exit 1
