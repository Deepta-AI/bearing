#!/usr/bin/env bash
# brg-adopt: bring an existing repository onto the standard without
# overwriting anything.
#
#   brg-adopt [--dir <path>] [--stack <id>] [--host gitlab|github|both]
#             [--lead @user] [--group @group] [--tracker PREFIX|none]
#             [--org com.example] [--kit-remote <url>]
#
# Defaults for --host, --tracker, --org and --kit-remote come from BEARING_GIT_HOST,
# BEARING_TASK_ID_PREFIX, BEARING_ORG_ID and BEARING_KIT_REMOTE in
# ~/.config/bearing/bearing.env; --host then falls back to the origin remote
# (github.com -> github, a gitlab host -> gitlab, anything else -> both).
# Explicit flags win. gitlab offers .gitlab-ci.yml and .gitlab/ only; github
# offers .github/ only; both offers both sets; a set the templates do not
# ship yet is noted. For every file the standard ships: missing -> added;
# identical -> kept; different -> written beside it as <file>.bearing-new and
# counted as a conflict. A core.hooksPath already set to another directory
# (Husky's .husky) is left unchanged and counted as a conflict, with the fix
# printed. Stack build files (Makefile, CI) are offered only
# when the repository has no Makefile: the stack's CI calls the stack
# Makefile's targets, so a repository keeping its own build keeps its own CI.
# The CLAUDE.md snapshot names the stack's stack, databases and entrypoint only
# when that entrypoint exists here; otherwise they are left to fill in.
set -euo pipefail
KIT="$(cd "$(dirname "$0")/.." && pwd)"
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
ENV_FILE="${BEARING_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/bearing/bearing.env}"
# ~/.config/bearing/bearing.env: KEY=value lines; a variable already set in the
# environment is never overridden. Supplies the defaults below.
load_env() {
  [ -f "$ENV_FILE" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    case "${line#"${line%%[![:space:]]*}"}" in ''|'#'*) continue;; esac
    case "$line" in *=*) ;; *) continue;; esac
    key="${line%%=*}"; key="${key//[[:space:]]/}"; val="${line#*=}"
    printf '%s' "$key" | grep -Eq '^[A-Z_][A-Z0-9_]*$' || continue
    val="${val#"${val%%[![:space:]]*}"}"
    case "$val" in
      \"*) val="${val#\"}"; val="${val%%\"*}";;
      \'*) val="${val#\'}"; val="${val%%\'*}";;
      *) val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}";;
    esac
    [ -n "${!key+x}" ] && continue
    export "$key=$val"
  done < "$ENV_FILE"
}
load_env

# sed_i FILE SED-ARGS...: in-place edit that works with BSD and GNU sed. Writes
# a temp file next to the original and moves it over, keeping the mode.
sed_i() {
  local f="$1" tmp mode; shift
  tmp="$(mktemp "$f.XXXXXX")"
  # GNU stat takes -c; BSD stat (macOS) takes -f. GNU's -f is something else
  # and succeeds, so the GNU form must be tried first.
  mode="$(stat -c '%a' "$f" 2>/dev/null || stat -f '%Lp' "$f" 2>/dev/null || echo 644)"
  sed "$@" "$f" > "$tmp" && chmod "$mode" "$tmp" && mv "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

dir="."; stack=""; lead="@lead"; group="@engineering"
tracker="${BEARING_TASK_ID_PREFIX:-}"; org="${BEARING_ORG_ID:-com.example}"
host="${BEARING_GIT_HOST:-}"; host_src="BEARING_GIT_HOST"
kit_remote="${BEARING_KIT_REMOTE:-$(git -C "$KIT" remote get-url origin 2>/dev/null || printf 'file://%s' "$KIT")}"
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) dir="$2"; shift 2;;
    --stack) stack="$2"; shift 2;;
    --host) host="$2"; host_src="--host"; shift 2;;
    --lead) lead="$2"; shift 2;;
    --group) group="$2"; shift 2;;
    --tracker) tracker="$2"; shift 2;;
    --org) org="$2"; shift 2;;
    --kit-remote) kit_remote="$2"; shift 2;;
    -h|--help) usage 0;;
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
dir="$(cd "$dir" && pwd)"
git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || { echo "$dir is not a git repository" >&2; exit 1; }

# Host: flag, env, then the origin remote, then both.
if [ -z "$host" ]; then
  origin="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  case "$origin" in
    *github.com*) host=github; host_src="origin remote";;
    *gitlab*) host=gitlab; host_src="origin remote";;
    *) host=both; host_src="default";;
  esac
fi
host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
case "$host" in gitlab|github|both) ;; *) echo "--host must be gitlab, github or both (got '$host')" >&2; exit 2;; esac
echo "host: $host ($host_src)"

slug="$(basename "$dir")"
name="$(python3 -c 'import re,sys; print(re.sub(r"(^|[-_])([a-z])", lambda m: m.group(2).upper(), sys.argv[1]))' "$slug")"
stage="$(mktemp -d "${TMPDIR:-/tmp}/brg-adopt.XXXXXX")"
trap 'rm -rf "$stage"' EXIT

# Build the desired tree in a staging dir: shared repo files, then stack rules.
cp -R "$KIT/templates/repo/." "$stage/"
stack_line=""; stack_type=""; stack_db=""; stack_entry=""; sd=""
if [ -n "$stack" ]; then
  sj=""
  for f in "$KIT"/skills/*/templates*/stack.json; do grep -q "\"id\": *\"$stack\"" "$f" && sj="$f" && break; done
  [ -n "$sj" ] || { echo "unknown stack '$stack'" >&2; exit 2; }
  sd="$(dirname "$sj")"; skd="$(dirname "$sd")"
  python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$sj" 2>/dev/null || { echo "$sj is not valid JSON" >&2; exit 1; }
  # jget KEY: one string value from stack.json (empty when absent or not a string).
  jget() { python3 -c 'import json,sys
v=json.load(open(sys.argv[1])).get(sys.argv[2],"")
print(v if isinstance(v,str) else "")' "$sj" "$1"; }
  for k in id type stack databases entrypoint rules_file; do
    [ -n "$(jget "$k")" ] || { echo "$sj: required key '$k' is missing or empty" >&2; exit 1; }
  done
  stack_line="$(jget stack)"; stack_type="$(jget type)"; stack_db="$(jget databases)"; stack_entry="$(jget entrypoint)"
  rules_file="$(jget rules_file)"
  # A python-cli adoption once wrote "uv + ruff + mypy" and src/app/cli.py into
  # the snapshot of a stdlib repository that had neither: the template describes
  # a layout, and only its entrypoint being here says this repository has it.
  entry_path="$(printf '%s' "${stack_entry%% *}" | sed -e "s|__REPO_SLUG__|$slug|g" -e "s|__REPO_NAME__|$name|g")"
  if [ ! -e "$dir/$entry_path" ]; then
    echo "note: $entry_path is not in this repository; the CLAUDE.md snapshot leaves stack, databases and entrypoint to fill in"
    stack_line=""; stack_db=""; stack_entry=""
  fi
  [ -f "$skd/references/rules.md" ] && cp "$skd/references/rules.md" "$stage/.claude/rules/$rules_file"
  # Offer stack build files only when the repo has none of them.
  own_build=0
  if [ ! -f "$dir/Makefile" ] && [ ! -f "$dir/makefile" ] && [ ! -f "$dir/GNUmakefile" ]; then cp "$sd/Makefile" "$stage/Makefile" 2>/dev/null || true
  else own_build=1; echo "note: the repository keeps its own Makefile, so the $stack CI (which calls the $stack Makefile's targets) is not offered"; fi
  [ "$own_build" -eq 1 ] || case "$host" in gitlab|both)
    if [ ! -f "$dir/.gitlab-ci.yml" ]; then
      if [ -f "$sd/.gitlab-ci.yml" ]; then cp "$sd/.gitlab-ci.yml" "$stage/.gitlab-ci.yml"; else echo "note: .gitlab-ci.yml is not in the $stack templates yet; skipped"; fi
    fi;;
  esac
  [ "$own_build" -eq 1 ] || case "$host" in github|both)
    if ! ls "$dir/.github/workflows"/*.yml >/dev/null 2>&1; then
      if [ -d "$sd/.github" ]; then mkdir -p "$stage/.github"; cp -R "$sd/.github/." "$stage/.github/"; else echo "note: .github/workflows/ci.yml is not in the $stack templates yet; skipped"; fi
    fi;;
  esac
fi
# Host filter on the staged tree.
case "$host" in
  gitlab) rm -rf "$stage/.github";;
  github) rm -rf "$stage/.gitlab-ci.yml" "$stage/.gitlab";;
esac
case "$host" in github|both) [ -d "$stage/.github" ] || echo "note: .github/ is not in the shared templates yet; skipped";; esac
case "$host" in gitlab|both) [ -d "$stage/.gitlab" ] || echo "note: .gitlab/ is not in the shared templates yet; skipped";; esac

# Placeholders in the staging tree.
escape() { printf '%s' "$1" | sed -e 's/[\/&|]/\\&/g'; }
if [ -n "$tracker" ] && [ "$tracker" != none ]; then tracker_label="$tracker-###"; else tracker_label="${BEARING_TRACKER:-none}"; fi
while IFS= read -r -d '' f; do
  grep -Iq . "$f" 2>/dev/null || continue
  sed_i "$f" -e "s|__REPO_NAME__|$(escape "$name")|g" -e "s|__REPO_SLUG__|$(escape "$slug")|g" \
    -e "s|__STACK__|$(escape "${stack_line:-fill in}")|g" -e "s|__REPO_TYPE__|$(escape "${stack_type:-fill in}")|g" \
    -e "s|__DATABASES__|$(escape "${stack_db:-fill in}")|g" -e "s|__ENTRYPOINT__|$(escape "${stack_entry:-fill in}")|g" \
    -e "s|__TRACKER__|$(escape "$tracker_label")|g" -e "s|__ORG_ID__|$(escape "$org")|g" -e "s|__KIT_REMOTE__|$(escape "$kit_remote")|g" -e "s|__LEAD__|$(escape "${lead#@}")|g" -e "s|__TEAM_GROUP__|$(escape "${group#@}")|g"
done < <(find "$stage" -type f -print0)

added=0; kept=0; conflicts=0; total=0
while IFS= read -r -d '' src; do
  rel="${src#"$stage"/}"
  total=$((total+1))
  case "$rel" in
    .gitignore.append)
      touch "$dir/.gitignore"
      if grep -q '^# Bearing' "$dir/.gitignore"; then kept=$((kept+1))
      else cat "$src" >> "$dir/.gitignore"; added=$((added+1)); echo "appended  .gitignore"; fi
      continue;;
  esac
  dst="$dir/$rel"
  if [ ! -e "$dst" ]; then
    mkdir -p "$(dirname "$dst")"; cp "$src" "$dst"; added=$((added+1)); echo "added     $rel"
  elif cmp -s "$src" "$dst"; then
    kept=$((kept+1))
  else
    cp "$src" "$dst.bearing-new"; conflicts=$((conflicts+1)); echo "conflict  $rel  (proposal at $rel.bearing-new)"
  fi
done < <(find "$stage" -type f -print0)

[ "$total" -gt 0 ] || { echo "0 files in the standard; the templates are missing" >&2; exit 1; }
chmod +x "$dir"/.githooks/commit-msg "$dir"/.githooks/pre-commit "$dir"/.githooks/pre-push "$dir"/.githooks/install.sh 2>/dev/null || true
# core.hooksPath: set it only when unset or already ours. Another value (Husky's
# .husky, a team's own directory) is a conflict like any file: left unchanged,
# reported with the two ways to wire the kit hooks in.
hooks_path="$(git -C "$dir" config --get core.hooksPath 2>/dev/null || true)"
case "${hooks_path%/}" in
  ''|.githooks|./.githooks|"$dir/.githooks")
    git -C "$dir" config core.hooksPath .githooks; hooks_note="core.hooksPath set";;
  *)
    conflicts=$((conflicts+1)); hooks_note="core.hooksPath left at $hooks_path: conflict"
    echo "conflict  core.hooksPath is $hooks_path; left unchanged, the kit hooks are written to .githooks/ but git does not run them"
    echo "          fix, either: chain them, adding one line to each hook in $hooks_path:"
    for h in commit-msg pre-commit pre-push; do
      echo "            $hooks_path/$h:  .githooks/$h \"\$@\" || exit \$?"
    done
    echo "          or: git -C \"$dir\" config core.hooksPath .githooks  (by hand; $hooks_path hooks then stop running)";;
esac

# The Stop gate blocks only when make check records a pass in
# .bearing/state/.check-passed; every stack template's check does. A
# repository's own Makefile gets that as a proposal, never an edit: one last
# recipe line in its check rule (make stops at the first failing line, so the
# last runs only when everything before it passed).
GATE_LINE='@mkdir -p .bearing/state && touch .bearing/state/.check-passed'
mk=""; for f in GNUmakefile makefile Makefile; do [ -f "$dir/$f" ] && { mk="$f"; break; }; done
if [ -n "$mk" ] && ! grep -q 'check-passed' "$dir/$mk"; then
  gate_rc=0
  python3 - "$dir/$mk" "$dir/$mk.bearing-new" "$GATE_LINE" <<'PY' || gate_rc=$?
import re, sys
src, dst, line = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(src).read().split("\n")
rules = [i for i, l in enumerate(lines) if re.match(r"check\s*:(?!:|=)", l)]
if not rules and not any(re.match(r"check\s*::", l) for l in lines):
    sys.exit(2)
if len(rules) != 1 or any(re.match(r"check\s*::", l) for l in lines):
    sys.exit(1)
i = rules[0]
while i < len(lines) - 1 and lines[i].rstrip().endswith("\\"):   # prerequisites over several lines
    i += 1
j = i + 1
while j < len(lines) and lines[j].startswith("\t"):              # the recipe, continuations included
    j += 1
lines.insert(j, "\t" + line)
open(dst, "w").write("\n".join(lines))
PY
  case "$gate_rc" in
    0) conflicts=$((conflicts+1))
       echo "conflict  $mk  (proposal at $mk.bearing-new: make check does not record a pass, so the Stop gate only reminds; the proposal adds one last recipe line to check)";;
    2) echo "note: $mk has no check target; the Stop gate only reminds until one exists (ci-pipeline adds the gate)";;
    *) echo "note: make check in $mk is not one rule this can extend; add this as the last recipe line of check so the Stop gate can block:"
       echo "          $GATE_LINE";;
  esac
fi

# CLAUDE.md import check, the most common miss.
if [ -f "$dir/CLAUDE.md" ] && ! head -1 "$dir/CLAUDE.md" | grep -q '^@AGENTS.md'; then
  echo "note: CLAUDE.md does not start with @AGENTS.md; add that line (a markdown link does not import)"
fi
echo "brg-adopt: $total files in standard (host $host): added $added, kept $kept, conflicts $conflicts ($hooks_note)"
