#!/usr/bin/env bash
# brg-harness: make a repository and a machine work with a coding harness
# other than Claude Code, from the same standard and the same guard logic.
#
#   brg-harness <harness> [--dir <repo>] [--kit-url <git url>] [--no-skills]
#
# Harnesses: cursor, codex, gemini, copilot, opencode, windsurf, cline, zed,
#            kiro, all
#
# Writes into the repository (idempotent; a file that exists with different
# content is left alone and the proposal goes to <file>.bearing-new):
#   every harness   .bearing/bin/brg-guard (the guard logic, vendored with the kit
#                   version stamped in, so hooks do not depend on where the
#                   kit is installed) and the hook adapters under .bearing/hooks/
#   cursor          .cursor/hooks.json, .cursor/rules/*.mdc from .claude/rules
#   codex           .codex/hooks.json, .codex/rules/bearing.rules (execpolicy)
#   gemini          .gemini/settings.json (BeforeTool hook, tools.exclude),
#                   GEMINI.md importing AGENTS.md
#   copilot         .github/hooks/bearing.json, .github/copilot-instructions.md,
#                   .github/instructions/brg-*.instructions.md (applyTo globs),
#                   .bearing/copilot-deny-tools.txt for the CLI
#   opencode        .opencode/plugins/brg-guard.js, opencode.json permissions
#   windsurf        .devin/hooks.json, .devin/rules/*.md (glob triggers)
#   cline           .clinerules/hooks/PreToolUse, .clinerules/brg-*.md (paths:)
#   zed             .zed/settings.json (tool_permissions deny), .rules pointer;
#                   Zed has no agent hooks, so no adapters by design
#   kiro            .kiro/hooks/brg-guard.json, .kiro/steering/brg-*.md,
#                   .bearing/kiro-permissions.yaml to merge at user level
# Every command policy (execpolicy, tools.exclude, always_deny, opencode
# permissions, the Kiro and Copilot lists) is derived from `brg-guard
# --verbs`, so the lists and the hook never drift. The policies are prefix
# matches and advisory; the hook adapter over brg-guard is the control.
# On the machine (unless --no-skills): installs the Bearing skills into that
# harness's skills folder through the skills CLI, from the kit's git remote.
#
# The git hooks in .githooks/ hold the push, commit and format rules on every
# harness; this script adds each harness's own adapters on top. The summary
# counts a harness as wired only when its config file references every
# adapter and neither has an unresolved .bearing-new; exit 1 when any selected
# harness is not wired. Harnesses whose hook format has been checked only
# against recorded fixtures (Copilot, Kiro, Windsurf, Codex, Cline, OpenCode)
# are marked unverified; Cursor and Gemini CLI have been run for real.
set -euo pipefail
KIT="$(cd "$(dirname "$0")/.." && pwd)"
harness="${1:-}"; [ -n "$harness" ] || { sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }; shift
dir="."; kit_url=""; skills=1
ENV_FILE="${BEARING_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/bearing/bearing.env}"
# ~/.config/bearing/bearing.env: KEY=value lines, parsed, never sourced (a
# value with spaces is a value, not a command); a variable already set in the
# environment is never overridden. The same parser as brg-tracker.
load_env() {
  [ -f "$ENV_FILE" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    case "${line#"${line%%[![:space:]]*}"}" in ''|'#'*) continue;; esac
    case "$line" in *=*) ;; *) continue;; esac
    key="${line%%=*}"; key="${key//[[:space:]]/}"; val="${line#*=}"
    printf '%s' "$key" | grep -Eq '^[A-Z_][A-Z0-9_]*$' || continue
    val="${val#"${val%%[![:space:]]*}"}"
    case "$val" in
      \"*) val="${val#\"}"; val="${val%%\"*}";;
      \'*) val="${val#\'}"; val="${val%%\'*}";;
      *) val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}";;
    esac
    [ -n "${!key+x}" ] && continue
    export "$key=$val"
  done < "$ENV_FILE"
}
load_env
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) dir="$2"; shift 2;;
    --kit-url) kit_url="$2"; shift 2;;
    --no-skills) skills=0; shift;;
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
dir="$(cd "$dir" && pwd)"
kit_url="${kit_url:-${BEARING_KIT_REMOTE:-$(git -C "$KIT" remote get-url origin 2>/dev/null || true)}}"
VERSION="$(tr -d '[:space:]' < "$KIT/VERSION" 2>/dev/null || true)"; VERSION="${VERSION:-0.0.0}"
TMPD="$(mktemp -d)"; trap 'rm -rf "$TMPD"' EXIT INT TERM HUP
written=0; kept=0; conflicts=0
put() { # put <relative path> [mode] < content   (never in a pipeline: counters)
  local rel="$1" mode="${2:-644}" dst tmp; dst="$dir/$rel"; tmp="$TMPD/put.$RANDOM.$RANDOM"; cat > "$tmp"
  mkdir -p "$(dirname "$dst")"
  if [ ! -e "$dst" ]; then mv "$tmp" "$dst"; chmod "$mode" "$dst"; written=$((written+1)); echo "written   $rel"
  elif cmp -s "$tmp" "$dst"; then rm -f "$tmp"; chmod "$mode" "$dst" 2>/dev/null || true; kept=$((kept+1))
  else mv "$tmp" "$dst.bearing-new"; chmod "$mode" "$dst.bearing-new"; conflicts=$((conflicts+1)); echo "conflict  $rel (proposal at $rel.bearing-new)"; fi
}
putx() { put "$1" 755; }
ptr() { pointer "$1" > "$TMPD/ptr"; put "$2" < "$TMPD/ptr"; }
pointer() {
  cat <<EOF
# $1

Read AGENTS.md at the repository root first. It is the engineering standard
for every coding agent here: ground rules, task flow, code rules, testing,
security, git and Merge Requests, definition of done, report format.

Then: \`make help\` for the commands, \`make check\` before claiming
completion, and the Bearing skills installed for this harness. The git hooks
in .githooks/ enforce commit shape, formatting and the rule that a person,
not the agent, pushes.
EOF
}
# Rules conversion helpers: globs and body from .claude/rules/<name>.md.
# paths: may be a block list (- "x", - 'x', - x, any indentation) or an
# inline list (paths: ["a", "b"]). An empty result is reported, not hidden.
rule_globs() {
  local g
  g="$(awk '
    /^---[[:space:]]*$/ { fm++; if (fm >= 2) exit; next }
    fm < 1 { next }
    /^[[:space:]]*paths:[[:space:]]*\[/ {
      s = $0; sub(/^[^[]*\[/, "", s); sub(/\][^]]*$/, "", s); n = split(s, a, ",")
      for (i = 1; i <= n; i++) { x = a[i]; gsub(/^[[:space:]"'"'"']+|[[:space:]"'"'"']+$/, "", x); if (x != "") out = out (out ? "," : "") x }
      f = 0; next }
    /^[[:space:]]*paths:[[:space:]]*$/ { f = 1; next }
    f && /^[[:space:]]*-[[:space:]]*/ { x = $0; sub(/^[[:space:]]*-[[:space:]]*/, "", x); gsub(/^[[:space:]"'"'"']+|[[:space:]"'"'"']+$/, "", x); if (x != "") out = out (out ? "," : "") x; next }
    f { f = 0 }
    END { printf "%s", out }' "$1")"
  [ -n "$g" ] || echo "brg-harness: warning: no paths: globs found in ${1#"$dir"/}; the converted rule has an empty glob list" >&2
  printf '%s' "$g"
}
rule_body()  { awk 'BEGIN{c=0} /^---$/{c++;next} c>=2{print}' "$1"; }

# The verb table and the prefixes derived from it (tool plus leading words,
# plus trailing --long flags; rules that need a flag cluster or a path test
# cannot be a prefix and stay with the hook).
VERBS="$(bash "$KIT/bin/brg-guard" --verbs)"
[ -n "$VERBS" ] || { echo "brg-harness: brg-guard --verbs printed nothing" >&2; exit 1; }
verb_prefixes() {
  printf '%s\n' "$VERBS" | awk -F'\t' '
    { tool = $1; out = tool; ok = 1; words = 1; n = split($2, t, " ")
      if (n == 0) { print out; next }
      if (t[1] == "*") { print out; next }
      for (i = 1; i <= n; i++) {
        tk = t[i]
        if (tk ~ /^--/) { words = 0; out = out " " tk; continue }
        if (tk ~ /^[~@-]/ || tk == "*") { ok = 0; break }
        if (!words) { ok = 0; break }
        sub(/\*$/, "", tk); out = out " " tk
      }
      if (ok) print out }' | awk '!seen[$0]++'
}
PREFIXES="$(verb_prefixes)"
NPREFIX="$(printf '%s\n' "$PREFIXES" | grep -c . || true)"
[ "$NPREFIX" -gt 0 ] || { echo "brg-harness: no command prefixes derived from brg-guard --verbs" >&2; exit 1; }

# 0. Vendor the guard (version stamped) and the adapter scripts every hook format calls.
vendor_guard() {
  sed "s/^BEARING_GUARD_VERSION=\"__VERSION__\"/BEARING_GUARD_VERSION=\"$VERSION\"/" "$KIT/bin/brg-guard" > "$TMPD/guard"
  putx ".bearing/bin/brg-guard" < "$TMPD/guard"
  putx ".bearing/hooks/read-json.sh" <<'EOF'
#!/usr/bin/env bash
# read-json.sh <dot.path> [<dot.path> ...]: print the first non-empty field of
# the JSON on stdin. jq is required: without it the sentinel __BRG_UNPARSED__
# is printed and brg-guard refuses the command (fail closed). Invalid JSON or
# a missing key prints nothing, which the guard also refuses. A step that
# lands on a string holding JSON is decoded before descending (Copilot CLI may
# send toolArgs as a JSON string; the hooks docs show an object); a string
# that is not JSON, or a non-object, ends the walk with nothing.
j="$(cat)"
if ! command -v jq >/dev/null 2>&1; then echo "bearing: jq is required by the hooks; install jq" >&2; printf '%s' "__BRG_UNPARSED__"; exit 0; fi
for p in "$@"; do
  v="$(printf '%s' "$j" | jq -r --arg p "$p" 'reduce ($p | split("."))[] as $k (.;
    (if type == "string" then (fromjson? // null) else . end)
    | if type == "object" then .[$k] else null end) // empty' 2>/dev/null)" || v=""
  [ -z "$v" ] || { printf '%s' "$v"; exit 0; }
done
exit 0
EOF
}
adapter_shell() { # adapter_shell <name> <deny-output mode> <json path of the command>...
  local name="$1" mode="$2"; shift 2
  local paths="$*"
  putx ".bearing/hooks/$name" <<EOF
#!/usr/bin/env bash
# $name: block publishing, history rewriting, deploy and destructive commands ($mode).
# A command that cannot be read (no jq, bad JSON, missing key) is refused: fail closed.
here="\$(cd "\$(dirname "\$0")/.." && pwd)"
cmd="\$(cat | bash "\$here/hooks/read-json.sh" $paths)"
if msg="\$(bash "\$here/bin/brg-guard" command "\$cmd" 2>&1)"; then
  case "$mode" in cursor) printf '{"permission":"allow"}\n';; esac
  exit 0
fi
q="\$(printf '%s' "\$msg" | jq -R . 2>/dev/null || printf '"%s"' "\$msg")"
case "$mode" in
  cursor)  printf '{"permission":"deny","user_message":%s,"agent_message":%s}\n' "\$q" "\$q"; exit 0;;
  gemini)  printf '{"decision":"deny","reason":%s}\n' "\$q";;
  copilot) printf '{"permissionDecision":"deny","permissionDecisionReason":%s}\n' "\$q";;
  cline)   printf '{"cancel":true,"errorMessage":%s}\n' "\$q";;
  *)       echo "\$msg" >&2;;
esac
exit 2
EOF
}
adapter_format() { # adapter_format <name> <json path of the file>
  putx ".bearing/hooks/$1" <<EOF
#!/usr/bin/env bash
# $1: format the file that was just edited, with the repository's formatter.
here="\$(cd "\$(dirname "\$0")/.." && pwd)"
f="\$(cat | bash "\$here/hooks/read-json.sh" $2)"
exec bash "\$here/bin/brg-guard" format "\$f"
EOF
}
adapter_plain() { # adapter_plain <name> <brg-guard subcommand>
  putx ".bearing/hooks/$1" <<EOF
#!/usr/bin/env bash
here="\$(cd "\$(dirname "\$0")/.." && pwd)"
cat >/dev/null; exec bash "\$here/bin/brg-guard" $2
EOF
}
adapter_gates() { # adapter_gates <cursor|codex>: session, stop, edit check and precompact over the guard's gates
  local h="$1"
  if [ "$h" = cursor ]; then
    putx ".bearing/hooks/cursor-session.sh" <<'EOF'
#!/usr/bin/env bash
# cursor-session.sh (sessionStart): the guard's session report as
# additional_context, and the session start mark stop-gate reads.
here="$(cd "$(dirname "$0")/.." && pwd)"
j="$(cat)"
id="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" conversation_id session_id)"
out="$(bash "$here/bin/brg-guard" session --id "$id" 2>/dev/null)"
if command -v jq >/dev/null 2>&1; then jq -n --arg c "$out" '{additional_context: $c}'; else echo '{}'; fi
EOF
    putx ".bearing/hooks/cursor-stop.sh" <<'EOF'
#!/usr/bin/env bash
# cursor-stop.sh (stop): when files this conversation changed have not
# passed make check, continue the agent once with the reason as the next
# message (followup_message); from loop_count 1 on it only reminds.
here="$(cd "$(dirname "$0")/.." && pwd)"
j="$(cat)"
id="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" conversation_id session_id)"
loops="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" loop_count)"
set -- --id "$id"; case "$loops" in ''|0|__BRG_UNPARSED__) ;; *) set -- "$@" --active;; esac
err="$(mktemp)"; bash "$here/bin/brg-guard" stop-gate "$@" >/dev/null 2>"$err"; rc=$?
if [ "$rc" -eq 2 ] && command -v jq >/dev/null 2>&1; then jq -n --arg r "$(cat "$err")" '{followup_message: $r}'; else echo '{}'; fi
rm -f "$err"
EOF
    putx ".bearing/hooks/cursor-check.sh" <<'EOF'
#!/usr/bin/env bash
# cursor-check.sh (postToolUse, Write): lint the file just written and hand
# the problems to the agent as additional_context.
here="$(cd "$(dirname "$0")/.." && pwd)"
f="$(cat | bash "$here/hooks/read-json.sh" tool_input.file_path tool_input.path file_path)"
err="$(mktemp)"; bash "$here/bin/brg-guard" check-file "$f" >/dev/null 2>"$err"; rc=$?
if [ "$rc" -eq 2 ] && command -v jq >/dev/null 2>&1; then jq -n --arg r "$(cat "$err")" '{additional_context: $r}'; else echo '{}'; fi
rm -f "$err"
EOF
  else
    putx ".bearing/hooks/codex-session.sh" <<'EOF'
#!/usr/bin/env bash
# codex-session.sh (SessionStart, every source): the guard's session report;
# on source compact it includes the snapshot codex-precompact.sh wrote.
here="$(cd "$(dirname "$0")/.." && pwd)"
j="$(cat)"
id="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" session_id)"
src="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" source)"
exec bash "$here/bin/brg-guard" session --id "$id" --source "$src"
EOF
    putx ".bearing/hooks/codex-stop.sh" <<'EOF'
#!/usr/bin/env bash
# codex-stop.sh (Stop): {"decision": "block"} once when files this session
# changed have not passed make check; stop_hook_active only reminds. Codex
# wants JSON on stdout for exit 0, so every other outcome prints {}.
here="$(cd "$(dirname "$0")/.." && pwd)"
j="$(cat)"
id="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" session_id)"
set -- --id "$id"
[ "$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" stop_hook_active)" = "true" ] && set -- "$@" --active
err="$(mktemp)"; bash "$here/bin/brg-guard" stop-gate "$@" >/dev/null 2>"$err"; rc=$?
if [ "$rc" -eq 2 ] && command -v jq >/dev/null 2>&1; then jq -n --arg r "$(cat "$err")" '{decision: "block", reason: $r}'; else echo '{}'; fi
rm -f "$err"
EOF
    putx ".bearing/hooks/codex-edit.sh" <<'EOF'
#!/usr/bin/env bash
# codex-edit.sh (PostToolUse, apply_patch): format and lint every file the
# patch adds or updates; problems go back as {"decision": "block"}.
here="$(cd "$(dirname "$0")/.." && pwd)"
patch="$(cat | bash "$here/hooks/read-json.sh" tool_input.command tool_input.input)"
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
problems=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in /*) ;; *) f="$root/$f";; esac
  bash "$here/bin/brg-guard" format "$f" >/dev/null 2>&1
  e="$(bash "$here/bin/brg-guard" check-file "$f" 2>&1 >/dev/null)" || problems="$problems${problems:+
}$e"
done <<LIST
$(printf '%s\n' "$patch" | sed -n 's/^\*\*\* Add File: //p; s/^\*\*\* Update File: //p; s/^\*\*\* Move to: //p')
LIST
if [ -n "$problems" ] && command -v jq >/dev/null 2>&1; then jq -n --arg r "$problems" '{decision: "block", reason: $r}'; fi
exit 0
EOF
    putx ".bearing/hooks/codex-precompact.sh" <<'EOF'
#!/usr/bin/env bash
# codex-precompact.sh (PreCompact): write the snapshot SessionStart (compact)
# reads back. Codex ignores plain stdout here, so nothing is printed.
here="$(cd "$(dirname "$0")/.." && pwd)"
t="$(cat | bash "$here/hooks/read-json.sh" transcript_path)"
bash "$here/bin/brg-guard" precompact "$t" >/dev/null 2>&1
exit 0
EOF
  fi
}
install_skills() {
  [ "$skills" -eq 1 ] || { echo "skills: skipped"; return; }
  local agent="$1"
  [ -n "$kit_url" ] || { echo "skills: no kit remote known; pass --kit-url or set BEARING_KIT_REMOTE"; return; }
  command -v npx >/dev/null || { echo "skills: npx not found"; return; }
  if npx --yes skills add "$kit_url" --all -a "$agent" -g -y </dev/null >/dev/null 2>&1; then echo "skills: Bearing skills installed for $agent"; else echo "skills: install failed; run: npx skills add $kit_url --all -a $agent -g -y"; fi
}

h_cursor() {
  vendor_guard; adapter_shell cursor-shell.sh cursor command; adapter_format cursor-edit.sh file_path; adapter_gates cursor
  put ".cursor/hooks.json" <<'EOF'
{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "./.bearing/hooks/cursor-session.sh" }],
    "beforeShellExecution": [{ "command": "./.bearing/hooks/cursor-shell.sh", "timeout": 10 }],
    "afterFileEdit": [{ "command": "./.bearing/hooks/cursor-edit.sh", "timeout": 30 }],
    "postToolUse": [{ "command": "./.bearing/hooks/cursor-check.sh", "matcher": "Write", "timeout": 60 }],
    "stop": [{ "command": "./.bearing/hooks/cursor-stop.sh", "loop_limit": 2 }]
  }
}
EOF
  local n=0
  for r in "$dir"/.claude/rules/*.md; do
    [ -f "$r" ] || continue; local name; name="$(basename "$r" .md)"
    put ".cursor/rules/brg-$name.mdc" <<EOF
---
description: Bearing $name rules (from .claude/rules/$name.md)
globs: $(rule_globs "$r")
alwaysApply: false
---
$(rule_body "$r")
EOF
    n=$((n+1))
  done
  put ".cursor/rules/brg-agents.mdc" <<'EOF'
---
description: The engineering standard for this repository (AGENTS.md)
alwaysApply: true
---
Read AGENTS.md at the repository root at the start of every task and follow
it. Use the Bearing skills for the step when one exists. Never push, merge or
deploy; prepare and print the command. make check before claiming done.
EOF
  echo "cursor: hooks.json (shell deny as permission JSON, edit format and check, session, stop gate), $n stack rule(s) converted"
  install_skills cursor
}
h_codex() {
  vendor_guard; adapter_shell codex-pretool.sh codex tool_input.command tool_input.cmd; adapter_gates codex
  put ".codex/hooks.json" <<'EOF'
{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "./.bearing/hooks/codex-session.sh", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "./.bearing/hooks/codex-pretool.sh", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "apply_patch", "hooks": [{ "type": "command", "command": "./.bearing/hooks/codex-edit.sh", "timeout": 60 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "./.bearing/hooks/codex-precompact.sh", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "./.bearing/hooks/codex-stop.sh", "timeout": 15 }] }]
  }
}
EOF
  {
    echo "# Codex execpolicy rules written by Bearing from brg-guard --verbs (trusted projects only)."
    echo "# Most restrictive decision wins. The engineer pushes, merges and deploys; the agent prepares."
    echo "# Prefix rules cannot see wrappers (sudo, env, sh -c, git -C); the PreToolUse hook over"
    echo "# .bearing/bin/brg-guard is the control and this file is the first line."
    printf '%s\n' "$PREFIXES" | awk '{ s = ""; for (i = 1; i <= NF; i++) s = s (i > 1 ? ", " : "") "\"" $i "\""
      print "prefix_rule(pattern = [" s "], decision = \"forbidden\", justification = \"the engineer runs this; prepare and print the command\")" }'
  } > "$TMPD/codex.rules"
  put ".codex/rules/bearing.rules" < "$TMPD/codex.rules"
  echo "codex: hooks.json (PreToolUse deny, session with compact restore, edit check, precompact, stop gate), rules/bearing.rules execpolicy ($NPREFIX prefix rules); approval_policy stays yours in ~/.codex/config.toml"
  install_skills codex
}
h_gemini() {
  vendor_guard; adapter_shell gemini-pretool.sh gemini tool_input.command tool_input.cmd; adapter_plain gemini-session.sh session
  local excl; excl="$(printf '%s\n' "$PREFIXES" | awk '{ printf "%s\"run_shell_command(%s)\"", (NR > 1 ? ", " : ""), $0 }')"
  {
    echo '{'
    echo '  "context": { "fileName": ["AGENTS.md", "GEMINI.md"] },'
    echo "  \"tools\": { \"exclude\": [$excl] },"
    echo '  "hooks": {'
    echo '    "SessionStart": [{ "hooks": [{ "name": "brg-session", "type": "command", "command": "bash ./.bearing/hooks/gemini-session.sh", "timeout": 10000 }] }],'
    echo '    "BeforeTool": [{ "matcher": "run_shell_command", "hooks": [{ "name": "brg-guard", "type": "command", "command": "bash ./.bearing/hooks/gemini-pretool.sh", "timeout": 10000 }] }]'
    echo '  }'
    echo '}'
  } > "$TMPD/gemini.json"
  put ".gemini/settings.json" < "$TMPD/gemini.json"
  put "GEMINI.md" <<'EOF'
@./AGENTS.md

# GEMINI.md

The standard above is imported from AGENTS.md. `make help` for the
commands, `make check` before claiming completion, the Bearing skills for
the steps. The git hooks enforce that a person pushes. The `tools.exclude`
entries in `.gemini/settings.json` are exact-match and advisory; the
BeforeTool hook over `.bearing/bin/brg-guard` is the control.
EOF
  echo "gemini: settings.json (BeforeTool deny is the control; tools.exclude lists $NPREFIX exact-match advisory entries; AGENTS.md as context file), GEMINI.md imports AGENTS.md"
  install_skills gemini-cli
}
h_copilot() {
  vendor_guard; adapter_shell copilot-pretool.sh copilot toolArgs.command toolArgs.cmd tool_input.command; adapter_plain copilot-session.sh session
  put ".github/hooks/bearing.json" <<'EOF'
{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "type": "command", "bash": "./.bearing/hooks/copilot-session.sh", "timeoutSec": 10 }],
    "preToolUse": [{ "type": "command", "bash": "./.bearing/hooks/copilot-pretool.sh", "matcher": "bash", "timeoutSec": 10 }]
  }
}
EOF
  ptr "Copilot instructions" ".github/copilot-instructions.md"
  local n=0
  for r in "$dir"/.claude/rules/*.md; do
    [ -f "$r" ] || continue; local name; name="$(basename "$r" .md)"
    put ".github/instructions/brg-$name.instructions.md" <<EOF
---
applyTo: "$(rule_globs "$r")"
---
$(rule_body "$r")
EOF
    n=$((n+1))
  done
  {
    echo "# Copilot CLI deny list derived from brg-guard --verbs (prefix matches; the preToolUse hook is the control)."
    echo "# Use: copilot \$(grep -v '^#' .bearing/copilot-deny-tools.txt | tr '\\n' ' ')"
    printf '%s\n' "$PREFIXES" | awk '{ print "--deny-tool \x27shell(" $0 ")\x27" }'
  } > "$TMPD/copilot.txt"
  put ".bearing/copilot-deny-tools.txt" < "$TMPD/copilot.txt"
  echo "copilot: hooks/bearing.json (preToolUse deny, session), copilot-instructions.md, $n path-scoped instruction file(s); CLI users add the $NPREFIX --deny-tool flags in .bearing/copilot-deny-tools.txt"
  install_skills github-copilot
}
h_opencode() {
  vendor_guard
  put ".opencode/plugins/brg-guard.js" <<'EOF'
// Bearing guard for OpenCode: throws before a shell command that publishes,
// rewrites history, deploys or destroys. The logic lives in .bearing/bin/brg-guard,
// found from this file's location (repo root is two levels up) with the
// working directory as the fallback. An unreadable command is refused.
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
let root = process.cwd();
try {
  const here = fileURLToPath(new URL("../../", import.meta.url));
  if (existsSync(join(here, ".bearing", "bin", "brg-guard"))) root = here;
} catch (e) { /* keep the working directory */ }
const guard = join(root, ".bearing", "bin", "brg-guard");
export const BearingGuard = async () => ({
  "tool.execute.before": async (input, output) => {
    if (input.tool !== "bash") return;
    const args = (input && input.args) || (output && output.args) || {};
    const cmd = args.command || args.cmd || "";
    try { execFileSync("bash", [guard, "command", cmd], { cwd: root, stdio: ["ignore", "ignore", "pipe"] }); }
    catch (e) { throw new Error(String((e && e.stderr) || "Bearing blocked this command; the engineer runs it")); }
  },
});
EOF
  local denies; denies="$(printf '%s\n' "$PREFIXES" | awk '{ printf ",\n    \"%s*\": \"deny\"", $0 }')"
  {
    echo '{'
    echo '  "$schema": "https://opencode.ai/config.json",'
    echo '  "instructions": ["AGENTS.md"],'
    echo '  "permission": { "bash": {'
    echo '    "*": "ask", "make *": "allow", "git status*": "allow", "git diff*": "allow", "git log*": "allow"'"$denies"
    echo '  } }'
    echo '}'
  } > "$TMPD/opencode.json"
  put "opencode.json" < "$TMPD/opencode.json"
  echo "opencode: plugins/brg-guard.js (tool.execute.before is the control), opencode.json permissions ($NPREFIX prefix denies, advisory)"
  install_skills opencode
}
h_windsurf() {
  vendor_guard; adapter_shell windsurf-run.sh windsurf tool_info.command_line tool_info.command
  put ".devin/hooks.json" <<'EOF'
{ "hooks": { "pre_run_command": [{ "command": "bash ./.bearing/hooks/windsurf-run.sh", "show_output": true }] } }
EOF
  put ".devin/rules/brg-agents.md" <<'EOF'
---
trigger: always_on
---
Read AGENTS.md at the repository root and follow it. Use the Bearing skills for
the step when one exists. Never push, merge or deploy; prepare and print the
command. make check before claiming done.
EOF
  local n=0
  for r in "$dir"/.claude/rules/*.md; do
    [ -f "$r" ] || continue; local name; name="$(basename "$r" .md)"
    put ".devin/rules/brg-$name.md" <<EOF
---
trigger: glob
globs: $(rule_globs "$r")
---
$(rule_body "$r")
EOF
    n=$((n+1))
  done
  ptr "Windsurf rules (legacy file; .devin/rules is the current location)" ".windsurfrules"
  echo "windsurf (Devin Desktop): hooks.json (pre_run_command exit 2), $n glob rule(s), always-on rule"
  install_skills windsurf
}
h_cline() {
  vendor_guard
  putx ".clinerules/hooks/PreToolUse" <<'EOF'
#!/usr/bin/env bash
# Cline PreToolUse: cancel a shell command that publishes, rewrites history,
# deploys or destroys. A command that cannot be read is cancelled (fail closed).
here="$(cd "$(dirname "$0")/../.." && pwd)/.bearing"
j="$(cat)"
tool="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" preToolUse.toolName toolName tool_name)"
case "$tool" in execute_command|bash|shell|__BRG_UNPARSED__|"") ;; *) exit 0;; esac
cmd="$(printf '%s' "$j" | bash "$here/hooks/read-json.sh" preToolUse.parameters.command preToolUse.parameters.cmd preToolUse.toolInput.command parameters.command tool_input.command)"
if msg="$(bash "$here/bin/brg-guard" command "$cmd" 2>&1)"; then exit 0; fi
printf '{"cancel":true,"errorMessage":%s}\n' "$(printf '%s' "$msg" | jq -R . 2>/dev/null || printf '"%s"' "$msg")"
EOF
  ptr "Cline rules" ".clinerules/bearing.md"
  local n=0
  for r in "$dir"/.claude/rules/*.md; do
    [ -f "$r" ] || continue; local name; name="$(basename "$r" .md)"
    put ".clinerules/brg-$name.md" <<EOF
---
paths: [$(rule_globs "$r" | sed 's/,/", "/g; s/^/"/; s/$/"/')]
---
$(rule_body "$r")
EOF
    n=$((n+1))
  done
  echo "cline: hooks/PreToolUse (cancel), $n path-scoped rule(s), pointer rule"
  install_skills cline
}
h_zed() {
  local pats; pats="$(printf '%s\n' "$PREFIXES" | awk '
    { re = "\\\\b"
      for (i = 1; i <= NF; i++) {
        w = $i; gsub(/\./, "[.]", w)
        if (w ~ /^--/) re = re "(\\\\s+\\\\S+)*\\\\s+" w
        else re = re (i > 1 ? "\\\\s+" : "") w }
      re = re "\\\\b"
      printf "%s{ \"pattern\": \"%s\" }", (NR > 1 ? ", " : ""), re }')"
  {
    echo '{'
    echo '  "agent": {'
    echo '    "tool_permissions": {'
    echo '      "default": "confirm",'
    echo "      \"tools\": { \"terminal\": { \"always_deny\": [ $pats ] } }"
    echo '    }'
    echo '  }'
    echo '}'
  } > "$TMPD/zed.json"
  put ".zed/settings.json" < "$TMPD/zed.json"
  ptr "Zed rules" ".rules"
  echo "zed: settings.json tool_permissions ($NPREFIX always_deny patterns from brg-guard --verbs; regex on the command text, no wrapper awareness), .rules pointer; Zed has no agent hooks, so no adapters"
  install_skills zed
}
h_kiro() {
  vendor_guard; adapter_shell kiro-pretool.sh kiro tool_input.command tool_input.cmd
  put ".kiro/hooks/brg-guard.json" <<'EOF'
{ "version": "v1", "hooks": [ { "name": "brg-guard", "trigger": "PreToolUse", "matcher": "shell", "action": { "type": "command", "command": "bash ./.bearing/hooks/kiro-pretool.sh" } } ] }
EOF
  put ".kiro/steering/bearing.md" <<'EOF'
---
inclusion: always
---
Read AGENTS.md at the repository root and follow it. Use the Bearing skills for
the step when one exists. Never push, merge or deploy; prepare and print the
command. make check before claiming done.
EOF
  local n=0
  for r in "$dir"/.claude/rules/*.md; do
    [ -f "$r" ] || continue; local name; name="$(basename "$r" .md)"
    put ".kiro/steering/brg-$name.md" <<EOF
---
inclusion: fileMatch
fileMatchPattern: "$(rule_globs "$r")"
---
$(rule_body "$r")
EOF
    n=$((n+1))
  done
  {
    echo "# Kiro permissions proposal derived from brg-guard --verbs. permissions.yaml is"
    echo "# user level: merge these entries into ~/.kiro/permissions.yaml. Prefix matches"
    echo "# only; the PreToolUse hook over .bearing/bin/brg-guard is the control."
    echo "permissions:"
    printf '%s\n' "$PREFIXES" | awk '{ print "  - capability: shell\n    match: \"" $0 "*\"\n    effect: deny" }'
  } > "$TMPD/kiro.yaml"
  put ".bearing/kiro-permissions.yaml" < "$TMPD/kiro.yaml"
  echo "kiro: hooks/brg-guard.json (PreToolUse exit 2), always steering, $n fileMatch steering file(s); merge the $NPREFIX entries in .bearing/kiro-permissions.yaml into ~/.kiro/permissions.yaml"
  install_skills kiro-cli
}
# The control files each harness must end up with (adapters); zed has none by design.
adapters_of() {
  case "$1" in
    cursor) echo ".bearing/hooks/cursor-shell.sh .bearing/hooks/cursor-edit.sh .bearing/hooks/cursor-check.sh .bearing/hooks/cursor-session.sh .bearing/hooks/cursor-stop.sh";;
    codex) echo ".bearing/hooks/codex-pretool.sh .bearing/hooks/codex-session.sh .bearing/hooks/codex-edit.sh .bearing/hooks/codex-precompact.sh .bearing/hooks/codex-stop.sh";;
    gemini) echo ".bearing/hooks/gemini-pretool.sh .bearing/hooks/gemini-session.sh";;
    copilot) echo ".bearing/hooks/copilot-pretool.sh .bearing/hooks/copilot-session.sh";;
    opencode) echo ".opencode/plugins/brg-guard.js";;
    windsurf) echo ".bearing/hooks/windsurf-run.sh";;
    cline) echo ".clinerules/hooks/PreToolUse";;
    kiro) echo ".bearing/hooks/kiro-pretool.sh";;
    zed) echo "";;
  esac
}
do_one() {
  case "$1" in
    cursor) h_cursor;; codex) h_codex;; gemini) h_gemini;; copilot) h_copilot;; opencode) h_opencode;;
    windsurf) h_windsurf;; cline) h_cline;; zed) h_zed;; kiro) h_kiro;;
    *) echo "unknown harness: $1" >&2; exit 2;;
  esac
}
if [ "$harness" = "all" ]; then list="cursor codex gemini copilot opencode windsurf cline zed kiro"; else list="$harness"; fi
# The config file the harness reads, which must reference each adapter. For
# OpenCode and Cline the adapter is the file the harness discovers, so it is
# its own config and must call the vendored guard.
config_of() {
  case "$1" in
    cursor) echo ".cursor/hooks.json";; codex) echo ".codex/hooks.json";; gemini) echo ".gemini/settings.json";;
    copilot) echo ".github/hooks/bearing.json";; opencode) echo ".opencode/plugins/brg-guard.js";;
    windsurf) echo ".devin/hooks.json";; cline) echo ".clinerules/hooks/PreToolUse";; kiro) echo ".kiro/hooks/brg-guard.json";;
    zed) echo ".zed/settings.json";;
  esac
}
needle_of() { # needle_of <harness> <adapter>: the text the config must contain
  case "$1" in
    opencode) echo '".bearing", "bin", "brg-guard"';; cline) echo 'bin/brg-guard';; *) echo "$2";;
  esac
}
# Hook formats not yet exercised against the real tool (fixtures only); see
# skills/harness-setup/references/harness-matrix.md. Cursor and Gemini CLI have been.
unverified_of() { case "$1" in copilot|kiro|windsurf|codex|cline|opencode) return 0;; *) return 1;; esac; }
for h in $list; do do_one "$h"; done
# Wired means: the config exists, has no unresolved .bearing-new beside it, and
# references every adapter, and every adapter exists without an .bearing-new. A
# config left as a conflict is not wired, whatever files exist.
summary=""; notwired=0; checked=0; unverified=""
for h in $list; do
  checked=$((checked+1))
  cfg="$(config_of "$h")"; why=""
  [ -f "$dir/$cfg" ] || why="no $cfg"
  [ ! -e "$dir/$cfg.bearing-new" ] || why="${why:+$why; }conflict at $cfg.bearing-new"
  unverified_of "$h" && unverified="$unverified${unverified:+, }$h"
  expected="$(adapters_of "$h")"
  if [ -z "$expected" ]; then
    [ -n "$why" ] || grep -q 'always_deny' "$dir/$cfg" || why="$cfg has no always_deny"
    if [ -z "$why" ]; then summary="$summary${summary:+, }$h: settings only, no adapters"
    else summary="$summary${summary:+, }$h: settings NOT wired ($why)"; notwired=$((notwired+1)); fi
    continue
  fi
  have=0; want=0
  for f in $expected; do
    want=$((want+1))
    if [ ! -e "$dir/$f" ]; then why="${why:+$why; }no $f"
    elif [ -e "$dir/$f.bearing-new" ] && [ "$f" != "$cfg" ]; then why="${why:+$why; }conflict at $f.bearing-new"
    elif [ ! -f "$dir/$cfg" ] || ! grep -qF "$(needle_of "$h" "$f")" "$dir/$cfg"; then why="${why:+$why; }$cfg does not reference $f"
    else have=$((have+1)); fi
  done
  tag=""; unverified_of "$h" && tag=", hook format unverified"
  if [ -z "$why" ]; then summary="$summary${summary:+, }$h: $have of $want adapters wired$tag"
  else summary="$summary${summary:+, }$h: $have of $want adapters referenced, NOT wired ($why)$tag"; notwired=$((notwired+1)); fi
done
echo "brg-harness: $written written, $kept kept, $conflicts conflicts in $dir"
echo "adapters: $summary"
[ -z "$unverified" ] || echo "unverified: $unverified (hook format checked against recorded fixtures only, not the real tool; see references/harness-matrix.md)"
[ "$checked" -gt 0 ] || { echo "brg-harness: 0 harnesses checked" >&2; exit 1; }
echo "brg-harness: $checked harness(es) checked, $((checked-notwired)) wired"
[ "$notwired" -eq 0 ] || { echo "brg-harness: $notwired harness(es) not wired; resolve the .bearing-new files (diff, then take ours or merge) and run again" >&2; exit 1; }
