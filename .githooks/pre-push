#!/usr/bin/env bash
# .githooks/pre-push for the Bearing repository itself (make hooks installs
# it). It checks; it never runs the gate. git opens the connection to the
# remote before this hook, and GitHub closes it long before a 15-minute gate
# ends, so a gate run here made the push fail even when the gate passed. The
# gate runs first instead: `make push` (the gate on this commit, then the
# push; FORCE=1 adds --force-with-lease) or `make gate`, then git push.
#
# Every commit being pushed (a branch tip, or the commit a tag points at) must
# be one `make gate` passed on, as bin/gate-mark records them; deleting a
# remote ref needs none. Otherwise the push is refused at once and nothing is
# sent. The macos and scaffold jobs run only in CI.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
n=0; missing=""
while read -r lref lsha rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$zero" ] && continue
  n=$((n+1))
  bash bin/gate-mark has "$lsha" || missing="$missing ${lsha:0:7} (${lref#refs/})"
done
[ "$n" -gt 0 ] || exit 0
if [ -z "$missing" ]; then
  echo "pre-push: the gate passed on the $n commit(s) being pushed; pushing" >&2
  exit 0
fi
echo "pre-push: the gate has not passed on:$missing. Nothing was sent." >&2
echo "pre-push: run make push (the gate, then the push; FORCE=1 for --force-with-lease), or make gate and push again." >&2
exit 1
