 internal/api/receipt.go      | 40 ++++++++++++++++++++++++++++++++++++
 internal/api/receipt_test.go | 34 ++++++++++++++++++++++++++++++
 3 files changed, 75 insertions(+)
 create mode 100644 internal/api/receipt.go
 create mode 100644 internal/api/receipt_test.go

diff --git a/cmd/api/main.go b/cmd/api/main.go
index 4374a97..bcfbadc 100644
--- a/cmd/api/main.go
+++ b/cmd/api/main.go
@@ -20,6 +20,7 @@ func main() {
 	mux.HandleFunc("GET /healthz", api.Healthz)
 	mux.HandleFunc("GET /v1/orders/{id}", api.GetOrder(s))
