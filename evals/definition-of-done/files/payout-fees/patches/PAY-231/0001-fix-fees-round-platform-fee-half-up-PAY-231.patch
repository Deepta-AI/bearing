From 88a0aed193578fd290142938ec45256a893c6430 Mon Sep 17 00:00:00 2001
From: Asha Rao <asha.rao@example.com>
Date: Sat, 26 Sep 2026 02:44:58 +0530
Subject: [PATCH 1/2] fix(fees): round platform fee half up [PAY-231]

Seller statements came out a paisa short because the fee truncated.
The fee now rounds half up as ADR 0003 says, and each payout carries
its line fees so the statement adds up to the payout.
---
 CHANGELOG.md              |  2 ++
 src/payouts/fees.py       |  8 +++++++-
 src/payouts/settlement.py | 30 +++++++++++++++++++++++++++---
 tests/test_fees.py        | 10 +++++++++-
 4 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index ca3ab8b..3b11207 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -4,6 +4,8 @@
 
 ## 1.4.0 (2026-08-28)
 
+- Platform fees round half up to the paisa, so seller statements match
+  their own sums (PAY-231).
 - Payouts to sellers with a paused account are held, not dropped (PAY-207).
 
 ## 1.3.2 (2026-08-11)
diff --git a/src/payouts/fees.py b/src/payouts/fees.py
index 76553db..8f0ed07 100644
--- a/src/payouts/fees.py
+++ b/src/payouts/fees.py
@@ -1,6 +1,11 @@
 """Platform fee on an order line (ADR 0003)."""
 
 
+def round_half_up(numerator: int, denominator: int) -> int:
+    """numerator / denominator rounded half up, in integers only."""
+    return (numerator + denominator // 2) // denominator
+
+
 def platform_fee(amount_paise: int, rate_bps: int) -> int:
     """The platform fee on one order line, in paise.
 
@@ -11,4 +16,5 @@ def platform_fee(amount_paise: int, rate_bps: int) -> int:
         raise ValueError("amount_paise must not be negative")
     if not 0 <= rate_bps <= 10000:
         raise ValueError("rate_bps must be between 0 and 10000")
-    return amount_paise * rate_bps // 10000
+    # Half up to the paisa (ADR 0003); integer arithmetic only.
+    return round_half_up(amount_paise * rate_bps, 10000)
diff --git a/src/payouts/settlement.py b/src/payouts/settlement.py
index 59b3291..feab3a4 100644
--- a/src/payouts/settlement.py
+++ b/src/payouts/settlement.py
@@ -1,6 +1,6 @@
 """Turn a batch of order lines into one payout per seller."""
 
-from dataclasses import dataclass
+from dataclasses import dataclass, field
 
 from payouts.fees import platform_fee
 
@@ -18,6 +18,8 @@ class Payout:
     seller_id: str
     gross_paise: int
     fee_paise: int
+    # (order_id, fee_paise) per line, for the seller's statement.
+    line_fees: tuple = field(default=())
 
     @property
     def net_paise(self) -> int:
@@ -29,10 +31,17 @@ def settle(lines, held_sellers=frozenset()):
 
     Sellers in held_sellers are left out (their lines stay unsettled and are
     picked up by the next run). The fee is the sum of the line fees
-    (ADR 0003), never a fee on the total.
+    (ADR 0003), never a fee on the total, and each payout carries its line
+    fees so the statement adds up to the payout (PAY-231).
+
+    Raises ValueError on a negative line amount (PAY-198), and
+    AssertionError when a statement would not add up to its payout, which
+    stops the whole run: a payout we cannot explain to the seller is worse
+    than a late one.
     """
     gross = {}
     fees = {}
+    statement = {}
     for line in lines:
         if line.amount_paise < 0:
             raise ValueError(f"negative amount on order {line.order_id}")
@@ -41,7 +50,22 @@ def settle(lines, held_sellers=frozenset()):
         gross[line.seller_id] = gross.get(line.seller_id, 0) + line.amount_paise
         fee = platform_fee(line.amount_paise, line.rate_bps)
         fees[line.seller_id] = fees.get(line.seller_id, 0) + fee
+        statement.setdefault(line.seller_id, []).append((line.order_id, fee))
     payouts = []
     for seller_id in sorted(gross):
-        payouts.append(Payout(seller_id, gross[seller_id], fees[seller_id]))
+        line_fees = tuple(statement[seller_id])
+        total = sum(f for _, f in line_fees)
+        if total != fees[seller_id]:
+            raise AssertionError(
+                f"statement for {seller_id} adds up to {total}, "
+                f"payout fee is {fees[seller_id]}"
+            )
+        payouts.append(
+            Payout(
+                seller_id=seller_id,
+                gross_paise=gross[seller_id],
+                fee_paise=fees[seller_id],
+                line_fees=line_fees,
+            )
+        )
     return payouts
diff --git a/tests/test_fees.py b/tests/test_fees.py
index 0652087..5f944a8 100644
--- a/tests/test_fees.py
+++ b/tests/test_fees.py
@@ -1,6 +1,6 @@
 import pytest
 
-from payouts.fees import platform_fee
+from payouts.fees import platform_fee, round_half_up
 
 
 def test_whole_paise_fee():
@@ -19,3 +19,11 @@ def test_negative_amount_rejected():
 def test_rate_above_100_percent_rejected():
     with pytest.raises(ValueError):
         platform_fee(100, 10001)
+
+
+def test_pay_231_fee_rounds_half_up():
+    # PAY-231: seller statements were a paisa short of their spreadsheets.
+    assert round_half_up(195, 10) == 20
+    assert round_half_up(194, 10) == 19
+    assert platform_fee(10000, 250) == 250
+    assert platform_fee(20000, 175) == 350
