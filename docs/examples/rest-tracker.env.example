# REST tracker keys for ~/.config/bearing/bearing.env (chmod 600; never
# inside a repository). The server must speak the protocol in
# docs/TRACKERS.md, "REST tracker protocol". Environment variables of the
# same name win over the file.
BEARING_TRACKER=rest
BEARING_TRACKER_URL=https://tracker.example.com
BEARING_TRACKER_PROJECT=PP
# Either a bearer token ...
BEARING_TRACKER_TOKEN=
# ... or a login: the client trades these for a token at /api/auth/login
# and caches it at ~/.config/bearing/rest.token (mode 600).
BEARING_TRACKER_EMAIL=you@example.com
BEARING_TRACKER_PASSWORD=change-me
BEARING_TRACKER_DONE_STATUS=Done
BEARING_TRACKER_MAX_PAGES=20
